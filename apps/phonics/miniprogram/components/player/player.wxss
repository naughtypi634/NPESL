.page {
  padding: 40rpx 44rpx 140rpx;
  color: #1d1d1f;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.lesson {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.phoneme {
  padding: 0 20rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 16rpx;
  background: #e8f2ff;
  color: #0071e3;
  font-size: 32rpx;
  font-weight: 600;
}

.patterns {
  margin-left: 20rpx;
  color: #6e6e73;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

.h1 {
  display: block;
  margin-top: 32rpx;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: -2rpx;
}

.title-zh {
  display: block;
  margin-top: 12rpx;
  color: #6e6e73;
  font-size: 36rpx;
  letter-spacing: 4rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 40rpx;
}

.seg {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #f5f5f7;
}

.seg-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  color: #6e6e73;
  font-size: 28rpx;
}

.seg-btn.is-on {
  background: #ffffff;
  color: #1d1d1f;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
}

.play-all {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 0;
  margin-left: 16rpx;
  padding: 0 44rpx;
  border-radius: 999rpx;
  background: #0071e3;
  color: #ffffff;
  font-size: 30rpx;
}

.play-all.is-on {
  background: #515154;
}

.rule {
  height: 1rpx;
  margin-top: 48rpx;
  background: #e5e5ea;
}

.passage {
  margin-top: 48rpx;
}

.sentence {
  display: flex;
  align-items: flex-start;
  margin-bottom: 48rpx;
}

.speaker {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  color: #515154;
}

.speaker.is-active {
  background: #e8f2ff;
  color: #0071e3;
}

.speaker-ico {
  font-size: 22rpx;
}

.rows {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.row {
  margin-bottom: 14rpx;
}

.chunk {
  font-size: 40rpx;
  line-height: 1.5;
}

.chunk.is-playing {
  color: #0071e3;
}

.sound {
  color: #0071e3;
  font-weight: 600;
}

.zh {
  display: block;
  margin-top: 2rpx;
  color: #6e6e73;
  font-size: 28rpx;
}

.status {
  display: block;
  margin-top: 40rpx;
  color: #6e6e73;
  font-size: 28rpx;
}
