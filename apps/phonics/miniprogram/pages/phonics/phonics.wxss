page {
  background: #ffffff;
  color: #1d1d1f;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 56rpx 44rpx 140rpx;
}

.h1 {
  display: block;
  font-size: 68rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.1;
}

.sub {
  display: block;
  margin-top: 16rpx;
  color: #6e6e73;
  font-size: 30rpx;
}

.section {
  display: block;
  margin: 64rpx 0 14rpx;
  color: #6e6e73;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.list {
  border-top: 1rpx solid #d2d2d7;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid #d2d2d7;
}

.row-hover {
  background: #f5f5f7;
}

.num {
  width: 52rpx;
  flex: none;
  color: #6e6e73;
  font-size: 26rpx;
}

.ipa {
  flex: none;
  min-width: 96rpx;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  background: #e8f2ff;
  color: #0071e3;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.meta {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.en {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
}

.zh {
  display: block;
  margin-top: 4rpx;
  color: #6e6e73;
  font-size: 26rpx;
}

.patterns {
  flex: none;
  max-width: 220rpx;
  margin-left: 16rpx;
  color: #6e6e73;
  font-size: 22rpx;
  text-align: right;
}
