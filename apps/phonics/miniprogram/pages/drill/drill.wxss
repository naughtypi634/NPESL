page {
  background: #ffffff;
  color: #1d1d1f;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 28rpx 32rpx 120rpx;
}

.cats {
  height: 88rpx;
  margin: 0 -32rpx;
  white-space: nowrap;
}

.cats-inner {
  display: inline-flex;
  padding: 0 32rpx;
}

.cat {
  flex: none;
  margin-right: 14rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #f5f5f7;
  color: #6e6e73;
  font-size: 26rpx;
  line-height: 1.3;
}

.cat.on {
  background: #0071e3;
  color: #ffffff;
}

.card {
  min-height: 1500rpx;
  margin-top: 20rpx;
  padding: 32rpx;
  border: 1rpx solid #e5e5ea;
  border-radius: 28rpx;
}

.meta {
  display: flex;
  align-items: center;
}

.chip {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #e8f2ff;
  color: #0071e3;
  font-size: 22rpx;
  font-weight: 600;
}

.scene {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  color: #6e6e73;
  font-size: 24rpx;
}

.zh {
  display: block;
  margin-top: 28rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: -1rpx;
}

.answers {
  margin-top: 4rpx;
}

.answer {
  display: flex;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #ececf0;
}

.answer:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.num {
  flex: none;
  width: 44rpx;
  padding-top: 4rpx;
  color: #0071e3;
  font-size: 24rpx;
  font-weight: 600;
}

.answer-body {
  flex: 1;
  min-width: 0;
}

.en {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.45;
  letter-spacing: -0.5rpx;
}

.play {
  display: flex;
  margin-top: 14rpx;
}

.play-btn {
  display: flex;
  align-items: center;
  margin-right: 12rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #f5f5f7;
  color: #1d1d1f;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

.play-ico {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

.play-ico::before {
  content: "";
  position: absolute;
  left: 0;
  top: 7rpx;
  width: 9rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.play-ico::after {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 2rpx;
  border-left: 13rpx solid currentColor;
  border-top: 11rpx solid transparent;
  border-bottom: 11rpx solid transparent;
}

.play-btn.is-playing {
  background: #0071e3;
  color: #ffffff;
}

.note {
  display: block;
  margin-top: 12rpx;
  color: #6e6e73;
  font-size: 25rpx;
  line-height: 1.55;
}

.actions {
  display: flex;
  margin-top: 36rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 38rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn.primary {
  background: #0071e3;
  color: #ffffff;
}

.btn.ghost {
  margin-left: 16rpx;
  background: #f5f5f7;
  color: #1d1d1f;
}

.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 1500rpx;
  margin-top: 20rpx;
}
