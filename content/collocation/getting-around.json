      "base": "come",
      "particle": "back",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈkʌm bæk",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "回到原来的地方；想起来",
      "senses": [
        {
          "zh": "回到原来的地方",
          "en": "to return to a place",
          "example": {
            "en": "What time are you coming back tonight?",
            "zh": "你今晚几点回来？"
          }
        },
        {
          "zh": "想起来",
          "en": "to be remembered suddenly",
