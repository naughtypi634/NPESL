      ],
      "collocations": [
        "come back home",
        "come back soon"
      ],
      "collocations_zh": [
        "回家",
        "早点回来"
      ]
    },
    {
      "id": "go-back",
      "head": "go back",
      "base": "go",
      "particle": "back",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈɡoʊ bæk",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "返回原处；追溯到；回想",
      "senses": [
        {
          "zh": "返回原处",
          "en": "to return to a place you left",
          "example": {
            "en": "I left my charger at the hotel — I have to go back.",
            "zh": "充电器落酒店了，我得回去一趟。"
          }
        },
        {
          "zh": "追溯到",
          "en": "to have existed since a time in the past",
          "example": {
            "en": "Their friendship goes back to elementary school.",
            "zh": "他们的交情从小学就开始了。"
          }
        },
        {
          "zh": "回想",
          "en": "to think about something in the past",
          "example": {
            "en": "Let's go back to what you said about the budget.",
            "zh": "我们回到你说的预算问题。"
          }
        }
      ],
      "l1_note": "回去是 go back（离开说话人所在地）；回来是 come back。",
      "confusables": [
        "come back",
        "get back"
      ],
      "collocations": [
        "go back to the hotel",
        "go back for something"
      ],
      "collocations_zh": [
        "回酒店",
        "回去取东西"
      ]
    },
