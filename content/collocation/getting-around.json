      "freq": 3,
      "ipa": "ˈweɪt əˈraʊnd",
      "tier": 3,
      "level": "B1",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "干等、白等",
      "senses": [
        {
          "zh": "无所事事地等",
          "en": "to wait without doing anything useful",
          "example": {
            "en": "We waited around for an hour before the bus finally came.",
            "zh": "我们干等了一个小时，公交才来。"
          }
        }
      ],
      "confusables": [
        "wait for",
        "hang around"
      ],
      "collocations": [
        "wait around for hours",
        "keep someone waiting"
      ],
      "l1_note": "无所事事地等；wait for 是等具体的人或物。",
      "collocations_zh": [
        "干等几小时",
        "让人等"
      ]
    },
