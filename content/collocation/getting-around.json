      "tier": 2,
      "level": "B1",
      "chip": "sights",
      "register": "spoken",
      "separable": false,
      "zh": "留意、盯着找",
      "senses": [
        {
          "zh": "留意某个标志或人",
          "en": "to keep watching for something so you do not miss it",
          "example": {
            "en": "Look out for the green sign that says Arrivals.",
            "zh": "留意写着“到达”的绿色牌子。"
          }
        }
      ],
      "confusables": [
        "watch out",
        "look for"
      ],
      "collocations": [
        "look out for the exit",
        "look out for each other"
      ],
