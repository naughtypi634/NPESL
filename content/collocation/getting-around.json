      "tier": 1,
      "level": "A2",
      "chip": "airport",
      "register": "neutral",
      "separable": false,
      "zh": "起飞；脱掉；突然走红",
      "senses": [
        {
          "zh": "飞机起飞",
          "en": "when a plane leaves the ground",
          "example": {
            "en": "The plane took off two hours late because of the storm.",
            "zh": "因为暴雨，飞机晚了两小时才起飞。"
          }
        },
        {
          "zh": "脱掉（衣物）",
          "en": "to remove a piece of clothing",
          "example": {
            "en": "Take off your jacket — it's warm in here.",
            "zh": "把外套脱了吧，里面挺暖和的。"
          }
        }
      ],
      "l1_note": "脱衣服是 take off，不是 put off；put off 是推迟。",
      "confusables": [
        "put off",
        "take out"
      ],
      "collocations": [
        "take off your shoes",
        "the plane takes off",
        "takeoff time"
      ],
      "collocations_zh": [
        "脱鞋",
        "飞机起飞",
        "起飞时间"
      ]
    },
