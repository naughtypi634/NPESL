{
  "theme": "getting-around",
  "entries": [
    {
      "id": "pick-up",
      "head": "pick up",
      "base": "pick",
      "particle": "up",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈpɪk ʌp",
      "tier": 1,
      "level": "A2",
      "chip": "transit",
      "register": "spoken",
      "separable": true,
      "zh": "开车接（人）；顺路取（东西）",
      "senses": [
        {
          "zh": "开车接人",
          "en": "to collect someone in a car",
          "example": {
            "en": "Can you pick me up at Exit C? The taxi line is insane.",
            "zh": "你能在 C 口接我吗？打车的队排得离谱。"
          }
        },
        {
          "zh": "顺路取东西",
          "en": "to collect something you ordered or left somewhere",
          "example": {
            "en": "I'll pick up the package at the front desk after work.",
            "zh": "我下班后去前台取快递。"
          }
        }
      ],
      "l1_note": "代词必须夹在中间：pick me up。说 pick up me 是中文语序硬套。",
      "confusables": [
        "drop off",
        "take up"
      ],
      "collocations": [
        "pick up the phone",
        "pick up a package",
        "pick up the tab"
      ],
      "collocations_zh": [
        "接电话",
        "取快递",
        "买单"
      ]
    },
    {
      "id": "drop-off",
      "head": "drop off",
      "base": "drop",
      "particle": "off",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈdrɑp ɔf",
      "tier": 1,
      "level": "A2",
      "chip": "transit",
      "register": "spoken",
      "separable": true,
      "zh": "送到某处放下；捎一段",
      "senses": [
        {
          "zh": "开车送到某处",
          "en": "to take someone or something to a place and leave them there",
          "example": {
            "en": "Just drop me off at the corner — I'll walk the rest.",
            "zh": "在路口把我放下就行，剩下的路我走过去。"
          }
        }
      ],
      "l1_note": "和 pick up 是一对：pick up 是接，drop off 是送。别都翻成“拿”。",
      "confusables": [
        "pick up"
      ],
      "collocations": [
        "drop off a package",
        "drop off the kids",
        "drop-off point"
      ],
      "collocations_zh": [
        "捎个包裹",
        "送孩子",
        "下车点"
      ]
    },
    {
      "id": "check-in",
      "head": "check in",
      "base": "check",
      "particle": "in",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈtʃɛk ɪn",
      "tier": 1,
      "level": "A2",
      "chip": "airport",
      "register": "neutral",
      "separable": false,
      "zh": "值机；办入住；打卡报到",
      "senses": [
        {
          "zh": "机场值机",
          "en": "to register for a flight and hand over your bags",
          "example": {
            "en": "You can check in online 24 hours before the flight.",
            "zh": "起飞前 24 小时可以在线值机。"
          }
        },
        {
          "zh": "酒店办入住",
          "en": "to register at a hotel when you arrive",
          "example": {
            "en": "We checked in around ten and went straight to bed.",
            "zh": "我们十点左右办了入住，直接睡了。"
          }
        }
      ],
      "l1_note": "check in 不带宾语；带酒店名要说 check into the hotel。",
      "confusables": [
        "check into",
        "check out"
      ],
      "collocations": [
        "check in online",
        "check-in counter",
        "check in at the front desk"
      ],
      "collocations_zh": [
        "在线值机",
        "值机柜台",
        "在前台办入住"
      ]
    },
    {
      "id": "check-out",
      "head": "check out",
      "base": "check",
      "particle": "out",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈtʃɛk aʊt",
      "tier": 1,
      "level": "A2",
      "chip": "hotel",
      "register": "neutral",
      "separable": false,
      "zh": "退房；看一眼",
      "senses": [
        {
          "zh": "酒店退房",
          "en": "to pay and leave a hotel",
          "example": {
            "en": "We have to check out by noon, so let's eat breakfast early.",
            "zh": "中午前要退房，我们早点吃早饭吧。"
          }
        },
        {
          "zh": "去看看、试一下",
          "en": "to look at something because it might interest you",
          "example": {
            "en": "That new noodle place looks good — let's check it out.",
            "zh": "那家新开的面馆看着不错，去试试。"
          }
        }
      ],
      "l1_note": "“退房”不是 leave the room。前台只会问 What time are you checking out?",
      "confusables": [
        "check in",
        "check out of"
      ],
      "collocations": [
        "check out of the hotel",
        "checkout time"
      ],
      "collocations_zh": [
        "从酒店退房",
        "退房时间"
      ]
    },
    {
      "id": "check-into",
      "head": "check into",
      "base": "check",
      "particle": "into",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈtʃɛk ˈɪntu",
      "tier": 2,
      "level": "B1",
      "chip": "hotel",
      "register": "neutral",
      "separable": false,
      "zh": "入住（某家酒店）",
      "senses": [
        {
          "zh": "办入住并住进去",
          "en": "to register and stay at a hotel",
          "example": {
            "en": "We checked into the hotel and crashed immediately.",
            "zh": "我们办了入住，然后倒头就睡。"
          }
        }
      ],
      "confusables": [
        "check in",
        "check out of"
      ],
      "collocations": [
        "check into a hotel",
        "check into the hospital"
      ],
      "l1_note": "入住某家酒店用 check into；check in 不带宾语。",
      "collocations_zh": [
        "入住酒店",
        "住院"
      ]
    },
    {
      "id": "put-up",
      "head": "put up",
      "base": "put",
      "particle": "up",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈpʊt ʌp",
      "tier": 2,
      "level": "B1",
      "chip": "hotel",
      "register": "spoken",
      "separable": true,
      "zh": "留宿；张贴；搭建",
      "senses": [
        {
          "zh": "让某人住一晚",
          "en": "to let someone stay in your home for a while",
          "example": {
            "en": "My cousin put us up for two nights when we missed the last train.",
            "zh": "我们错过末班车，表姐让我们在她家住了两晚。"
          }
        }
      ],
      "l1_note": "“住朋友家”不是 live in my friend's home，短期借住是 put someone up。",
      "confusables": [
        "put on",
        "put away"
      ],
      "collocations": [
        "put someone up for the night",
        "put up a poster"
      ],
      "collocations_zh": [
        "留人住一晚",
        "贴海报"
      ]
    },
    {
      "id": "drop-by",
      "head": "drop by",
      "base": "drop",
      "particle": "by",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈdrɑp baɪ",
      "tier": 2,
      "level": "B1",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "顺路来一下",
      "senses": [
        {
          "zh": "短时间拜访",
          "en": "to visit someone briefly, often without planning",
          "example": {
            "en": "I'll drop by your hotel around seven.",
            "zh": "我七点左右顺路去你酒店一趟。"
          }
        }
      ],
      "confusables": [
        "drop in",
        "drop off"
      ],
      "collocations": [
        "drop by the office",
        "drop by for a coffee"
      ],
      "l1_note": "顺路来一下；drop off 是放下人或物。",
      "collocations_zh": [
        "顺路去办公室",
        "顺路喝杯咖啡"
      ]
    },
    {
      "id": "get-away",
      "head": "get away",
      "base": "get",
      "particle": "away",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈɡɛt əˈweɪ",
      "tier": 2,
      "level": "B1",
      "chip": "sights",
      "register": "spoken",
      "separable": false,
      "zh": "离开、抽身；逃跑；去度假",
      "senses": [
        {
          "zh": "离开、抽身",
          "en": "to leave a place, especially when it is hard",
          "example": {
            "en": "I need to get away for a weekend — work is driving me crazy.",
            "zh": "我得出去过个周末，工作快把我逼疯了。"
          }
        },
        {
          "zh": "逃跑",
          "en": "to escape",
          "example": {
            "en": "The thief got away before the police arrived.",
            "zh": "警察到之前小偷跑了。"
          }
        },
        {
          "zh": "去度假",
          "en": "to go somewhere for a vacation",
          "example": {
            "en": "We're getting away for a few days next month.",
            "zh": "下个月我们出去度假几天。"
          }
        }
      ],
      "confusables": [
        "get out",
        "take off"
      ],
      "collocations": [
        "get away for the weekend",
        "get away from it all"
      ],
      "l1_note": "抽身或短途出游；get away from 是逃离。",
      "collocations_zh": [
        "出去过个周末",
        "彻底逃离"
      ]
    },
    {
      "id": "get-back",
      "head": "get back",
      "base": "get",
      "particle": "back",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈɡɛt bæk",
      "tier": 1,
      "level": "A2",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "回来；取回；回复",
      "senses": [
        {
          "zh": "回到某处",
          "en": "to return to a place",
          "example": {
            "en": "What time do you think we'll get back tonight?",
            "zh": "你觉得我们今晚几点能回来？"
          }
        },
        {
          "zh": "回复某人",
          "en": "to reply to someone later",
          "example": {
            "en": "I'll get back to you by Friday.",
            "zh": "我周五前回复你。"
          }
        }
      ],
      "l1_note": "“回复你”不是 reply you（错），是 get back to you 或 reply to you。",
      "confusables": [
        "go back",
        "come back"
      ],
      "collocations": [
        "get back home",
        "get back to me",
        "get back on track"
      ],
      "collocations_zh": [
        "回到家",
        "回复我",
        "回到正轨"
      ]
    },
    {
