            "en": "He's been hunting for a job since March.",
            "zh": "他从三月开始找工作。"
          }
        }
      ],
      "l1_note": "找工作用 hunt for / look for；find 是找到。",
      "confusables": [
        "look for",
        "search for"
      ],
      "collocations": [
        "hunt for a job",
        "hunt for talent"
      ],
      "collocations_zh": [
        "找工作",
        "找人才"
      ]
    },
    {
