      "head": "hunt for",
      "base": "hunt",
      "particle": "for",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈhʌnt fɔr",
      "chip": "interview",
      "register": "neutral",
      "separable": false,
      "zh": "找工作",
