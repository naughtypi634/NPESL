{
  "theme": "frustrations",
  "entries": [
    {
      "id": "drag-on",
      "head": "drag on",
      "base": "drag",
      "particle": "on",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈdræɡ ɑn",
      "tier": 2,
      "level": "B1",
      "chip": "meetings",
      "register": "spoken",
      "separable": false,
      "zh": "拖得太久",
      "senses": [
        {
          "zh": "事情漫长得让人烦",
          "en": "to continue for too long",
          "example": {
            "en": "The meeting dragged on for two hours with no decision.",
            "zh": "会开了两个小时还没结论。"
          }
        }
      ],
      "confusables": [
        "drag out",
        "draw out"
      ],
      "collocations": [
        "the meeting dragged on",
        "drag on for months"
      ],
      "l1_note": "事情自己拖长；drag out 是人故意拖。",
      "collocations_zh": [
        "会拖太久",
        "拖几个月"
      ]
    },
    {
      "id": "drag-out",
      "head": "drag out",
      "base": "drag",
      "particle": "out",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈdræɡ aʊt",
      "tier": 3,
      "level": "B1",
      "chip": "meetings",
      "register": "spoken",
      "separable": true,
      "zh": "故意拖长",
      "senses": [
        {
          "zh": "人为把过程拉长",
          "en": "to make something last longer than necessary",
          "example": {
            "en": "Don't drag out the discussion — we need a decision today.",
            "zh": "别拖了，今天必须定下来。"
          }
        }
      ],
      "l1_note": "drag on 是自己拖（无人为），drag out 是有人故意拖长。",
      "confusables": [
        "drag on",
        "stretch out"
      ],
      "collocations": [
        "drag out a negotiation",
        "drag the process out"
      ],
      "collocations_zh": [
        "拖长谈判",
        "拖长过程"
      ]
    },
    {
      "id": "slip-up",
      "head": "slip up",
      "base": "slip",
      "particle": "up",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈslɪp ʌp",
      "tier": 3,
      "level": "B1",
      "chip": "office",
      "register": "spoken",
      "separable": false,
      "zh": "出个小差错",
      "senses": [
        {
          "zh": "不小心犯小错",
          "en": "to make a small mistake",
          "example": {
            "en": "I slipped up and sent the draft to the client.",
            "zh": "我不小心把草稿发给客户了。"
          }
        }
      ],
      "confusables": [
        "mess up",
        "fall behind"
      ],
      "collocations": [
        "slip up on a detail",
        "a slip-up"
      ],
      "l1_note": "小失误；mess up 是搞砸，程度更重。",
      "collocations_zh": [
        "细节出错",
        "小失误"
      ]
    },
    {
      "id": "lay-off",
      "head": "lay off",
      "base": "lay",
      "particle": "off",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈleɪ ɔf",
      "tier": 1,
      "level": "B1",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "裁员",
      "senses": [
        {
          "zh": "公司因经营原因裁人",
          "en": "when a company stops employing people because of costs",
          "example": {
            "en": "The company laid off forty people in the second round.",
            "zh": "公司在第二轮裁了四十人。"
          }
        }
      ],
      "l1_note": "裁员是 lay off；被裁是 get laid off。fire 是开除（本人过错），不能混。",
      "confusables": [
        "fire",
        "let go"
      ],
      "collocations": [
        "lay off staff",
        "get laid off"
      ],
      "collocations_zh": [
        "裁员",
        "被裁"
      ]
    },
    {
      "id": "pay-off",
      "head": "pay off",
      "base": "pay",
      "particle": "off",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈpeɪ ɔf",
      "tier": 1,
      "level": "B1",
      "chip": "errands",
      "register": "neutral",
      "separable": true,
      "zh": "还清；奏效",
      "senses": [
        {
          "zh": "把欠的钱还清",
          "en": "to finish paying all the money you owe",
          "example": {
            "en": "I paid off my student loan two years early.",
            "zh": "我提前两年还清了助学贷款。"
          }
        },
        {
          "zh": "努力终于有回报",
          "en": "when effort produces a good result",
          "example": {
            "en": "All those late nights finally paid off.",
            "zh": "那些熬夜总算没白费。"
          }
        }
      ],
      "l1_note": "“还清”不是 pay all；pay off 才是把债务结清。注意 pay off 和 payoff（回报）名词区别。",
      "confusables": [
        "pay back",
        "pay up"
      ],
      "collocations": [
        "pay off a loan",
        "hard work pays off"
      ],
      "collocations_zh": [
        "还清贷款",
        "努力有回报"
      ]
    },
    {
      "id": "pile-up",
      "head": "pile up",
      "base": "pile",
      "particle": "up",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈpaɪl ʌp",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "堆积起来",
      "senses": [
        {
          "zh": "事情或东西越积越多",
          "en": "when things accumulate faster than you deal with them",
          "example": {
            "en": "The emails piled up while I was on leave.",
            "zh": "我休假期间邮件堆了一大堆。"
          }
        }
      ],
      "l1_note": "堆积是 pile up；中文“堆成山”直译 the things are like a mountain 不行。",
      "confusables": [
        "stack up",
        "build up"
      ],
      "collocations": [
        "work piles up",
        "bills pile up"
      ],
      "collocations_zh": [
        "工作堆积",
        "账单堆积"
      ]
    },
    {
      "id": "stack-up",
      "head": "stack up",
      "base": "stack",
      "particle": "up",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈstæk ʌp",
      "chip": "home",
      "register": "neutral",
      "separable": false,
      "zh": "叠起来、累积",
      "senses": [
        {
          "zh": "一件件累加",
          "en": "to form a pile or add up over time",
          "example": {
            "en": "Dishes stack up fast when nobody cleans.",
            "zh": "没人洗的话，碗很快就堆起来。"
          }
        }
      ],
      "l1_note": "stack up 也有“比得上”的意思，看上下文。",
      "confusables": [
        "pile up",
        "add up"
      ],
      "collocations": [
        "dishes stack up",
        "costs stack up"
      ],
      "collocations_zh": [
        "碗堆起来",
        "费用累积"
      ]
    },
    {
      "id": "mess-up",
      "head": "mess up",
      "base": "mess",
      "particle": "up",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈmɛs ʌp",
      "chip": "office",
      "register": "spoken",
      "separable": true,
      "zh": "搞砸",
      "senses": [
        {
          "zh": "把事情做坏",
          "en": "to do something badly or spoil it",
          "example": {
            "en": "I messed up the booking and we lost the table.",
            "zh": "我把预订搞砸了，位置没了。"
          }
        }
      ],
      "l1_note": "搞砸是 mess up；mess around 是瞎搞、乱来。",
      "confusables": [
        "screw up",
        "foul up"
      ],
      "collocations": [
        "mess up an order",
        "mess it up"
      ],
      "collocations_zh": [
        "搞砸订单",
        "搞砸"
      ]
    },
    {
      "id": "screw-up",
      "head": "screw up",
      "base": "screw",
      "particle": "up",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈskru ʌp",
      "chip": "office",
      "register": "spoken",
      "separable": true,
      "zh": "弄糟（更重的搞砸）",
      "senses": [
        {
          "zh": "犯下明显的错误",
          "en": "to make a serious mistake",
          "example": {
            "en": "Someone screwed up the schedule and three meetings overlap.",
            "zh": "有人把日程弄乱了，三个会撞在一起。"
          }
        }
      ],
      "l1_note": "screw up 比 mess up 语气重，略粗。",
      "confusables": [
        "mess up",
        "foul up"
      ],
      "collocations": [
        "screw up a project",
        "screw it up"
      ],
      "collocations_zh": [
        "弄糟项目",
        "弄糟"
      ]
    },
    {
      "id": "foul-up",
      "head": "foul up",
      "base": "foul",
      "particle": "up",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈfaʊl ʌp",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "弄乱、搞出岔子",
      "senses": [
        {
          "zh": "流程被弄坏",
          "en": "to spoil or confuse something",
          "example": {
            "en": "The new system fouled up the whole approval process.",
            "zh": "新系统把整个审批流程搅乱了。"
          }
        }
      ],
      "l1_note": "foul up 偏书面/新闻，口语更常说 mess up。",
      "confusables": [
        "mess up",
        "screw up"
      ],
      "collocations": [
        "foul up the plan",
        "foul up the process"
      ],
      "collocations_zh": [
        "弄乱计划",
        "搅乱流程"
      ]
    },
    {
      "id": "fall-through",
      "head": "fall through",
      "base": "fall",
      "particle": "through",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈfɔl θru",
      "chip": "errands",
      "register": "neutral",
      "separable": false,
      "zh": "（计划）告吹",
      "senses": [
        {
          "zh": "商量好的事没成",
          "en": "when a plan or deal fails to happen",
          "example": {
            "en": "The apartment fell through the day before we were going to sign.",
            "zh": "签约前一天房子的事黄了。"
          }
        }
      ],
      "l1_note": "告吹是 fall through，不是 fall down（那是倒塌）。",
      "confusables": [
        "fall apart",
        "back out"
      ],
      "collocations": [
        "the deal fell through",
        "the plan fell through"
      ],
      "collocations_zh": [
        "交易黄了",
        "计划黄了"
      ]
    },
    {
      "id": "come-apart",
      "head": "come apart",
      "base": "come",
      "particle": "apart",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈkʌm əˈpɑrt",
      "chip": "home",
      "register": "neutral",
      "separable": false,
      "zh": "散架、解体",
      "senses": [
        {
          "zh": "东西裂开散掉",
          "en": "to break into pieces",
          "example": {
            "en": "The cheap umbrella came apart in the wind.",
            "zh": "便宜伞被风一吹就散架了。"
          }
        }
      ],
      "l1_note": "散架是 come apart；fall apart 更多指人崩溃或计划垮掉。",
      "confusables": [
        "fall apart",
        "break down"
      ],
      "collocations": [
        "the chair came apart",
        "it came apart in my hands"
      ],
      "collocations_zh": [
        "椅子散架",
        "手里散架"
      ]
    },
    {
      "id": "fall-behind",
      "head": "fall behind",
      "base": "fall",
      "particle": "behind",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈfɔl bɪˈhaɪnd",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "进度落下来；走路掉队",
      "senses": [
        {
          "zh": "进度落下来",
          "en": "to make less progress than planned",
          "example": {
            "en": "I fell behind on rent after the layoff.",
            "zh": "被裁之后我房租开始拖欠。"
          }
        },
        {
          "zh": "走路掉队",
          "en": "to move more slowly than the group",
          "example": {
            "en": "My knee hurt, so I fell behind on the hike.",
            "zh": "我膝盖疼，徒步时掉队了。"
          }
        }
      ],
      "l1_note": "落后是 fall behind (on)；不是 fall back（那是后退）。",
      "confusables": [
        "fall back",
        "catch up on"
      ],
      "collocations": [
        "fall behind on payments",
        "fall behind schedule"
      ],
      "collocations_zh": [
        "拖欠还款",
        "落后进度"
      ]
    },
    {
      "id": "catch-up-on",
      "head": "catch up on",
      "base": "catch",
      "particle": "up",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈkætʃ ʌp ɑn",
      "chip": "office",
      "register": "spoken",
      "separable": false,
      "zh": "补上（欠下的）",
      "senses": [
        {
          "zh": "把落下的补回来",
          "en": "to do something you did not have time for",
          "example": {
            "en": "I need Sunday to catch up on sleep and laundry.",
            "zh": "我需要周日补觉和洗衣服。"
          }
        }
      ],
      "l1_note": "补上是 catch up on；catch up 是追上进度。",
      "confusables": [
        "catch up",
        "keep up with"
      ],
      "collocations": [
        "catch up on work",
        "catch up on sleep"
      ],
      "collocations_zh": [
        "补工作",
        "补觉"
      ]
    },
    {
      "id": "lock-out",
      "head": "lock out",
      "base": "lock",
      "particle": "out",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈlɑk aʊt",
      "chip": "home",
      "register": "neutral",
      "separable": true,
      "zh": "锁在外面",
      "senses": [
        {
          "zh": "门锁了进不去",
          "en": "to be unable to get in because the door is locked",
          "example": {
            "en": "I got locked out with no phone and waited an hour.",
            "zh": "我没带手机被锁在外面，等了一小时。"
          }
        }
      ],
      "l1_note": "被锁外面是 get locked out，不是 lock outside。",
      "confusables": [
        "lock up",
        "shut out"
      ],
      "collocations": [
        "get locked out",
        "lock yourself out"
      ],
      "collocations_zh": [
        "被锁外面",
        "把自己锁外面"
      ]
    },
    {
      "id": "burn-out",
      "head": "burn out",
      "base": "burn",
      "particle": "out",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈbɝn aʊt",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "累垮、透支",
      "senses": [
        {
          "zh": "长期高压后崩掉",
          "en": "to become exhausted from too much work",
          "example": {
            "en": "If you keep working weekends, you'll burn out by spring.",
            "zh": "周末一直加班，春天前你就得垮。"
          }
        }
      ],
      "l1_note": "burn out 是长期透支；累一天是 worn out。",
      "confusables": [
        "wear out",
        "run down"
      ],
      "collocations": [
        "burn out at work",
        "burn yourself out"
      ],
      "collocations_zh": [
        "工作累垮",
        "把自己熬垮"
      ]
    },
    {
      "id": "stretch-out",
      "head": "stretch out",
      "base": "stretch",
      "particle": "out",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈstrɛtʃ aʊt",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "拖长",
      "senses": [
        {
          "zh": "把时间或过程拉长",
          "en": "to make something last longer than planned",
          "example": {
            "en": "The project stretched out for another three months.",
            "zh": "项目又拖了三个月。"
          }
        }
      ],
      "l1_note": "拖长是 stretch out；伸懒腰也是 stretch。",
      "confusables": [
        "drag out",
        "draw out"
      ],
      "collocations": [
        "stretch out the timeline",
        "stretch it out"
      ],
      "collocations_zh": [
        "拖长时间线",
        "拖长"
      ]
    },
    {
      "id": "draw-out",
      "head": "draw out",
      "base": "draw",
      "particle": "out",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈdrɔ aʊt",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "拖长（讨论、过程）",
      "senses": [
        {
          "zh": "让人或事拖得更久",
          "en": "to make something take longer",
          "example": {
            "en": "Don't let him draw out the meeting with questions.",
            "zh": "别让他用提问把会拖长。"
          }
        }
      ],
      "l1_note": "draw out 也指“引出（话）”，看宾语。",
      "confusables": [
        "drag out",
        "stretch out"
      ],
      "collocations": [
        "draw out a discussion",
        "draw it out"
      ],
      "collocations_zh": [
        "拖长讨论",
        "拖长"
      ]
    },
    {
      "id": "come-up-against",
      "head": "come up against",
      "base": "come",
      "particle": "up",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈkʌm ʌp əˈɡɛnst",
      "chip": "errands",
      "register": "neutral",
      "separable": false,
      "zh": "遇到（障碍）",
      "senses": [
