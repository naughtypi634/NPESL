      ]
    },
    {
      "id": "snow-under",
      "head": "snow under",
      "base": "snow",
      "particle": "under",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈsnoʊ ˈʌndər",
      "chip": "office",
