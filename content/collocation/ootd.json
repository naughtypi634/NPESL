{
  "theme": "ootd",
  "entries": [
    {
      "id": "put-on",
      "head": "put on",
      "base": "put",
      "particle": "on",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈpʊt ɑn",
      "chip": "shopping",
      "register": "neutral",
      "separable": true,
      "zh": "穿上、戴上",
      "senses": [
        {
          "zh": "把衣服穿到身上（动作）",
          "en": "to dress yourself in something",
          "example": {
            "en": "Put on a jacket — the office AC is freezing.",
            "zh": "穿件外套，办公室空调太冷了。"
          }
        }
      ],
      "l1_note": "“穿”有两个词：put on 是穿上的动作，wear 是穿着的状态。中文一个“穿”。",
      "confusables": [
        "wear",
        "take off"
      ],
      "collocations": [
        "put on a coat",
        "put on your shoes"
      ],
      "collocations_zh": [
        "穿外套",
        "穿鞋"
      ]
    },
    {
      "id": "try-on",
      "head": "try on",
      "base": "try",
      "particle": "on",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈtraɪ ɑn",
      "chip": "shopping",
      "register": "neutral",
      "separable": true,
      "zh": "试穿",
      "senses": [
        {
          "zh": "在店里或家里试",
          "en": "to put clothes on to see if they fit",
          "example": {
            "en": "Can I try this on? The fitting room is over there, right?",
            "zh": "这件我可以试一下吗？试衣间在那边对吧？"
          }
        }
      ],
      "l1_note": "试穿是 try on，不是 try it（少了 on）；代词夹中间：try it on。",
      "confusables": [
        "put on",
        "pick out"
      ],
      "collocations": [
        "try on a dress",
        "try it on"
      ],
      "collocations_zh": [
        "试裙子",
        "试一下"
      ]
    },
    {
      "id": "dress-up",
      "head": "dress up",
      "base": "dress",
      "particle": "up",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈdrɛs ʌp",
      "chip": "social",
      "register": "neutral",
      "separable": false,
      "zh": "打扮、穿正式",
      "senses": [
        {
          "zh": "为场合郑重打扮",
          "en": "to wear formal or nicer clothes than usual",
          "example": {
            "en": "Do we need to dress up for the dinner, or is jeans fine?",
            "zh": "晚饭要穿正式点吗，还是牛仔裤就行？"
          }
        }
      ],
      "l1_note": "“打扮”不是 make up（那是化妆）；穿得好是 dress up。",
      "confusables": [
        "dress down",
        "put on"
      ],
      "collocations": [
        "dress up for a date",
        "dress up for work"
      ],
      "collocations_zh": [
        "约会打扮",
        "上班穿正式"
      ]
    },
    {
      "id": "dress-down",
      "head": "dress down",
      "base": "dress",
      "particle": "down",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈdrɛs daʊn",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "穿得随意",
      "senses": [
        {
          "zh": "比平时穿得休闲",
          "en": "to wear more casual clothes than usual",
          "example": {
            "en": "The company lets us dress down on Fridays.",
            "zh": "公司周五允许穿便装。"
          }
        }
      ],
      "l1_note": "dress down 还有“责备”的意思，看上下文。",
      "confusables": [
        "dress up",
        "throw on"
      ],
      "collocations": [
        "dress down for work",
        "dress-down Friday"
      ],
      "collocations_zh": [
        "上班穿随意",
        "便装周五"
      ]
    },
    {
      "id": "throw-on",
      "head": "throw on",
      "base": "throw",
      "particle": "on",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈθroʊ ɑn",
      "chip": "home",
      "register": "spoken",
      "separable": true,
      "zh": "随手套上",
      "senses": [
        {
          "zh": "不挑不搭，随便穿上",
          "en": "to put clothes on quickly without much thought",
          "example": {
            "en": "I threw on a hoodie and ran downstairs for the delivery.",
            "zh": "我随手套了件卫衣就下楼拿外卖。"
          }
        }
      ],
      "l1_note": "“随手穿”不是 wear casually 才自然；throw on 有“随便一抓”的画面。",
      "confusables": [
        "slip on",
        "put on"
      ],
      "collocations": [
        "throw on a jacket",
        "throw something on"
      ],
      "collocations_zh": [
        "随手套外套",
        "随便套上"
      ]
    },
    {
      "id": "slip-on",
      "head": "slip on",
      "base": "slip",
      "particle": "on",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈslɪp ɑn",
      "chip": "home",
      "register": "spoken",
      "separable": true,
      "zh": "蹬上、套上（不系带的）",
      "senses": [
        {
          "zh": "快速穿进鞋或衣服",
          "en": "to put on shoes or clothes quickly and easily",
          "example": {
            "en": "Slip on your sneakers — we're leaving in two minutes.",
            "zh": "把运动鞋蹬上，两分钟后走。"
          }
        }
      ],
      "l1_note": "slip on 暗示不用系带、一蹬就进；系带的鞋用 put on。",
      "confusables": [
        "throw on",
        "lace up"
      ],
      "collocations": [
        "slip on shoes",
        "slip on a hoodie"
      ],
      "collocations_zh": [
        "蹬上鞋",
        "套上卫衣"
      ]
    },
    {
      "id": "zip-up",
      "head": "zip up",
      "base": "zip",
      "particle": "up",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈzɪp ʌp",
      "chip": "home",
      "register": "spoken",
      "separable": true,
      "zh": "拉上拉链",
      "senses": [
        {
          "zh": "把外套拉链拉好",
          "en": "to close a piece of clothing with a zipper",
          "example": {
            "en": "Zip up — it's freezing outside and you're wearing it open.",
            "zh": "拉上拉链，外面冻死了，你还敞着穿。"
          }
        }
      ],
      "l1_note": "“闭嘴”是 zip it，不是 zip up；zip up 只指拉链。",
      "confusables": [
        "button up",
        "unzip"
      ],
      "collocations": [
        "zip up your jacket",
        "zip it up"
      ],
      "collocations_zh": [
        "拉上外套",
        "拉上"
      ]
    },
    {
      "id": "button-up",
      "head": "button up",
      "base": "button",
      "particle": "up",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈbʌtən ʌp",
      "chip": "home",
      "register": "neutral",
      "separable": true,
      "zh": "扣上扣子",
      "senses": [
        {
          "zh": "把衬衫扣好",
          "en": "to fasten the buttons on a shirt or coat",
          "example": {
            "en": "Button up your shirt before the interview starts.",
            "zh": "面试开始前把衬衫扣好。"
          }
        }
      ],
      "l1_note": "扣扣子是 button up，不是 close the buttons（中式）。",
      "confusables": [
        "zip up",
        "tuck in"
      ],
      "collocations": [
        "button up a shirt",
        "button it up"
      ],
      "collocations_zh": [
        "扣衬衫",
        "扣好"
      ]
    },
    {
      "id": "lace-up",
      "head": "lace up",
      "base": "lace",
      "particle": "up",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈleɪs ʌp",
      "chip": "home",
      "register": "neutral",
      "separable": true,
      "zh": "系鞋带",
      "senses": [
        {
          "zh": "把鞋带系好",
          "en": "to tie the laces of your shoes",
          "example": {
            "en": "Lace up properly — the trail is slippery.",
            "zh": "鞋带系好，山路很滑。"
          }
        }
      ],
      "l1_note": "系鞋带是 lace up / tie your shoes，不说 fasten the shoes。",
      "confusables": [
        "slip on",
        "zip up"
      ],
      "collocations": [
        "lace up your boots",
        "lace them up"
      ],
      "collocations_zh": [
        "系靴带",
        "系好"
      ]
    },
    {
      "id": "roll-up",
      "head": "roll up",
      "base": "roll",
      "particle": "up",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈroʊl ʌp",
      "chip": "home",
      "register": "neutral",
      "separable": true,
      "zh": "卷起（袖口、裤脚）",
      "senses": [
        {
          "zh": "把袖子卷上去",
          "en": "to fold the bottom of sleeves or pants upward",
          "example": {
            "en": "Roll up your sleeves — the sink is clogged again.",
            "zh": "把袖子卷起来，水槽又堵了。"
          }
        }
      ],
      "l1_note": "roll up 也指“到场、陆续抵达”，比如 roll up to the party。",
      "confusables": [
        "tuck in",
        "roll down"
      ],
      "collocations": [
        "roll up your sleeves",
        "roll up your jeans"
      ],
      "collocations_zh": [
        "卷袖子",
        "卷裤脚"
      ]
    },
    {
      "id": "tuck-in",
      "head": "tuck in",
      "base": "tuck",
      "particle": "in",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈtʌk ɪn",
      "chip": "home",
      "register": "neutral",
      "separable": true,
      "zh": "塞进（裤腰、被子）",
      "senses": [
        {
          "zh": "把衬衫塞进裤子",
          "en": "to push the bottom of a shirt into your pants",
          "example": {
            "en": "Tuck in your shirt — you look like you just got out of bed.",
            "zh": "把衬衫塞进去，你这样像刚起床。"
          }
        }
      ],
      "l1_note": "英式里 tuck in 还可以是“开吃”，美式少用；这里只讲穿衣。",
      "confusables": [
        "roll up",
        "button up"
      ],
      "collocations": [
        "tuck in a shirt",
        "tuck it in"
      ],
      "collocations_zh": [
        "衬衫塞进去",
        "塞好"
      ]
    },
    {
      "id": "go-with",
      "head": "go with",
      "base": "go",
      "particle": "with",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈɡoʊ wɪð",
      "chip": "shopping",
      "register": "spoken",
      "separable": false,
      "zh": "（颜色、款式）搭得上",
      "senses": [
        {
          "zh": "和别的衣服配",
          "en": "to look good together with something else",
          "example": {
            "en": "Do these shoes go with the dress, or is it too much?",
            "zh": "这双鞋配这条裙子吗，会不会太夸张？"
          }
        }
      ],
      "l1_note": "“配”不是 match with 才常用；口语说 go with。",
      "confusables": [
        "match up",
        "set off"
      ],
      "collocations": [
        "go with a dress",
        "go together"
      ],
      "collocations_zh": [
        "配裙子",
        "搭得上"
      ]
    },
    {
      "id": "match-up",
      "head": "match up",
      "base": "match",
      "particle": "up",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈmætʃ ʌp",
      "chip": "shopping",
      "register": "spoken",
      "separable": false,
      "zh": "搭配得上、对得上",
      "senses": [
        {
          "zh": "颜色或风格一致",
          "en": "when two things look the same or fit together",
          "example": {
            "en": "The bag doesn't match up with the rest of the outfit.",
            "zh": "这个包和整套搭配对不上。"
          }
        }
      ],
      "l1_note": "match up 强调“对得上”，go with 强调“配着好看”。",
      "confusables": [
        "go with",
        "mix up"
      ],
      "collocations": [
        "match up with",
        "the colors match up"
      ],
      "collocations_zh": [
        "和某物配",
        "颜色搭"
      ]
    },
    {
      "id": "stand-out",
      "head": "stand out",
      "base": "stand",
      "particle": "out",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈstænd aʊt",
      "chip": "social",
      "register": "neutral",
      "separable": false,
      "zh": "显眼、出众",
      "senses": [
        {
          "zh": "在人群里很突出",
          "en": "to be easy to notice because of how you look",
          "example": {
            "en": "Wear something bright if you want to stand out in the photos.",
            "zh": "想拍照显眼就穿亮色。"
          }
        }
      ],
      "l1_note": "“显眼”不是 be obvious；stand out 是褒义居多。",
      "confusables": [
        "show off",
        "show through"
      ],
      "collocations": [
        "stand out in a crowd",
        "stand out from the rest"
      ],
      "collocations_zh": [
        "人群里显眼",
        "脱颖而出"
      ]
    },
    {
      "id": "cover-up",
      "head": "cover up",
      "base": "cover",
      "particle": "up",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈkʌvər ʌp",
      "chip": "shopping",
      "register": "neutral",
      "separable": true,
      "zh": "遮住、盖住",
      "senses": [
        {
          "zh": "用衣服遮住不想露的地方",
          "en": "to put something over part of your body",
          "example": {
            "en": "Bring a cardigan to cover up if the restaurant is cold.",
            "zh": "餐厅冷的话带件开衫遮一下。"
          }
        }
      ],
      "l1_note": "cover up 还有“掩盖（错误）”的意思，穿衣语境看宾语。",
      "confusables": [
        "put on",
        "hide"
      ],
      "collocations": [
        "cover up your shoulders",
        "cover it up"
      ],
      "collocations_zh": [
        "遮肩膀",
        "遮住"
      ]
    },
    {
      "id": "strip-off",
      "head": "strip off",
      "base": "strip",
      "particle": "off",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈstrɪp ɔf",
      "chip": "home",
      "register": "spoken",
      "separable": false,
      "zh": "脱掉（一身衣服）",
      "senses": [
        {
          "zh": "热了或要洗澡时脱掉",
          "en": "to take off your clothes quickly",
          "example": {
            "en": "We stripped off our wet jackets the moment we got inside.",
            "zh": "一进门我们就把湿外套脱了。"
          }
        }
      ],
      "l1_note": "strip off 比较口语、常指整套；单件脱用 take off。",
      "confusables": [
        "take off",
        "change out of"
      ],
      "collocations": [
        "strip off wet clothes",
        "strip down"
      ],
      "collocations_zh": [
        "脱湿衣服",
        "脱掉"
      ]
    },
    {
      "id": "change-into",
      "head": "change into",
      "base": "change",
      "particle": "into",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈtʃeɪndʒ ˈɪntu",
      "chip": "home",
      "register": "neutral",
      "separable": false,
      "zh": "换上（另一套）",
      "senses": [
        {
          "zh": "从一套换成另一套",
          "en": "to take off what you are wearing and put on something else",
          "example": {
            "en": "I need ten minutes to change into something nicer.",
            "zh": "给我十分钟换身好点的。"
          }
        }
      ],
      "l1_note": "“换衣服”不是 change clothes 才完整；换成某套用 change into。",
      "confusables": [
        "change out of",
        "put on"
      ],
      "collocations": [
        "change into a suit",
        "change into pajamas"
      ],
      "collocations_zh": [
        "换西装",
        "换睡衣"
      ]
    },
    {
      "id": "change-out-of",
      "head": "change out of",
      "base": "change",
      "particle": "out",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈtʃeɪndʒ aʊt əv",
      "chip": "home",
      "register": "neutral",
      "separable": false,
      "zh": "把……换下来",
      "senses": [
        {
          "zh": "脱掉某套换别的",
          "en": "to take off the clothes you are wearing",
          "example": {
            "en": "Change out of your work clothes before dinner.",
            "zh": "晚饭前把工作服换下来。"
          }
        }
      ],
      "l1_note": "into 是换成什么，out of 是脱掉什么；方向别反。",
      "confusables": [
        "change into",
        "take off"
      ],
      "collocations": [
        "change out of a uniform",
        "change out of those shoes"
      ],
      "collocations_zh": [
        "换下制服",
        "换下鞋"
      ]
    },
    {
      "id": "break-in",
      "head": "break in",
      "base": "break",
      "particle": "in",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈbreɪk ɪn",
      "chip": "shopping",
      "register": "neutral",
      "separable": true,
      "zh": "把新鞋穿服帖",
      "senses": [
        {
