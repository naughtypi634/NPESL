    {
      "id": "take-in",
      "head": "take in",
      "base": "take",
      "particle": "in",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈteɪk ɪn",
      "chip": "shopping",
      "register": "neutral",
      "separable": true,
      "zh": "把衣服收窄；理解吸收；收留",
      "senses": [
        {
          "zh": "裁缝把衣服收窄",
          "en": "to make a piece of clothing smaller by sewing",
          "example": {
            "en": "I had the waist taken in — it fits perfectly now.",
            "zh": "我让裁缝把腰收了一下，现在正合身。"
          }
        },
        {
          "zh": "理解吸收",
          "en": "to understand and remember information",
          "example": {
            "en": "It took me a while to take in everything the doctor said.",
            "zh": "医生说的话我过了一阵才完全消化。"
          }
        },
        {
          "zh": "收留",
          "en": "to let someone stay in your home",
          "example": {
            "en": "Her cousin took her in for a month after the flood.",
            "zh": "洪水之后她表姐收留了她一个月。"
          }
        }
      ],
      "l1_note": "改小是 take in，放宽是 let out；take in 还有“吸收、理解”。",
      "confusables": [
        "let out",
        "fit into"
      ],
      "collocations": [
        "take in a dress",
        "have it taken in"
      ],
      "collocations_zh": [
        "裙子改小",
        "改小"
      ]
    },
