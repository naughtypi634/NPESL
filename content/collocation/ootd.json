      "l1_note": "break in 还有“闯入”，鞋的语境才指“穿服帖”。",
      "confusables": [
        "wear out",
        "break out"
      ],
      "collocations": [
        "break in new shoes",
        "break them in"
      ],
      "collocations_zh": [
