      "register": "spoken",
      "separable": true,
      "zh": "拿出去（垃圾）；点外卖；取出",
      "senses": [
        {
          "zh": "把垃圾拿出去",
          "en": "to carry something outside, especially trash",
          "example": {
            "en": "Can you take out the trash on your way down?",
            "zh": "你下楼的时候顺便把垃圾带下去好吗？"
          }
        },
        {
          "zh": "点外卖",
          "en": "to buy food from a restaurant and eat it elsewhere",
          "example": {
            "en": "Let's just take out some noodles tonight.",
            "zh": "今晚就点个外卖面吧。"
          }
        }
      ],
      "l1_note": "“外卖”不是 outside food 或 send food；美式说 takeout / to go。动词是 take out 或 order in。",
      "confusables": [
        "eat out",
        "order in"
      ],
      "collocations": [
        "take out the trash",
        "takeout food",
        "take out a loan"
      ],
      "collocations_zh": [
        "倒垃圾",
        "外卖",
        "办贷款"
      ]
    },
