{
  "theme": "home",
  "entries": [
    {
      "id": "move-in",
      "head": "move in",
      "base": "move",
      "particle": "in",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈmuv ɪn",
      "tier": 1,
      "level": "A2",
      "chip": "housing",
      "register": "neutral",
      "separable": false,
      "zh": "搬进来、入住",
      "senses": [
        {
          "zh": "搬进新住处",
          "en": "to start living in a new place",
          "example": {
            "en": "We move in on Saturday, so I need boxes by Friday.",
            "zh": "我们周六搬进去，所以周五前得弄到纸箱。"
          }
        }
      ],
      "l1_note": "搬进/搬出是 move in / move out，不是 move to in。中文“搬”一个字，英语要分方向。",
      "confusables": [
        "move out",
        "move on"
      ],
      "collocations": [
        "move in together",
        "move-in day",
        "move into a new apartment"
      ],
      "collocations_zh": [
        "一起搬进来",
        "搬家日",
        "搬进新公寓"
      ]
    },
    {
      "id": "move-out",
      "head": "move out",
      "base": "move",
      "particle": "out",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈmuv aʊt",
      "tier": 1,
      "level": "A2",
      "chip": "housing",
      "register": "neutral",
      "separable": false,
      "zh": "搬走、搬出去",
      "senses": [
        {
          "zh": "搬离原住处",
          "en": "to leave the place where you live",
          "example": {
            "en": "My roommate is moving out at the end of the month.",
            "zh": "我室友月底搬走。"
          }
        }
      ],
      "l1_note": "退租搬走 move out；只是出门是 go out。两个 out 意思完全不同。",
      "confusables": [
        "move in",
        "get out"
      ],
      "collocations": [
        "move out of the apartment",
        "move out early"
      ],
      "collocations_zh": [
        "搬出公寓",
        "提前搬走"
      ]
    },
    {
