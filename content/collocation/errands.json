    {
      "id": "hand-in-errand",
      "head": "hand in",
      "base": "hand",
      "particle": "in",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈhænd ɪn",
      "chip": "errands",
      "register": "neutral",
      "separable": true,
      "zh": "把材料交到窗口；上交；自首",
      "senses": [
        {
          "zh": "把材料交到窗口",
          "en": "to give documents to an office",
          "example": {
            "en": "Hand in the form with your ID at window three.",
            "zh": "三号窗口交表和身份证。"
          }
        },
        {
          "zh": "上交",
          "en": "to give something to someone in authority",
          "example": {
            "en": "Please hand in your badge at the front desk.",
            "zh": "请把工牌交到前台。"
          }
        },
        {
          "zh": "自首",
          "en": "to surrender to the police",
          "example": {
            "en": "The suspect handed himself in that night.",
            "zh": "嫌疑人当晚自首了。"
          }
        }
      ],
      "l1_note": "上交是 hand in；hand over 是移交。",
      "confusables": [
        "turn in",
        "hand over"
      ],
      "collocations": [
        "hand in an application",
        "hand it in"
      ],
      "collocations_zh": [
        "交申请表",
        "交上去"
      ]
