{
  "theme": "feeling-off",
  "entries": [
    {
      "id": "come-down-with",
      "head": "come down with",
      "base": "come",
      "particle": "down",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈkʌm daʊn wɪð",
      "tier": 1,
      "level": "B1",
      "chip": "doctor",
      "register": "spoken",
      "separable": false,
      "zh": "得了（小病）",
      "senses": [
        {
          "zh": "染上感冒、流感这类小病",
          "en": "to start to have an illness that is not serious",
          "example": {
            "en": "I think I'm coming down with something — my throat hurts.",
            "zh": "我感觉要病了，嗓子疼。"
          }
        }
      ],
      "l1_note": "“感冒了”不是 I got a cold only；刚有症状说 I'm coming down with a cold 最自然。",
      "confusables": [
        "get over",
        "catch"
      ],
      "collocations": [
        "come down with a cold",
        "come down with the flu"
      ],
      "collocations_zh": [
        "得感冒",
        "得流感"
      ]
    },
    {
      "id": "throw-up",
      "head": "throw up",
      "base": "throw",
      "particle": "up",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈθroʊ ʌp",
      "tier": 1,
      "level": "B1",
      "chip": "doctor",
      "register": "spoken",
      "separable": false,
      "zh": "呕吐",
      "senses": [
        {
          "zh": "把吃的东西吐出来",
          "en": "to vomit",
          "example": {
            "en": "I threw up twice after that street food.",
            "zh": "吃完那个路边摊我吐了两次。"
          }
        }
      ],
      "l1_note": "中文“吐”有两个方向：吐出来 throw up，吐痰 spit。别混。",
      "confusables": [
        "pass out",
        "feel sick"
      ],
      "collocations": [
        "throw up after eating",
        "feel like throwing up"
      ],
      "collocations_zh": [
        "吃完吐",
        "想吐"
      ]
    },
    {
      "id": "pass-out",
      "head": "pass out",
      "base": "pass",
      "particle": "out",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈpæs aʊt",
      "tier": 1,
      "level": "B1",
      "chip": "doctor",
      "register": "spoken",
      "separable": false,
      "zh": "昏过去、失去知觉",
      "senses": [
        {
          "zh": "因疼痛、缺氧等晕倒",
          "en": "to become unconscious for a short time",
          "example": {
            "en": "He passed out in the subway and woke up on the platform.",
            "zh": "他在地铁里晕过去，醒来时躺在站台上。"
          }
        }
      ],
      "l1_note": "晕倒不是 faint 才地道（faint 也对），口语更常说 pass out；睡过去也是 pass out。",
      "confusables": [
        "black out",
        "throw up"
      ],
      "collocations": [
        "pass out from the heat",
        "almost pass out"
      ],
      "collocations_zh": [
        "热晕",
        "差点晕"
      ]
    },
    {
      "id": "break-out-in",
      "head": "break out in",
      "base": "break",
      "particle": "out",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈbreɪk aʊt ɪn",
      "tier": 2,
      "level": "B1",
      "chip": "doctor",
      "register": "neutral",
      "separable": false,
      "zh": "（皮肤）突然起疹子、冒汗",
      "senses": [
        {
          "zh": "皮肤突然出现症状",
          "en": "to suddenly get a rash or sweat",
          "example": {
            "en": "I broke out in hives after trying that new face cream.",
            "zh": "我用了那款新面霜后突然起荨麻疹。"
          }
        }
      ],
      "confusables": [
        "break out",
        "come out in"
      ],
      "collocations": [
        "break out in a rash",
        "break out in a sweat"
      ],
      "l1_note": "后面接疹子、汗这类东西；只爆痘是 break out。",
      "collocations_zh": [
        "起疹子",
        "冒汗"
      ]
    },
    {
      "id": "pull-through",
      "head": "pull through",
      "base": "pull",
      "particle": "through",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈpʊl θru",
      "tier": 2,
      "level": "B1",
      "chip": "doctor",
      "register": "neutral",
      "separable": false,
      "zh": "挺过来、活下来",
      "senses": [
        {
          "zh": "重病或难关后恢复",
          "en": "to survive a serious illness or difficult time",
          "example": {
            "en": "The doctors weren't sure, but Grandpa pulled through.",
            "zh": "医生也没把握，但爷爷挺过来了。"
          }
        }
      ],
      "confusables": [
        "get through",
        "get over"
      ],
      "collocations": [
        "pull through surgery",
        "pull through a rough patch"
      ],
      "l1_note": "挺过大病用 pull through；get through 是熬过一段时间。",
      "collocations_zh": [
        "挺过手术",
        "挺过难关"
      ]
    },
    {
      "id": "get-over",
      "head": "get over",
      "base": "get",
      "particle": "over",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈɡɛt ˈoʊvər",
      "tier": 1,
      "level": "B1",
      "chip": "doctor",
      "register": "spoken",
      "separable": true,
      "zh": "康复；走出来",
      "senses": [
        {
          "zh": "病好起来",
          "en": "to become healthy again after an illness",
          "example": {
            "en": "It took me two weeks to get over that cough.",
            "zh": "那个咳嗽我两个星期才好。"
          }
        },
        {
          "zh": "从情绪里走出来",
          "en": "to feel normal again after a bad experience",
          "example": {
            "en": "She still hasn't gotten over the breakup.",
            "zh": "她还没从分手里走出来。"
          }
        }
      ],
      "l1_note": "康复是 get over it，不是 get well over it；情绪上“走出来”也是 get over。",
      "confusables": [
        "get through",
        "pull through"
      ],
      "collocations": [
        "get over a cold",
        "get over a breakup"
      ],
      "collocations_zh": [
        "感冒康复",
        "走出分手"
      ]
    },
    {
      "id": "fight-off",
      "head": "fight off",
      "base": "fight",
      "particle": "off",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈfaɪt ɔf",
      "tier": 2,
      "level": "B1",
      "chip": "doctor",
      "register": "neutral",
      "separable": true,
      "zh": "抵抗住（病毒、困意）",
      "senses": [
        {
          "zh": "身体抵抗住疾病",
          "en": "to stop an illness from affecting you",
          "example": {
            "en": "Loads of people are sick, but I've fought it off so far.",
            "zh": "好多人都病了，我暂时还扛住了。"
          }
        }
      ],
      "confusables": [
        "fend off",
        "get over"
      ],
      "collocations": [
        "fight off a cold",
        "fight off sleep"
      ],
      "l1_note": "抵抗住病毒、困意；fight off 不是 fight with。",
      "collocations_zh": [
        "抵抗感冒",
        "抵抗困意"
      ]
    },
    {
      "id": "wear-off",
      "head": "wear off",
      "base": "wear",
      "particle": "off",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈwɛr ɔf",
      "tier": 2,
      "level": "B1",
      "chip": "pharmacy",
      "register": "neutral",
      "separable": false,
      "zh": "（药效、感觉）渐渐消退",
      "senses": [
        {
          "zh": "药效慢慢过去",
          "en": "when the effect of a drug or feeling slowly disappears",
          "example": {
            "en": "The painkiller wore off around 3 a.m.",
            "zh": "止痛药凌晨三点左右失效了。"
          }
        }
      ],
      "confusables": [
        "wear out",
        "kick in"
      ],
      "collocations": [
        "the medicine wears off",
        "the effect wears off"
      ],
      "l1_note": "药效过去；kick in 是起效，方向正好相反。",
      "collocations_zh": [
        "药效过去",
        "效果消退"
      ]
    },
    {
      "id": "kick-in",
      "head": "kick in",
      "base": "kick",
      "particle": "in",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈkɪk ɪn",
      "tier": 2,
      "level": "B1",
      "chip": "pharmacy",
      "register": "spoken",
      "separable": false,
      "zh": "（药效）开始起作用",
      "senses": [
        {
          "zh": "药开始见效",
          "en": "when a drug starts to have an effect",
          "example": {
            "en": "Give it twenty minutes for the medicine to kick in.",
            "zh": "等二十分钟，药才起效。"
          }
        }
      ],
      "confusables": [
        "wear off",
        "come on"
      ],
      "collocations": [
        "the medicine kicks in",
        "the caffeine kicks in"
      ],
      "l1_note": "药效开始；常见句型 give it 20 minutes to kick in。",
      "collocations_zh": [
        "药起效",
        "咖啡因起效"
      ]
    },
    {
      "id": "run-down",
      "head": "run down",
      "base": "run",
      "particle": "down",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈrʌn daʊn",
      "tier": 2,
      "level": "B1",
      "chip": "doctor",
      "register": "spoken",
      "separable": false,
      "zh": "身体垮、状态差",
      "senses": [
        {
          "zh": "累到身体吃不消",
          "en": "to be very tired and not healthy",
          "example": {
            "en": "You look run down — take a few days off.",
            "zh": "你看着状态很差，休几天吧。"
          }
        }
      ],
      "confusables": [
        "worn out",
        "burn out"
      ],
      "collocations": [
        "feel run down",
        "run yourself down"
      ],
      "l1_note": "状态差、身体垮；run down 也指撞倒、贬低。",
      "collocations_zh": [
        "状态差",
        "把自己拖垮"
      ]
    },
    {
      "id": "cut-back-on",
      "head": "cut back on",
      "base": "cut",
      "particle": "back",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈkʌt bæk ɑn",
      "tier": 2,
      "level": "B1",
      "chip": "doctor",
      "register": "spoken",
      "separable": false,
      "zh": "减少（摄入、花费）",
      "senses": [
        {
          "zh": "为了健康或省钱减量",
          "en": "to use or eat less of something",
          "example": {
            "en": "My doctor said to cut back on salt and fried food.",
            "zh": "医生让我少吃盐和油炸的。"
          }
        }
      ],
      "confusables": [
        "cut down on",
        "cut out"
      ],
      "collocations": [
        "cut back on drinking",
        "cut back on spending"
      ],
      "l1_note": "减少摄入；cut down on 同义，cut out 是彻底戒。",
      "collocations_zh": [
        "少喝酒",
        "少花钱"
      ]
    },
    {
      "id": "give-up",
      "head": "give up",
      "base": "give",
      "particle": "up",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈɡɪv ʌp",
      "tier": 1,
      "level": "A2",
      "chip": "doctor",
      "register": "spoken",
      "separable": true,
      "zh": "戒掉某个习惯；自首；交出",
      "senses": [
        {
          "zh": "戒掉某个习惯",
          "en": "to stop doing something you used to do",
          "example": {
            "en": "He gave up smoking after the checkup.",
            "zh": "体检之后他把烟戒了。"
          }
        },
        {
          "zh": "自首",
          "en": "to surrender to the police",
          "example": {
            "en": "The driver gave himself up the next morning.",
            "zh": "司机第二天早上自首了。"
          }
        },
        {
          "zh": "交出",
          "en": "to hand someone over to the police",
          "example": {
            "en": "The family refused to give him up.",
            "zh": "家里人拒绝把他交出去。"
          }
        }
      ],
      "l1_note": "“戒烟”是 give up smoking / quit smoking，不是 give up to smoke。",
      "confusables": [
        "give in",
        "give up on"
      ],
      "collocations": [
        "give up smoking",
        "give up sugar"
      ],
      "collocations_zh": [
        "戒烟",
        "戒糖"
      ]
    },
    {
      "id": "check-up-on",
      "head": "check up on",
      "base": "check",
      "particle": "up",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈtʃɛk ʌp ɑn",
      "tier": 2,
      "level": "B1",
      "chip": "doctor",
      "register": "spoken",
      "separable": false,
      "zh": "看看某人的情况",
      "senses": [
        {
          "zh": "关心地询问或查看",
          "en": "to find out how someone is doing",
          "example": {
            "en": "My mom keeps checking up on me after the surgery.",
            "zh": "手术之后我妈一直问我怎么样。"
          }
        }
      ],
      "confusables": [
        "check on",
        "look after"
      ],
      "collocations": [
        "check up on a friend",
        "check up on the patient"
      ],
      "l1_note": "关心地查看；不是 check（检查）。",
      "collocations_zh": [
        "关心朋友",
        "查看病人"
      ]
    },
    {
      "id": "feel-up-to",
      "head": "feel up to",
      "base": "feel",
      "particle": "up",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈfil ʌp tu",
      "tier": 3,
      "level": "B1",
      "chip": "doctor",
      "register": "spoken",
      "separable": false,
      "zh": "（身体）撑得住做某事",
      "senses": [
        {
          "zh": "有精力做某事",
          "en": "to have enough energy to do something",
          "example": {
            "en": "I don't feel up to going out tonight — I'm still recovering.",
            "zh": "我今晚没精力出门，还在恢复。"
          }
        }
      ],
      "confusables": [
        "be up for",
        "feel like"
      ],
      "collocations": [
        "feel up to going out",
        "feel up to it"
      ],
      "l1_note": "有精力做某事；be up for 是想做，不一样。",
      "collocations_zh": [
        "有精力出门",
        "撑得住"
      ]
    },
    {
      "id": "cut-out",
      "head": "cut out",
      "base": "cut",
      "particle": "out",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈkʌt aʊt",
      "tier": 1,
      "level": "B1",
      "chip": "dining",
      "register": "spoken",
      "separable": true,
      "zh": "完全不吃、不用；剪下；删掉",
      "senses": [
        {
          "zh": "完全不吃、不用",
          "en": "to stop eating or using something completely",
          "example": {
            "en": "My doctor told me to cut out caffeine for a month.",
            "zh": "医生让我一个月别碰咖啡因。"
          }
        },
        {
          "zh": "剪下",
          "en": "to remove something by cutting",
          "example": {
            "en": "She cut out the coupon and put it in her wallet.",
            "zh": "她把优惠券剪下来放进钱包。"
          }
        },
        {
          "zh": "删掉",
          "en": "to remove part of a text or recording",
          "example": {
            "en": "The editor cut out the last paragraph.",
            "zh": "编辑把最后一段删了。"
          }
        }
      ],
      "l1_note": "cut down on 是减少，cut out 是彻底戒掉；中文都说“少喝点/戒了”，英语分两级。",
      "confusables": [
        "cut down on",
        "give up"
      ],
      "collocations": [
        "cut out sugar",
        "cut out late nights"
      ],
      "collocations_zh": [
        "戒糖",
        "戒熬夜"
      ]
    },
    {
      "id": "black-out",
      "head": "black out",
      "base": "black",
      "particle": "out",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈblæk aʊt",
      "chip": "doctor",
      "register": "neutral",
      "separable": false,
      "zh": "眼前一黑、短暂失去意识",
      "senses": [
        {
          "zh": "短时间断片",
          "en": "to lose consciousness for a short time",
          "example": {
            "en": "He blacked out for a few seconds when he stood up.",
            "zh": "他站起来时眼前黑了几秒。"
          }
        }
      ],
      "l1_note": "black out 是短暂失去意识；pass out 是直接晕倒。",
      "confusables": [
        "pass out",
        "faint"
      ],
      "collocations": [
        "black out from the heat",
        "nearly black out"
      ],
      "collocations_zh": [
        "热得眼前一黑",
        "差点晕"
      ]
    },
    {
      "id": "throw-off",
      "head": "throw off",
      "base": "throw",
      "particle": "off",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈθroʊ ɔf",
      "chip": "doctor",
      "register": "neutral",
      "separable": true,
      "zh": "摆脱（病、影响）",
      "senses": [
        {
          "zh": "把病甩掉",
          "en": "to get rid of an illness",
          "example": {
            "en": "I can't seem to throw off this cough.",
            "zh": "这咳嗽怎么也甩不掉。"
          }
        }
      ],
      "l1_note": "甩掉病是 throw off；throw up 是吐，差一个词。",
      "confusables": [
        "shake off",
        "get over"
      ],
      "collocations": [
        "throw off a cold",
        "throw it off"
      ],
      "collocations_zh": [
        "甩掉感冒",
        "甩掉"
      ]
    },
    {
      "id": "sleep-off",
      "head": "sleep off",
      "base": "sleep",
      "particle": "off",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈslip ɔf",
      "chip": "doctor",
      "register": "neutral",
      "separable": true,
      "zh": "睡一觉缓过来",
      "senses": [
        {
          "zh": "靠睡觉消掉症状",
          "en": "to get rid of a headache or hangover by sleeping",
          "example": {
            "en": "Let her sleep off the fever.",
            "zh": "让她睡一觉把烧退了。"
          }
        }
      ],
      "l1_note": "睡一觉好是 sleep off；不是 sleep away（那是睡过去）。",
      "confusables": [
        "rest up",
        "sweat out"
      ],
      "collocations": [
        "sleep off a headache",
        "sleep it off"
      ],
      "collocations_zh": [
        "睡掉头痛",
        "睡一觉好"
      ]
    },
    {
      "id": "sweat-out",
      "head": "sweat out",
      "base": "sweat",
      "particle": "out",
      "kind": "phrasal",
      "freq": 2,
      "ipa": "ˈswɛt aʊt",
      "chip": "doctor",
      "register": "spoken",
      "separable": true,
      "zh": "发汗退掉",
      "senses": [
        {
          "zh": "靠出汗驱寒",
          "en": "to get rid of a cold by sweating",
          "example": {
            "en": "People say you can sweat out a fever with ginger tea.",
            "zh": "都说姜茶能发汗退烧。"
          }
        }
      ],
      "l1_note": "发汗是 sweat out；sweat it out 是硬熬过去。",
      "confusables": [
        "sleep off",
        "sweat it out"
      ],
      "collocations": [
        "sweat out a cold",
        "sweat it out"
      ],
      "collocations_zh": [
        "发汗治感冒",
        "发汗"
      ]
    },
    {
      "id": "get-through",
      "head": "get through",
      "base": "get",
      "particle": "through",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈɡɛt θru",
      "chip": "doctor",
      "register": "neutral",
      "separable": false,
      "zh": "熬过（病、一段时间）",
      "senses": [
        {
          "zh": "撑过难受的时期",
          "en": "to survive a difficult period",
          "example": {
            "en": "It's a rough week, but we'll get through it.",
            "zh": "这周很难，但我们会熬过去。"
          }
        }
      ],
      "l1_note": "熬过是 get through；through 不能省。",
      "confusables": [
        "get over",
        "pull through"
