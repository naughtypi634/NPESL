{
  "theme": "meetings",
  "entries": [
    {
      "id": "kick-off",
      "head": "kick off",
      "base": "kick",
      "particle": "off",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈkɪk ɔf",
      "chip": "meetings",
      "register": "spoken",
      "separable": true,
      "zh": "启动（项目、会议）",
      "senses": [
        {
          "zh": "正式开始",
          "en": "to start a project or meeting",
          "example": {
            "en": "Let's kick off with the numbers from last week.",
            "zh": "先从上周的数据开始吧。"
          }
        }
      ],
      "l1_note": "启动是 kick off；kick out 是赶走。",
      "confusables": [
        "start up",
        "wrap up"
      ],
      "collocations": [
        "kick off a meeting",
        "kick off the project"
      ],
      "collocations_zh": [
        "启动会议",
        "启动项目"
      ]
    },
    {
