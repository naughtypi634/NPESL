{
  "theme": "weekend-plan",
  "entries": [
    {
      "id": "hold-off",
      "head": "hold off",
      "base": "hold",
      "particle": "off",
      "kind": "phrasal",
      "ipa": "ˈhoʊld ɔf",
      "tier": 2,
      "level": "B1",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "暂缓、先等等",
      "senses": [
        {
          "zh": "先不做，等条件成熟",
          "en": "to delay doing something",
          "example": {
            "en": "Let's hold off on the launch until the bug is fixed.",
            "zh": "等这个 bug 修好再上线吧。"
          }
        }
      ],
      "l1_note": "“先不”不是 hold on（那是等一下）；推迟意思是 hold off (on)。",
      "confusables": [
        "put off",
        "hold on"
      ],
      "collocations": [
        "hold off on a decision",
        "hold off until Friday"
      ],
      "collocations_zh": [
        "暂缓决定",
        "等到周五"
      ]
    },
    {
      "id": "put-off",
      "head": "put off",
      "base": "put",
      "particle": "off",
      "kind": "phrasal",
      "ipa": "ˈpʊt ɔf",
      "tier": 1,
      "level": "B1",
      "chip": "office",
      "register": "spoken",
      "separable": true,
      "zh": "推迟；让人反感",
      "senses": [
        {
          "zh": "把事往后推",
          "en": "to change something to a later time",
          "example": {
            "en": "We put off the meeting until next Tuesday.",
            "zh": "我们把会议推到下周二了。"
          }
        },
        {
          "zh": "让人不想靠近",
          "en": "to make someone lose interest or feel uncomfortable",
          "example": {
            "en": "His constant complaining really puts people off.",
            "zh": "他没完没了地抱怨，让人很不想接近。"
          }
        }
      ],
      "l1_note": "“拖延”不是 delay it again；put off 还有“倒胃口、让人反感”这层意思。",
      "confusables": [
        "hold off",
        "call off"
      ],
      "collocations": [
        "put off a decision",
        "put someone off"
      ],
      "collocations_zh": [
        "推迟决定",
        "让人反感"
      ]
    },
    {
      "id": "push-back",
      "head": "push back",
      "base": "push",
      "particle": "back",
      "kind": "phrasal",
      "ipa": "ˈpʊʃ bæk",
      "tier": 2,
      "level": "B1",
      "chip": "meetings",
      "register": "neutral",
      "separable": true,
      "zh": "推迟（时间）；反对",
      "senses": [
        {
          "zh": "把时间往后挪",
          "en": "to change an event to a later time",
          "example": {
            "en": "They pushed the deadline back by a week.",
            "zh": "他们把截止日往后推了一周。"
          }
        }
      ],
      "confusables": [
        "bring forward",
        "put off"
      ],
      "collocations": [
        "push back the deadline",
        "push back on an idea"
      ],
      "l1_note": "推迟时间；bring forward 是提前。",
      "collocations_zh": [
        "推迟截止",
        "反对想法"
      ]
    },
    {
      "id": "bring-forward",
      "head": "bring forward",
      "base": "bring",
      "particle": "forward",
      "kind": "phrasal",
      "ipa": "ˈbrɪŋ ˈfɔrwərd",
      "tier": 2,
      "level": "B1",
      "chip": "meetings",
      "register": "neutral",
      "separable": true,
      "zh": "提前（时间）",
      "senses": [
        {
          "zh": "把安排挪到更早",
          "en": "to change an event to an earlier time",
          "example": {
            "en": "Can we bring the meeting forward to 9:30?",
            "zh": "会议能提前到九点半吗？"
          }
        }
      ],
      "l1_note": "提前是 bring forward，不是 bring earlier；推后是 push back。",
      "confusables": [
        "push back",
        "move up"
      ],
      "collocations": [
        "bring forward a meeting",
        "bring the date forward"
      ],
      "collocations_zh": [
        "提前会议",
        "提前日期"
      ]
    },
    {
      "id": "get-around-to",
      "head": "get around to",
      "base": "get",
      "particle": "around",
      "kind": "phrasal",
      "ipa": "ˈɡɛt əˈraʊnd tu",
      "tier": 2,
      "level": "B1",
      "chip": "home",
      "register": "spoken",
      "separable": false,
      "zh": "终于抽出时间做",
      "senses": [
        {
          "zh": "拖了很久才做",
          "en": "to finally do something you have been putting off",
          "example": {
            "en": "I still haven't gotten around to cleaning the fridge.",
            "zh": "我一直没腾出时间清理冰箱。"
          }
        }
      ],
      "l1_note": "“终于有时间做”不是 finally have time；get around to 强调拖了很久。",
      "confusables": [
        "put off",
        "find time"
      ],
      "collocations": [
        "get around to it",
        "get around to reading"
      ],
      "collocations_zh": [
        "抽空做",
        "抽空读"
      ]
    },
    {
      "id": "fit-in",
      "head": "fit in",
      "base": "fit",
      "particle": "in",
      "kind": "phrasal",
      "ipa": "ˈfɪt ɪn",
      "tier": 1,
      "level": "B1",
      "chip": "office",
      "register": "spoken",
      "separable": true,
      "zh": "挤出时间安排；融入",
      "senses": [
        {
          "zh": "在忙里插入一件事",
          "en": "to find time for something in a busy schedule",
          "example": {
            "en": "I can fit you in at four if that works.",
            "zh": "四点我能给你腾出时间，行吗？"
          }
        },
        {
          "zh": "融入一个群体",
          "en": "to feel accepted by a group",
          "example": {
            "en": "It took a while to fit in at the new office.",
            "zh": "我花了一阵子才融入新办公室。"
          }
        }
      ],
      "l1_note": "“插队加个日程”不是 put you in my time；fit someone in 才是。",
      "confusables": [
        "squeeze in",
        "settle in"
      ],
      "collocations": [
        "fit in a meeting",
        "fit in with the team"
      ],
      "collocations_zh": [
        "安排会议",
        "融入团队"
      ]
    },
    {
      "id": "squeeze-in",
      "head": "squeeze in",
      "base": "squeeze",
      "particle": "in",
      "kind": "phrasal",
      "ipa": "ˈskwiz ɪn",
      "tier": 3,
      "level": "B1",
      "chip": "office",
      "register": "spoken",
      "separable": true,
      "zh": "硬挤进去、挤时间",
      "senses": [
        {
          "zh": "时间很紧还塞进一件事",
          "en": "to manage to do something even though there is little time",
          "example": {
            "en": "I squeezed in a quick call between meetings.",
            "zh": "我在两个会之间硬塞了个电话。"
          }
        }
      ],
      "confusables": [
        "fit in",
        "cram in"
      ],
      "collocations": [
        "squeeze in a workout",
        "squeeze it in"
      ],
      "l1_note": "硬挤时间；fit in 是安排得下。",
      "collocations_zh": [
        "挤时间健身",
        "硬挤进去"
      ]
    },
    {
      "id": "come-up",
      "head": "come up",
      "base": "come",
      "particle": "up",
      "kind": "phrasal",
      "ipa": "ˈkʌm ʌp",
      "tier": 1,
      "level": "B1",
      "chip": "office",
      "register": "spoken",
      "separable": false,
      "zh": "（时间）临近；（事）冒出来",
      "senses": [
        {
          "zh": "某件事快要到了",
          "en": "when an event is going to happen soon",
          "example": {
            "en": "The deadline is coming up, so I'm staying late.",
            "zh": "截止日快到了，我最近都在加班。"
          }
        }
      ],
      "l1_note": "“快到了”不是 is coming soon 才自然；日程临近常说 is coming up。",
      "confusables": [
        "come up with",
        "come along"
      ],
      "collocations": [
        "a deadline is coming up",
        "come up in a meeting"
      ],
      "collocations_zh": [
        "期限临近",
        "会上冒出"
      ]
    },
    {
      "id": "set-aside",
      "head": "set aside",
      "base": "set",
      "particle": "aside",
      "kind": "phrasal",
      "ipa": "ˈsɛt əˈsaɪd",
      "tier": 1,
      "level": "B1",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "留出（时间、钱）",
      "senses": [
        {
          "zh": "专门腾出时间或预算",
          "en": "to keep time or money for a special purpose",
          "example": {
            "en": "Set aside an hour every morning for reading.",
            "zh": "每天早上留一小时读书。"
          }
        }
      ],
      "l1_note": "“留时间”不是 leave time（也行）但更常用 set aside；留钱也是它。",
      "confusables": [
        "save up",
        "put aside"
      ],
      "collocations": [
        "set aside time",
        "set aside money"
      ],
      "collocations_zh": [
        "留时间",
        "留钱"
      ]
    },
    {
      "id": "stick-to",
      "head": "stick to",
      "base": "stick",
      "particle": "to",
      "kind": "phrasal",
      "ipa": "ˈstɪk tu",
      "tier": 2,
      "level": "B1",
      "chip": "dining",
      "register": "spoken",
      "separable": false,
      "zh": "坚持（计划、饮食）",
      "senses": [
        {
          "zh": "按计划不改变",
          "en": "to continue with a plan or rule without changing it",
          "example": {
            "en": "I'll stick to water tonight — I have an early meeting.",
            "zh": "我今晚就喝水，明天一早有会。"
          }
        }
      ],
      "confusables": [
        "stick with",
        "keep to"
      ],
      "collocations": [
        "stick to the plan",
        "stick to a diet"
      ],
      "l1_note": "坚持计划；stick with 是坚持不换。",
      "collocations_zh": [
        "按计划",
        "坚持饮食"
      ]
    },
    {
      "id": "sign-up-for",
      "head": "sign up for",
      "base": "sign",
      "particle": "up",
      "kind": "phrasal",
      "ipa": "ˈsaɪn ʌp fɔr",
      "tier": 1,
      "level": "B1",
      "chip": "study",
      "register": "neutral",
      "separable": false,
      "zh": "报名参加",
      "senses": [
        {
          "zh": "报名课程、活动",
          "en": "to put your name on a list for a course or activity",
          "example": {
            "en": "I signed up for a speaking class on Tuesday nights.",
            "zh": "我报了个周二晚上的口语课。"
          }
        }
      ],
      "l1_note": "报名是 sign up for，不是 apply for（那是正式申请职位/签证）。",
      "confusables": [
        "apply for",
        "enroll in"
      ],
      "collocations": [
        "sign up for a class",
        "sign up for a newsletter"
      ],
      "collocations_zh": [
        "报名课程",
        "订阅简报"
      ]
    },
    {
      "id": "take-up",
      "head": "take up",
      "base": "take",
      "particle": "up",
      "kind": "phrasal",
      "ipa": "ˈteɪk ʌp",
      "tier": 1,
      "level": "B1",
      "chip": "leisure",
      "register": "neutral",
      "separable": true,
      "zh": "开始培养一个爱好；改短（衣服）",
      "senses": [
        {
          "zh": "开始培养一个爱好",
          "en": "to start doing an activity regularly",
          "example": {
            "en": "I took up swimming after my knee started hurting.",
            "zh": "膝盖开始疼以后我改练游泳了。"
          }
        },
        {
          "zh": "改短衣服",
          "en": "to make a piece of clothing shorter",
          "example": {
            "en": "The tailor took up the sleeves by two centimeters.",
            "zh": "裁缝把袖子改短了两厘米。"
          }
        }
      ],
      "l1_note": "“开始学”不是 start to learn 才自然；开始一项活动常用 take up。",
      "confusables": [
        "take on",
        "pick up"
      ],
      "collocations": [
        "take up a hobby",
        "take up running"
      ],
      "collocations_zh": [
        "开始爱好",
        "开始跑步"
      ]
    },
    {
      "id": "take-to",
      "head": "take to",
      "base": "take",
      "particle": "to",
      "kind": "phrasal",
      "ipa": "ˈteɪk tu",
      "tier": 2,
      "level": "B1",
      "chip": "leisure",
      "register": "spoken",
      "separable": false,
      "zh": "很快就喜欢上、上手",
      "senses": [
        {
          "zh": "一开始就喜欢或适应",
          "en": "to start to like something or get good at it quickly",
          "example": {
            "en": "She took to the guitar faster than anyone expected.",
            "zh": "她学吉他快得超出所有人预料。"
          }
        }
      ],
      "confusables": [
        "get into",
        "warm up to"
      ],
      "collocations": [
        "take to a new hobby",
        "take to someone"
      ],
      "l1_note": "很快喜欢或上手；get into 是逐渐喜欢。",
      "collocations_zh": [
        "很快喜欢新爱好",
        "喜欢某人"
      ]
    },
    {
      "id": "get-into",
      "head": "get into",
      "base": "get",
      "particle": "into",
      "kind": "phrasal",
      "ipa": "ˈɡɛt ˈɪntu",
      "tier": 1,
      "level": "B1",
      "chip": "leisure",
      "register": "spoken",
      "separable": false,
      "zh": "喜欢上、沉迷；进入；陷入（麻烦）",
      "senses": [
        {
          "zh": "逐渐喜欢并投入",
          "en": "to become interested in something",
          "example": {
            "en": "I got into baking during the lockdown and never stopped.",
            "zh": "封控期间我开始迷上烘焙，一直没停。"
          }
        },
        {
          "zh": "进入",
          "en": "to enter a place or vehicle",
          "example": {
            "en": "We got into the car and headed for the airport.",
            "zh": "我们上车往机场开。"
          }
        },
        {
          "zh": "陷入麻烦",
          "en": "to become involved in a difficult situation",
          "example": {
            "en": "He got into trouble for missing the safety training.",
            "zh": "他因为没参加安全培训惹了麻烦。"
          }
        }
      ],
      "l1_note": "“入坑”不是 fall into the pit；英语是 get into something。",
      "confusables": [
        "take to",
        "be into"
      ],
      "collocations": [
        "get into photography",
        "get into a routine"
      ],
      "collocations_zh": [
        "迷上摄影",
        "进入节奏"
      ]
    },
    {
      "id": "be-into",
      "head": "be into",
      "base": "be",
      "particle": "into",
      "kind": "phrasal",
      "ipa": "ˈbi ˈɪntu",
      "tier": 2,
      "level": "B1",
      "chip": "leisure",
      "register": "spoken",
      "separable": false,
      "zh": "对……很感兴趣",
      "senses": [
        {
          "zh": "喜欢并投入某个领域",
          "en": "to be very interested in something",
          "example": {
            "en": "I'm really into bouldering these days.",
            "zh": "我最近很迷攀岩。"
          }
        }
      ],
      "l1_note": "“我很喜欢”不是 I very like it（中式）；I'm really into it 才地道。",
      "confusables": [
        "get into",
        "be fond of"
      ],
      "collocations": [
        "be into photography",
        "be into someone"
      ],
      "collocations_zh": [
        "喜欢摄影",
        "喜欢某人"
      ]
    },
    {
      "id": "work-on",
      "head": "work on",
      "base": "work",
      "particle": "on",
      "kind": "phrasal",
      "ipa": "ˈwɝrk ɑn",
      "tier": 1,
      "level": "B1",
      "chip": "study",
      "register": "neutral",
      "separable": false,
      "zh": "在做（项目）；改善",
      "senses": [
        {
          "zh": "正在做某件事",
          "en": "to spend time doing or improving something",
          "example": {
            "en": "I'm working on my pronunciation this month.",
            "zh": "我这个月在练发音。"
          }
        }
      ],
      "l1_note": "“我在练发音”不是 I am practicing pronunciation 才自然；work on 更宽，含改进。",
      "confusables": [
        "work out",
        "work through"
      ],
      "collocations": [
        "work on a project",
        "work on your English"
      ],
      "collocations_zh": [
        "做项目",
        "练英语"
      ]
    },
    {
      "id": "plan-out",
      "head": "plan out",
      "base": "plan",
      "particle": "out",
      "kind": "phrasal",
      "ipa": "ˈplæn aʊt",
      "chip": "leisure",
      "register": "neutral",
      "separable": true,
      "zh": "把计划排出来",
      "senses": [
        {
          "zh": "一步步安排好",
          "en": "to decide all the details of a plan",
          "example": {
            "en": "We planned out the whole trip in one evening.",
            "zh": "我们一个晚上就把行程排好了。"
          }
        }
      ],
      "l1_note": "排计划是 plan out；plan 单独是打算。",
      "confusables": [
        "map out",
        "line up"
      ],
      "collocations": [
        "plan out a trip",
        "plan it out"
      ],
      "collocations_zh": [
        "排行程",
        "排出来"
      ]
    },
