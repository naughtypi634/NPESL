      "kind": "phrasal",
      "ipa": "ˈblɑk aʊt",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "空出（一段时间）",
      "senses": [
        {
          "zh": "在日程里留出整块时间",
          "en": "to reserve a period of time",
          "example": {
            "en": "Block out Sunday morning for the gym.",
            "zh": "周日早上留出来去健身。"
          }
        }
