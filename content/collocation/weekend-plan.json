      "kind": "phrasal",
      "ipa": "ˈmæp aʊt",
      "chip": "leisure",
      "register": "neutral",
      "separable": true,
      "zh": "规划出（路线、步骤）",
      "senses": [
        {
          "zh": "把整体路线画出来",
          "en": "to plan something in detail",
          "example": {
            "en": "She mapped out a weekend route with three stops.",
            "zh": "她规划了一条三个点的周末路线。"
