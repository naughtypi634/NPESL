{
  "theme": "doctor",
  "entries": [
    {
      "id": "pass-around",
      "head": "pass around",
      "base": "pass",
      "particle": "around",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈpæs əˈraʊnd",
      "chip": "doctor",
      "register": "neutral",
      "separable": true,
      "zh": "传染开",
      "senses": [
        {
          "zh": "在人群里传播",
          "en": "when an illness spreads among people",
          "example": {
            "en": "A stomach bug is passing around the office.",
            "zh": "办公室在传肠胃炎。"
          }
        }
      ],
      "l1_note": "传染开是 pass around；不是 pass to（传给一个）。",
      "confusables": [
        "go around",
        "spread"
      ],
      "collocations": [
        "a bug passing around",
        "pass it around"
      ],
      "collocations_zh": [
        "病毒在传",
        "传开"
      ]
    },
    {
      "id": "come-out-in",
      "head": "come out in",
      "base": "come",
      "particle": "out",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈkʌm aʊt ɪn",
      "chip": "doctor",
      "register": "neutral",
      "separable": false,
      "zh": "起（疹子）",
      "senses": [
        {
          "zh": "皮肤冒出东西",
          "en": "to get spots or a rash",
