      "senses": [
        {
          "zh": "肿或烧退下来",
          "en": "when swelling or fever decreases",
          "example": {
            "en": "The swelling went down after two days of ice.",
            "zh": "冰敷两天后肿消了。"
          }
        }
      ],
      "l1_note": "消下去是 go down；退烧是 bring down a fever。",
      "confusables": [
        "bring down",
        "die down"
