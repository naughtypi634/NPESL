{
  "theme": "directions",
  "entries": [
    {
      "id": "head-for",
      "head": "head for",
      "base": "head",
      "particle": "for",
      "kind": "phrasal",
      "ipa": "ˈhɛd fɔr",
      "tier": 1,
      "level": "B1",
      "chip": "transit",
      "register": "neutral",
      "separable": false,
      "zh": "朝……去、前往",
      "senses": [
        {
          "zh": "往某个方向走",
          "en": "to move toward a place",
          "example": {
            "en": "Let's head for the gate — boarding starts in ten minutes.",
            "zh": "我们去登机口吧，十分钟后开始登机。"
          }
        }
      ],
      "l1_note": "中文“去机场”直译成 go to the airport 没错，但口语里 head for 更像“出发往那边走”。",
      "confusables": [
        "head to",
        "leave for"
      ],
      "collocations": [
        "head for the exit",
        "head for home",
        "head downtown"
      ],
      "collocations_zh": [
        "朝出口走",
        "回家",
        "去市中心"
      ]
    },
    {
      "id": "end-up",
      "head": "end up",
      "base": "end",
      "particle": "up",
      "kind": "phrasal",
      "ipa": "ˈɛnd ʌp",
      "tier": 1,
      "level": "B1",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "最后落到、结果变成",
      "senses": [
        {
          "zh": "意外到了某处",
          "en": "to finally be in a place or situation you did not plan",
          "example": {
            "en": "We took the wrong exit and ended up in a parking lot.",
            "zh": "我们出错了口，最后开进了一个停车场。"
          }
        }
      ],
      "l1_note": "中文“结果”常被译成 as a result，口语里 end up 更自然，而且后面直接跟地点或 doing。",
      "confusables": [
        "turn out",
        "wind up"
      ],
      "collocations": [
        "end up doing something",
        "end up in the wrong place"
      ],
      "collocations_zh": [
        "最后做了某事",
        "最后走错地方"
      ]
    },
    {
      "id": "turn-around",
      "head": "turn around",
      "base": "turn",
      "particle": "around",
      "kind": "phrasal",
      "ipa": "ˈtɝn əˈraʊnd",
      "tier": 2,
      "level": "B1",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "车掉头；扭转（局面）；改变人生",
      "senses": [
        {
          "zh": "车掉头",
          "en": "to change direction and go the other way",
          "example": {
            "en": "You missed the turn — just turn around at the next light.",
            "zh": "你错过路口了，下个红绿灯掉头就行。"
          }
        },
        {
          "zh": "扭转局面",
          "en": "to make a failing business or plan succeed",
          "example": {
            "en": "The new manager turned the store around in six months.",
            "zh": "新经理半年就把门店扭亏为盈。"
          }
        },
        {
          "zh": "改变人生",
          "en": "to change someone's life completely",
          "example": {
            "en": "The scholarship turned his life around.",
            "zh": "那笔奖学金改变了他的人生。"
          }
        }
      ],
      "confusables": [
        "turn back",
        "turn over"
      ],
      "collocations": [
        "turn around the car",
        "turn things around"
      ],
      "l1_note": "掉头是 turn around；turn back 是折返不去了。",
      "collocations_zh": [
        "把车掉头",
        "扭转局面"
      ]
    },
    {
      "id": "turn-onto",
      "head": "turn onto",
      "base": "turn",
