        {
          "zh": "转进另一条街",
          "en": "to move onto a different road",
          "example": {
            "en": "Turn onto the side street after the bank and you'll see the gate.",
            "zh": "过了银行拐进小路就能看到大门。"
          }
        }
      ],
      "l1_note": "拐上某条路是 turn onto，不是 turn to（转向某人）。",
      "confusables": [
        "turn off",
        "turn into"
      ],
      "collocations": [
        "turn onto a side street",
        "turn onto the highway"
      ],
      "collocations_zh": [
        "拐进小路",
        "拐上高速"
      ]
    },
