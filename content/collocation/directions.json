      "l1_note": "抄近路穿过是 cut through，不是 cut across（横穿）。",
      "confusables": [
        "cut across",
        "go through"
      ],
      "collocations": [
        "cut through the park",
        "cut through the alley"
      ],
      "collocations_zh": [
        "穿过公园",
        "穿小巷"
      ]
    },
