          }
        }
      ],
      "l1_note": "veer off 是突然偏离，不是慢慢转（turn）。",
      "confusables": [
        "turn off",
        "go off"
      ],
      "collocations": [
        "veer off the road",
        "veer off course"
      ],
      "collocations_zh": [
        "偏离道路",
        "偏离路线"
      ]
    },
