        {
          "zh": "皮肤显得饱满有水分",
          "en": "when skin looks fuller and healthier",
          "example": {
            "en": "This serum plumps up fine lines around the eyes.",
            "zh": "这个精华能让眼周细纹饱满起来。"
          }
        }
      ],
      "l1_note": "plump up 也指把枕头拍松，语境不同。",
      "confusables": [
        "puff up",
        "firm up"
      ],
      "collocations": [
        "plump up the skin",
        "plump up fine lines"
      ],
      "collocations_zh": [
        "皮肤饱满",
        "填平细纹"
      ]
    },
