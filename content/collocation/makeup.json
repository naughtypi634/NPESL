          "example": {
            "en": "My eyes puffed up after I slept in my contacts.",
            "zh": "我戴着隐形睡了一觉，眼睛肿了。"
          }
        }
      ],
      "l1_note": "肿是 puff up / swell up，不是 become big。",
      "confusables": [
        "swell up",
        "flare up"
      ],
      "collocations": [
        "eyes puff up",
        "puff up in the morning"
      ],
      "collocations_zh": [
        "眼睛肿",
        "早上浮肿"
      ]
    },
    {
      "id": "swell-up",
      "head": "swell up",
      "base": "swell",
      "particle": "up",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈswɛl ʌp",
      "chip": "doctor",
      "register": "neutral",
      "separable": false,
      "zh": "肿起来（更明显）",
      "senses": [
        {
          "zh": "过敏或受伤后肿",
          "en": "to become larger because of injury or allergy",
          "example": {
            "en": "My lip swelled up after the new lip balm.",
            "zh": "用了新润唇膏，我嘴唇肿了。"
          }
        }
      ],
      "l1_note": "swell up 比 puff up 程度重，常跟过敏、受伤。",
      "confusables": [
        "puff up",
        "flare up"
      ],
      "collocations": [
        "swell up after a bite",
        "my face swelled up"
      ],
      "collocations_zh": [
        "被咬后肿",
        "脸肿了"
      ]
    },
