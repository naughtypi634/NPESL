{
  "theme": "makeup",
  "entries": [
    {
      "id": "touch-up",
      "head": "touch up",
      "base": "touch",
      "particle": "up",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈtʌtʃ ʌp",
      "chip": "social",
      "register": "spoken",
      "separable": true,
      "zh": "补妆、修一下",
      "senses": [
        {
          "zh": "妆花了补一点",
          "en": "to fix or add a little makeup",
          "example": {
            "en": "I need two minutes to touch up before the meeting.",
            "zh": "开会前给我两分钟补个妆。"
          }
        }
      ],
      "l1_note": "“补妆”不是 fix the makeup；touch up 也用于修照片、修细节。",
      "confusables": [
        "freshen up",
        "wipe off"
      ],
      "collocations": [
        "touch up your lipstick",
        "touch up in the bathroom"
      ],
      "collocations_zh": [
        "补口红",
        "在洗手间补妆"
      ]
    },
    {
      "id": "wipe-off",
      "head": "wipe off",
      "base": "wipe",
      "particle": "off",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈwaɪp ɔf",
      "chip": "home",
      "register": "spoken",
      "separable": true,
      "zh": "擦掉",
      "senses": [
        {
          "zh": "把妆或脏东西擦掉",
          "en": "to remove something by rubbing with a cloth",
          "example": {
            "en": "Wipe off that smudge under your eye before you go in.",
            "zh": "进去之前把眼睛下面那块擦掉。"
          }
        }
      ],
      "l1_note": "擦掉用 wipe off，不是 wipe out（那是消灭、累垮）。",
      "confusables": [
        "wash off",
        "clean off"
      ],
      "collocations": [
        "wipe off mascara",
        "wipe it off"
      ],
      "collocations_zh": [
        "擦掉睫毛膏",
        "擦掉"
      ]
    },
    {
      "id": "wash-off",
      "head": "wash off",
      "base": "wash",
      "particle": "off",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈwɑʃ ɔf",
      "chip": "home",
      "register": "neutral",
      "separable": true,
      "zh": "洗掉",
      "senses": [
        {
          "zh": "用水洗掉",
          "en": "to remove something with water",
          "example": {
            "en": "This cleanser washes off easily with warm water.",
            "zh": "这个洁面用温水一冲就掉。"
          }
        }
      ],
      "l1_note": "wash off 是洗掉表面；wash up 是洗手或洗碗（美式）。",
      "confusables": [
        "wipe off",
        "clean off"
      ],
      "collocations": [
        "wash off the mask",
        "wash it off"
      ],
      "collocations_zh": [
        "洗掉面膜",
        "洗掉"
      ]
    },
    {
      "id": "blend-in",
      "head": "blend in",
      "base": "blend",
      "particle": "in",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈblɛnd ɪn",
      "chip": "home",
      "register": "neutral",
      "separable": false,
      "zh": "晕开、融进去",
      "senses": [
        {
          "zh": "把眼影或修容边缘推开",
          "en": "to make makeup edges smooth so they are not visible",
          "example": {
            "en": "Blend in the eyeshadow with a clean brush.",
            "zh": "用干净刷子把眼影边缘晕开。"
          }
        }
      ],
      "l1_note": "blend in 也指“融入人群”，语境决定。",
      "confusables": [
        "smooth out",
        "work in"
      ],
      "collocations": [
        "blend in the edges",
        "blend it in"
      ],
      "collocations_zh": [
        "晕开边缘",
        "晕开"
      ]
    },
    {
      "id": "fill-in",
      "head": "fill in",
      "base": "fill",
      "particle": "in",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈfɪl ɪn",
      "chip": "home",
      "register": "neutral",
      "separable": true,
      "zh": "填补（眉毛、空隙）",
      "senses": [
        {
          "zh": "把眉毛的空缺画满",
          "en": "to add color to the gaps in your eyebrows",
          "example": {
            "en": "Fill in the ends of your brows — they look uneven.",
            "zh": "把眉毛尾部填一下，看着不对称。"
          }
        }
      ],
      "l1_note": "美式填表是 fill out；fill in 在这里是“填补空白”。",
      "confusables": [
        "fill out",
        "draw on"
      ],
      "collocations": [
        "fill in your brows",
        "fill in the gaps"
      ],
      "collocations_zh": [
        "填眉毛",
        "填补空隙"
      ]
    },
    {
      "id": "rub-in",
      "head": "rub in",
      "base": "rub",
      "particle": "in",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈrʌb ɪn",
      "chip": "home",
      "register": "spoken",
      "separable": true,
      "zh": "揉进去",
      "senses": [
        {
          "zh": "把护肤品揉到吸收",
          "en": "to rub a cream into your skin",
          "example": {
            "en": "Rub in the moisturizer while your face is still damp.",
            "zh": "趁脸还湿的时候把面霜揉进去。"
          }
        }
      ],
      "l1_note": "rub in 和 rub it in 还有一个习语义“反复揭人伤疤”，别误用。",
      "confusables": [
        "pat in",
        "work in"
      ],
      "collocations": [
        "rub in the cream",
        "rub it in"
      ],
      "collocations_zh": [
        "揉面霜",
        "揉进去"
      ]
    },
    {
      "id": "pat-in",
      "head": "pat in",
      "base": "pat",
      "particle": "in",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈpæt ɪn",
      "chip": "home",
      "register": "spoken",
      "separable": true,
      "zh": "轻拍进去",
      "senses": [
        {
          "zh": "用指腹轻拍帮助吸收",
          "en": "to press a product into the skin gently with your fingers",
          "example": {
            "en": "Pat in the eye cream — don't drag the skin.",
            "zh": "眼霜要轻拍进去，别拉扯皮肤。"
          }
        }
      ],
      "l1_note": "眼部护理动词是 pat，不是 rub（揉会拉扯）。",
      "confusables": [
        "rub in",
        "dab on"
      ],
      "collocations": [
        "pat in eye cream",
        "pat it in"
      ],
      "collocations_zh": [
        "轻拍眼霜",
        "拍进去"
      ]
    },
    {
      "id": "work-in",
      "head": "work in",
      "base": "work",
      "particle": "in",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈwɝrk ɪn",
      "chip": "home",
      "register": "neutral",
      "separable": true,
      "zh": "揉到吸收",
      "senses": [
        {
          "zh": "用手法把产品揉进皮肤",
          "en": "to massage a product into the skin",
          "example": {
            "en": "Work the serum in with small circles.",
            "zh": "用打小圈的方式把精华揉进去。"
          }
        }
      ],
      "l1_note": "work in 还有“挤时间安排”，看宾语。",
      "confusables": [
        "rub in",
        "blend in"
      ],
      "collocations": [
        "work in the serum",
        "work it in"
      ],
      "collocations_zh": [
        "揉精华",
        "揉进去"
      ]
    },
    {
      "id": "clean-off",
      "head": "clean off",
      "base": "clean",
      "particle": "off",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈklin ɔf",
      "chip": "home",
      "register": "spoken",
      "separable": true,
      "zh": "卸干净",
      "senses": [
        {
          "zh": "把妆彻底清掉",
          "en": "to remove makeup completely",
          "example": {
            "en": "Clean off your makeup before bed — no exceptions.",
            "zh": "睡前把妆卸干净，没有例外。"
          }
        }
      ],
      "l1_note": "卸妆不是 remove makeup 才自然；clean off 更口语。",
      "confusables": [
        "wash off",
        "wipe off"
      ],
      "collocations": [
        "clean off mascara",
        "clean it off"
      ],
      "collocations_zh": [
        "卸睫毛膏",
        "卸掉"
      ]
    },
    {
      "id": "freshen-up",
      "head": "freshen up",
      "base": "freshen",
      "particle": "up",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈfrɛʃən ʌp",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "补个妆、清爽一下",
      "senses": [
        {
          "zh": "洗把脸整理一下",
          "en": "to wash and tidy yourself up a little",
          "example": {
            "en": "I'll freshen up and meet you downstairs in ten.",
            "zh": "我补个妆，十分钟后楼下见。"
          }
        }
      ],
      "l1_note": "freshen up 是整体整理，不只是补妆。",
      "confusables": [
        "touch up",
        "clean off"
      ],
      "collocations": [
        "freshen up before dinner",
        "freshen up in the restroom"
      ],
      "collocations_zh": [
        "饭前补妆",
        "在洗手间整理"
      ]
    },
    {
      "id": "even-out",
      "head": "even out",
      "base": "even",
      "particle": "out",
      "kind": "phrasal",
      "freq": 4,
      "ipa": "ˈivən aʊt",
      "chip": "home",
      "register": "neutral",
      "separable": false,
      "zh": "变得均匀",
      "senses": [
        {
          "zh": "肤色或粉底变均匀",
          "en": "to become more regular or smooth",
          "example": {
            "en": "The redness evened out after a week of using the cream.",
            "zh": "用了一周那个霜，泛红均匀多了。"
          }
        }
      ],
      "l1_note": "“变均匀”不是 become even（也有点怪）；even out 强调过程。",
      "confusables": [
        "smooth out",
        "blend in"
      ],
      "collocations": [
        "skin tone evens out",
        "even out the base"
      ],
      "collocations_zh": [
        "肤色变均匀",
        "把底妆抹匀"
      ]
    },
    {
      "id": "plump-up",
      "head": "plump up",
      "base": "plump",
      "particle": "up",
      "kind": "phrasal",
      "freq": 3,
      "ipa": "ˈplʌmp ʌp",
      "chip": "home",
      "register": "neutral",
      "separable": false,
      "zh": "（皮肤）饱满起来",
