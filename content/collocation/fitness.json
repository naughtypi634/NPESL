{
  "theme": "fitness",
  "entries": [
    {
      "id": "shape-up",
      "head": "shape up",
      "base": "shape",
      "particle": "up",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈʃeɪp ʌp",
      "chip": "leisure",
      "register": "spoken",
      "separable": false,
      "zh": "练出样子、变结实",
      "senses": [
        {
          "zh": "身材或状态变好",
          "en": "to get fitter and healthier",
          "example": {
            "en": "He started running to shape up before the wedding.",
            "zh": "婚礼前他开始跑步练身材。"
          }
        }
      ],
      "l1_note": "变结实是 shape up；不是“塑形”直译 shape the body。",
      "confusables": [
        "tone up",
        "bulk up"
      ],
      "collocations": [
        "shape up for summer",
        "shape up a bit"
      ],
      "collocations_zh": [
        "为夏天练身材",
        "练一练"
      ]
    },
    {
