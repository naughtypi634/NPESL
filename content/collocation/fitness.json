      "head": "bulk up",
      "base": "bulk",
      "particle": "up",
      "kind": "phrasal",
      "freq": 5,
      "ipa": "ˈbʌlk ʌp",
      "chip": "leisure",
      "register": "spoken",
      "separable": false,
      "zh": "增肌、练壮",
