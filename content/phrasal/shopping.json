{
  "theme": "shopping",
  "entries": [
    {
      "id": "shell-out",
      "head": "shell out",
      "base": "shell",
      "particle": "out",
      "ipa": "ˈʃɛl aʊt",
      "tier": 3,
      "level": "B2",
      "chip": "shopping",
      "register": "spoken",
      "separable": true,
      "zh": "（不情愿地）掏一大笔钱",
      "senses": [
        {
          "zh": "被迫花大钱",
          "en": "to pay a lot of money, often unwillingly",
          "example": {
            "en": "I had to shell out 800 yuan for a new phone screen.",
            "zh": "换个手机屏我不得不掏了八百块。"
          }
        }
      ],
      "confusables": [
        "fork over",
        "spend"
      ],
      "collocations": [
        "shell out for a repair",
        "shell out a fortune"
      ],
      "l1_note": "不情愿掏大钱；shell out for 后面接东西。"
    },
    {
      "id": "rip-off",
      "head": "rip off",
      "base": "rip",
      "particle": "off",
      "ipa": "ˈrɪp ɔf",
      "tier": 1,
      "level": "B1",
      "chip": "shopping",
      "register": "spoken",
      "separable": true,
      "zh": "宰客、坑钱",
      "senses": [
        {
          "zh": "收不合理的价钱",
          "en": "to charge someone too much money",
          "example": {
            "en": "That taxi driver ripped me off — the meter was rigged.",
            "zh": "那个出租车司机宰了我，计价器被动过。"
          }
        }
      ],
      "l1_note": "“被坑”是 I got ripped off，不是 I was cheated money。",
      "confusables": [
        "scam",
        "overcharge"
      ],
      "collocations": [
        "rip off tourists",
        "get ripped off"
      ]
    },
    {
      "id": "throw-in",
      "head": "throw in",
      "base": "throw",
      "particle": "in",
      "ipa": "ˈθroʊ ɪn",
      "tier": 2,
      "level": "B1",
      "chip": "shopping",
      "register": "spoken",
      "separable": true,
      "zh": "附赠、加送",
      "senses": [
        {
          "zh": "买卖里额外送东西",
          "en": "to add something extra to a deal for free",
          "example": {
            "en": "The seller threw in a phone case and a charger.",
            "zh": "卖家额外送了手机壳和充电器。"
          }
        }
      ],
      "confusables": [
        "give away",
        "include"
      ],
      "collocations": [
        "throw in a free gift",
        "throw in delivery"
      ],
      "l1_note": "附赠；throw in 也有“插一句”的意思。"
    },
    {
      "id": "save-up",
      "head": "save up",
      "base": "save",
      "particle": "up",
      "ipa": "ˈseɪv ʌp",
      "tier": 1,
      "level": "A2",
      "chip": "errands",
      "register": "spoken",
      "separable": false,
      "zh": "攒钱",
      "senses": [
        {
          "zh": "一点点存钱",
          "en": "to keep money until you have enough for something",
          "example": {
            "en": "I'm saving up for a trip to Japan next spring.",
            "zh": "我在攒钱，明年春天去日本。"
          }
        }
      ],
      "l1_note": "“攒钱”是 save up (for)，不是 save money up 的顺序问题；save money 是省钱。",
      "confusables": [
        "save",
        "put aside"
      ],
      "collocations": [
        "save up for a car",
        "save up enough"
      ]
    },
    {
      "id": "cut-back",
      "head": "cut back",
      "base": "cut",
      "particle": "back",
      "ipa": "ˈkʌt bæk",
      "tier": 2,
      "level": "B1",
      "chip": "errands",
      "register": "neutral",
      "separable": false,
      "zh": "削减开支",
      "senses": [
        {
          "zh": "减少花销",
          "en": "to spend less money",
          "example": {
            "en": "We cut back after the rent went up.",
            "zh": "房租涨了之后我们开始省着花。"
          }
        }
      ],
      "confusables": [
        "cut down on",
        "cut out"
      ],
      "collocations": [
        "cut back on spending",
        "cut back on eating out"
      ],
      "l1_note": "削减开支；cut back on 后面接具体项。"
    },
    {
      "id": "settle-up",
      "head": "settle up",
      "base": "settle",
      "particle": "up",
      "ipa": "ˈsɛtəl ʌp",
      "tier": 3,
      "level": "B2",
      "chip": "dining",
      "register": "spoken",
      "separable": false,
      "zh": "把账结清",
      "senses": [
        {
          "zh": "把这顿饭或这趟账结掉",
          "en": "to pay what you owe, often at the end of a meal or trip",
          "example": {
            "en": "Let's settle up before we leave — I'll send you the split.",
            "zh": "走之前把账结了吧，我把分摊金额发你。"
          }
        }
      ],
      "confusables": [
        "pay up",
        "pay off"
      ],
      "collocations": [
        "settle up the bill",
        "settle up with friends"
      ],
      "l1_note": "结清账；settle 是解决、安顿。"
    },
    {
      "id": "chip-in",
      "head": "chip in",
      "base": "chip",
      "particle": "in",
      "ipa": "ˈtʃɪp ɪn",
      "tier": 2,
      "level": "B1",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "凑钱、AA 出一份",
      "senses": [
        {
          "zh": "大家一起出钱",
          "en": "when several people each pay part of a cost",
          "example": {
            "en": "We all chipped in for a gift for the boss.",
            "zh": "我们凑钱给老板买了个礼物。"
          }
        }
      ],
      "l1_note": "“AA”不是 AA in English；各付各的是 split the bill，一起凑钱是 chip in。",
      "confusables": [
        "split the bill",
        "pitch in"
      ],
      "collocations": [
        "chip in for a gift",
        "chip in ten yuan each"
      ]
    },
    {
      "id": "fork-over",
      "head": "fork over",
      "base": "fork",
      "particle": "over",
      "ipa": "ˈfɔrk ˈoʊvər",
      "tier": 3,
      "level": "B2",
      "chip": "errands",
      "register": "spoken",
      "separable": true,
      "zh": "（不情愿地）交出钱",
      "senses": [
        {
          "zh": "被迫付钱",
          "en": "to pay money unwillingly",
          "example": {
            "en": "He forked over 200 yuan for parking.",
            "zh": "他停车不情愿地掏了两百块。"
          }
        }
      ],
      "confusables": [
        "shell out",
        "hand over"
      ],
      "collocations": [
        "fork over the cash",
        "fork over a fee"
      ],
      "l1_note": "不情愿交钱，比 shell out 更口语。"
    },
    {
      "id": "pay-back",
      "head": "pay back",
      "base": "pay",
      "particle": "back",
      "ipa": "ˈpeɪ bæk",
      "tier": 1,
      "level": "A2",
      "chip": "errands",
      "register": "neutral",
      "separable": true,
      "zh": "还钱给某人",
      "senses": [
        {
          "zh": "把借的钱还给对方",
          "en": "to return money you borrowed",
          "example": {
            "en": "I'll pay you back as soon as I get my salary.",
            "zh": "我一发工资就还你。"
          }
        }
      ],
      "l1_note": "“还钱”不是 return money 才自然；pay someone back 更常用。代词夹中间：pay me back。",
      "confusables": [
        "pay off",
        "return"
      ],
      "collocations": [
        "pay back a loan",
        "pay someone back"
      ]
    },
    {
      "id": "put-down",
      "head": "put down",
      "base": "put",
      "particle": "down",
      "ipa": "ˈpʊt daʊn",
      "tier": 2,
      "level": "B1",
      "chip": "housing",
      "register": "neutral",
      "separable": true,
      "zh": "付定金；放下",
      "senses": [
        {
          "zh": "先付一笔定金",
          "en": "to pay part of the price now and the rest later",
          "example": {
            "en": "We put down a deposit on the apartment yesterday.",
            "zh": "我们昨天给公寓交了定金。"
          }
        }
      ],
      "confusables": [
        "pay off",
        "put away"
      ],
      "collocations": [
        "put down a deposit",
        "put down 20 percent"
      ],
      "l1_note": "付定金；put down 也指贬低、放下。"
    },
    {
      "id": "run-up",
      "head": "run up",
      "base": "run",
      "particle": "up",
      "ipa": "ˈrʌn ʌp",
      "tier": 3,
      "level": "B2",
      "chip": "errands",
      "register": "neutral",
      "separable": true,
      "zh": "欠下（账单、债务）",
      "senses": [
        {
          "zh": "累积出一笔欠款",
          "en": "to owe a lot of money because of things you bought",
          "example": {
            "en": "He ran up a huge bill on his credit card.",
            "zh": "他信用卡刷出了一大笔欠款。"
          }
        }
      ],
      "confusables": [
        "build up",
        "run out"
      ],
      "collocations": [
        "run up a bill",
        "run up debts"
      ],
      "l1_note": "欠下账单；run up against 是遇到困难。"
    },
    {
      "id": "shop-around",
      "head": "shop around",
      "base": "shop",
      "particle": "around",
      "ipa": "ˈʃɑp əˈraʊnd",
      "chip": "shopping",
      "register": "neutral",
      "separable": false,
      "zh": "货比三家",
      "senses": [
        {
          "zh": "多问几家再买",
          "en": "to compare prices in several places",
          "example": {
            "en": "Shop around before you buy — the same laptop is 800 cheaper online.",
            "zh": "买之前多比比，同款笔记本网上便宜八百。"
          }
        }
      ],
      "l1_note": "货比三家是 shop around，不是 compare shops（中式）。",
      "confusables": [
        "look around",
        "shop for"
      ],
      "collocations": [
        "shop around for a deal",
        "shop around first"
      ]
    },
    {
      "id": "pay-up",
      "head": "pay up",
      "base": "pay",
      "particle": "up",
      "ipa": "ˈpeɪ ʌp",
      "chip": "errands",
      "register": "spoken",
      "separable": false,
      "zh": "（不情愿地）付清",
      "senses": [
        {
          "zh": "被催着结清",
          "en": "to pay money you owe, often unwillingly",
          "example": {
            "en": "He finally paid up after three reminders.",
            "zh": "催了三次他才把钱付了。"
          }
        }
      ],
      "l1_note": "pay up 带“被催着”的意味；pay 是中性。",
      "confusables": [
        "settle up",
        "pay off"
      ],
      "collocations": [
        "pay up or leave",
        "pay up the balance"
      ]
    },
    {
      "id": "cough-up",
      "head": "cough up",
      "base": "cough",
      "particle": "up",
      "ipa": "ˈkɔf ʌp",
      "chip": "errands",
      "register": "spoken",
      "separable": true,
      "zh": "掏钱（不情愿）",
      "senses": [
        {
          "zh": "被迫拿出钱",
          "en": "to pay money reluctantly",
          "example": {
            "en": "The landlord finally coughed up for the broken heater.",
            "zh": "房东最后才掏钱修暖气。"
          }
        }
      ],
      "l1_note": "cough up 很口语，等于“挤出钱来”。",
      "confusables": [
        "fork over",
        "shell out"
      ],
      "collocations": [
        "cough up the cash",
        "cough it up"
      ]
    },
    {
      "id": "total-up",
      "head": "total up",
      "base": "total",
      "particle": "up",
      "ipa": "ˈtoʊtəl ʌp",
      "chip": "shopping",
      "register": "neutral",
      "separable": true,
      "zh": "合计",
      "senses": [
        {
          "zh": "把账算总",
          "en": "to add everything to get a final amount",
          "example": {
            "en": "Total up the receipt before you split it.",
            "zh": "分摊前先把小票合计一下。"
          }
        }
      ],
      "l1_note": "合计是 total up / add up，不是 count together（中式）。",
      "confusables": [
        "add up",
        "tally up"
      ],
      "collocations": [
        "total up the bill",
        "total it up"
      ]
    },
    {
      "id": "add-up-shopping",
      "head": "add up",
      "base": "add",
      "particle": "up",
      "ipa": "ˈæd ʌp",
      "chip": "shopping",
      "register": "neutral",
      "separable": false,
      "zh": "加起来",
      "senses": [
        {
          "zh": "金额累加",
          "en": "to calculate a total",
          "example": {
            "en": "The small purchases add up faster than you think.",
            "zh": "小钱加起来比你想象的快。"
          }
        }
      ],
      "l1_note": "add up 是加起来；说得通也是 add up。",
      "confusables": [
        "total up",
        "tot up"
      ],
      "collocations": [
        "the costs add up",
        "add it up"
      ]
    },
    {
      "id": "mark-down",
      "head": "mark down",
      "base": "mark",
      "particle": "down",
      "ipa": "ˈmɑrk daʊn",
      "chip": "shopping",
      "register": "neutral",
      "separable": true,
      "zh": "降价",
      "senses": [
        {
          "zh": "把标价调低",
          "en": "to lower the price of something",
          "example": {
            "en": "They marked down the winter coats after New Year.",
            "zh": "过完年他们把冬装降价了。"
          }
        }
      ],
      "l1_note": "降价是 mark down；mark up 是涨价。",
      "confusables": [
        "mark up",
        "knock off"
      ],
      "collocations": [
        "mark down the price",
        "marked down to 199"
      ]
    },
    {
      "id": "mark-up",
      "head": "mark up",
      "base": "mark",
      "particle": "up",
      "ipa": "ˈmɑrk ʌp",
      "chip": "shopping",
      "register": "neutral",
      "separable": true,
      "zh": "提价",
      "senses": [
        {
          "zh": "把标价调高",
          "en": "to raise the price",
          "example": {
            "en": "Some sellers mark up the price before a sale.",
            "zh": "有些卖家促销前先把价提上去。"
          }
        }
      ],
      "l1_note": "mark up 是提价；名词 markup 是加价幅度。",
      "confusables": [
        "mark down",
        "jack up"
      ],
      "collocations": [
        "mark up the price",
        "marked up by 30 percent"
      ]
    },
    {
      "id": "knock-off",
      "head": "knock off",
      "base": "knock",
      "particle": "off",
      "ipa": "ˈnɑk ɔf",
      "chip": "shopping",
      "register": "spoken",
      "separable": true,
      "zh": "减掉（零头）；下班",
      "senses": [
        {
          "zh": "便宜一点",
          "en": "to reduce a price",
          "example": {
            "en": "Can you knock off twenty if I take two?",
            "zh": "我买两个能便宜二十吗？"
          }
        }
      ],
      "l1_note": "knock off 也指收工、仿冒品（knockoff），看语境。",
      "confusables": [
        "mark down",
        "take off"
      ],
      "collocations": [
        "knock off a few yuan",
        "knock it off"
      ]
    },
    {
      "id": "sell-off",
      "head": "sell off",
      "base": "sell",
      "particle": "off",
      "ipa": "ˈsɛl ɔf",
      "chip": "shopping",
      "register": "neutral",
      "separable": true,
      "zh": "清仓甩卖",
      "senses": [
        {
          "zh": "低价清掉库存",
          "en": "to sell goods cheaply to get rid of them",
          "example": {
            "en": "The store is selling off last season's stock.",
            "zh": "店里在清上一季的货。"
          }
        }
      ],
      "l1_note": "清仓是 sell off；卖光是 sell out，出卖也是 sell out。",
      "confusables": [
        "sell out",
        "clear out"
      ],
      "collocations": [
        "sell off old stock",
        "sell it off"
      ]
    },
    {
      "id": "stock-up",
      "head": "stock up",
      "base": "stock",
      "particle": "up",
      "ipa": "ˈstɑk ʌp",
      "chip": "shopping",
      "register": "spoken",
      "separable": false,
      "zh": "囤货",
      "senses": [
        {
          "zh": "趁便宜多买点",
          "en": "to buy a lot of something for later",
          "example": {
            "en": "Stock up on noodles before the holiday.",
            "zh": "节前多囤点面。"
          }
        }
      ],
      "l1_note": "囤货是 stock up (on)，不是 store up（也可但少）。",
      "confusables": [
        "save up",
        "pile up"
      ],
      "collocations": [
        "stock up on snacks",
        "stock up for winter"
      ]
    },
    {
      "id": "take-back",
      "head": "take back",
      "base": "take",
      "particle": "back",
      "ipa": "ˈteɪk bæk",
      "chip": "shopping",
      "register": "neutral",
      "separable": true,
      "zh": "退货；收回（话）",
      "senses": [
        {
          "zh": "把买的东西退回去",
          "en": "to return something you bought",
          "example": {
            "en": "Can I take back this shirt without the receipt?",
            "zh": "这件衬衫没小票能退吗？"
          }
        }
      ],
      "l1_note": "退货是 take back；退款是 get a refund。",
      "confusables": [
        "send back",
        "bring back"
      ],
      "collocations": [
        "take back a purchase",
        "take it back"
      ]
    },
    {
      "id": "send-back",
      "head": "send back",
      "base": "send",
      "particle": "back",
      "ipa": "ˈsɛnd bæk",
      "chip": "shopping",
      "register": "neutral",
      "separable": true,
      "zh": "寄回、退回",
      "senses": [
        {
          "zh": "把东西寄回去",
          "en": "to return something by mail",
          "example": {
            "en": "I sent back the wrong size and they refunded me.",
            "zh": "我把尺码不对的寄回去了，他们退了款。"
          }
        }
      ],
      "l1_note": "寄回是 send back；send off 是寄出。",
      "confusables": [
        "take back",
        "return"
      ],
      "collocations": [
        "send back an order",
        "send it back"
      ]
    },
    {
      "id": "bring-back",
      "head": "bring back",
      "base": "bring",
      "particle": "back",
      "ipa": "ˈbrɪŋ bæk",
      "chip": "shopping",
      "register": "neutral",
      "separable": true,
      "zh": "带回；（东西）带回来",
      "senses": [
        {
          "zh": "买回来或带回来",
          "en": "to return with something",
          "example": {
            "en": "Bring back a receipt in case it doesn't fit.",
            "zh": "把小票带回来，万一不合身。"
          }
        }
      ],
      "l1_note": "带回是 bring back；带回记忆也是 bring back。",
      "confusables": [
        "take back",
        "bring along"
      ],
      "collocations": [
        "bring back souvenirs",
        "bring it back"
      ]
    },
    {
      "id": "try-out",
      "head": "try out",
      "base": "try",
      "particle": "out",
      "ipa": "ˈtraɪ aʊt",
      "chip": "shopping",
      "register": "spoken",
      "separable": true,
      "zh": "试用",
      "senses": [
        {
          "zh": "试一段时间看合不合适",
          "en": "to test something before deciding",
          "example": {
            "en": "You can try out the app for a week for free.",
            "zh": "这个 App 可以免费试用一周。"
          }
        }
      ],
      "l1_note": "试用是 try out；试穿是 try on，别混。",
      "confusables": [
        "try on",
        "test out"
      ],
      "collocations": [
        "try out a new product",
        "try it out"
      ]
    },
    {
      "id": "put-aside",
      "head": "put aside",
      "base": "put",
      "particle": "aside",
      "ipa": "ˈpʊt əˈsaɪd",
      "chip": "errands",
      "register": "neutral",
      "separable": true,
      "zh": "存下（钱）",
      "senses": [
        {
          "zh": "专门留一笔钱",
          "en": "to save money for later",
          "example": {
            "en": "She puts aside 500 a month for travel.",
            "zh": "她每月存五百块旅行基金。"
