      "register": "neutral",
      "separable": true,
      "zh": "把表面擦一遍",
      "senses": [
        {
          "zh": "用湿布擦整个面",
          "en": "to clean a surface with a cloth",
          "example": {
            "en": "Wipe down the counters after cooking.",
            "zh": "做完饭把台面擦一遍。"
          }
        }
      ],
      "l1_note": "擦一遍是 wipe down；wipe off 是擦掉某块污渍。",
      "confusables": [
        "wipe up",
        "wipe off"
      ],
      "collocations": [
        "wipe down the table",
        "wipe it down"
      ]
    },
