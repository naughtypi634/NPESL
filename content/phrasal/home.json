          "example": {
            "en": "Mop up the water before someone slips.",
            "zh": "把水拖了，别让人滑倒。"
          }
        }
      ],
      "l1_note": "拖干净是 mop up；mop 单独是拖地。",
      "confusables": [
        "wipe up",
        "sweep up"
      ],
      "collocations": [
        "mop up a spill",
        "mop it up"
      ]
    },
