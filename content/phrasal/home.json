{
  "theme": "home",
  "entries": [
    {
      "id": "move-in",
      "head": "move in",
      "base": "move",
      "particle": "in",
      "ipa": "ˈmuv ɪn",
      "tier": 1,
      "level": "A2",
      "chip": "housing",
      "register": "neutral",
      "separable": false,
      "zh": "搬进来、入住",
      "senses": [
        {
          "zh": "搬进新住处",
          "en": "to start living in a new place",
          "example": {
            "en": "We move in on Saturday, so I need boxes by Friday.",
            "zh": "我们周六搬进去，所以周五前得弄到纸箱。"
          }
        }
      ],
      "l1_note": "搬进/搬出是 move in / move out，不是 move to in。中文“搬”一个字，英语要分方向。",
      "confusables": [
        "move out",
        "move on"
      ],
      "collocations": [
        "move in together",
        "move-in day",
        "move into a new apartment"
      ]
    },
    {
      "id": "move-out",
      "head": "move out",
      "base": "move",
      "particle": "out",
      "ipa": "ˈmuv aʊt",
      "tier": 1,
      "level": "A2",
      "chip": "housing",
      "register": "neutral",
      "separable": false,
      "zh": "搬走、搬出去",
      "senses": [
        {
          "zh": "搬离原住处",
          "en": "to leave the place where you live",
          "example": {
            "en": "My roommate is moving out at the end of the month.",
            "zh": "我室友月底搬走。"
          }
        }
      ],
      "l1_note": "退租搬走 move out；只是出门是 go out。两个 out 意思完全不同。",
      "confusables": [
        "move in",
        "get out"
      ],
      "collocations": [
        "move out of the apartment",
        "move out early"
      ]
    },
    {
      "id": "settle-in",
      "head": "settle in",
      "base": "settle",
      "particle": "in",
      "ipa": "ˈsɛtəl ɪn",
      "tier": 2,
      "level": "B1",
      "chip": "housing",
      "register": "neutral",
      "separable": false,
      "zh": "安顿下来、适应新环境",
      "senses": [
        {
          "zh": "适应新住处或新工作",
          "en": "to get used to a new place or situation",
          "example": {
            "en": "It took me a month to settle in at the new office.",
            "zh": "我在新办公室花了一个月才适应。"
          }
        }
      ],
      "confusables": [
        "settle down",
        "move in"
      ],
      "collocations": [
        "settle in quickly",
        "help someone settle in"
      ],
      "l1_note": "适应新环境；settle down 是安定下来或安静。"
    },
    {
      "id": "put-away",
      "head": "put away",
      "base": "put",
      "particle": "away",
      "ipa": "ˈpʊt əˈweɪ",
      "tier": 1,
      "level": "A2",
      "chip": "home",
      "register": "spoken",
      "separable": true,
      "zh": "收好、放回原处",
      "senses": [
        {
          "zh": "把东西放回该放的地方",
          "en": "to put something back where it belongs",
          "example": {
            "en": "Put away the dishes before your mom gets home.",
            "zh": "你妈回来之前把碗收好。"
          }
        }
      ],
      "l1_note": "中文“收拾”既可以是收好也可以是扔掉，英语要分开：put away 收好，throw away 扔掉。",
      "confusables": [
        "throw away",
        "clear out"
      ],
      "collocations": [
        "put away the groceries",
        "put your phone away"
      ]
    },
    {
      "id": "throw-away",
      "head": "throw away",
      "base": "throw",
      "particle": "away",
      "ipa": "ˈθroʊ əˈweɪ",
      "tier": 1,
      "level": "A2",
      "chip": "home",
      "register": "spoken",
      "separable": true,
      "zh": "扔掉",
      "senses": [
        {
          "zh": "当垃圾丢掉",
          "en": "to get rid of something you do not want",
          "example": {
            "en": "Don't throw away the receipt — I might need to return this.",
            "zh": "别扔小票，我可能要退货。"
          }
        }
      ],
      "l1_note": "乱扔垃圾不是 throw rubbish（中式），是 throw it away 或 litter。代词放中间：throw it away。",
      "confusables": [
        "throw out",
        "put away"
      ],
      "collocations": [
        "throw away the packaging",
        "throw away money"
      ]
    },
    {
      "id": "clear-out",
      "head": "clear out",
      "base": "clear",
      "particle": "out",
      "ipa": "ˈklɪr aʊt",
      "tier": 2,
      "level": "B1",
      "chip": "home",
      "register": "spoken",
      "separable": true,
      "zh": "清空、彻底整理掉",
      "senses": [
        {
          "zh": "把一个空间清空",
          "en": "to empty a place and remove everything in it",
          "example": {
            "en": "We cleared out the storage room and found three old fans.",
            "zh": "我们清空了储物间，翻出三台旧风扇。"
          }
        }
      ],
      "confusables": [
        "clean out",
        "throw away"
      ],
      "collocations": [
        "clear out the closet",
        "clear out the garage"
      ],
      "l1_note": "清空一个空间；clear up 是放晴、澄清。"
    },
    {
      "id": "sort-through",
      "head": "sort through",
      "base": "sort",
      "particle": "through",
      "ipa": "ˈsɔrt θru",
      "tier": 2,
      "level": "B1",
      "chip": "home",
      "register": "neutral",
      "separable": false,
      "zh": "翻一遍、逐件整理",
      "senses": [
        {
          "zh": "在一堆东西里翻找整理",
          "en": "to look through a pile of things and organize them",
          "example": {
            "en": "I spent Sunday sorting through two years of mail.",
            "zh": "我周日花了一整天整理两年的信件。"
          }
        }
      ],
      "confusables": [
        "look through",
        "clear out"
      ],
      "collocations": [
        "sort through the boxes",
        "sort through old photos"
      ],
      "l1_note": "翻拣整理；sort out 是解决问题。"
    },
    {
      "id": "take-out",
      "head": "take out",
      "base": "take",
      "particle": "out",
      "ipa": "ˈteɪk aʊt",
      "tier": 1,
      "level": "A2",
      "chip": "home",
      "register": "spoken",
      "separable": true,
      "zh": "拿出去（垃圾）；点外卖；取出",
      "senses": [
        {
          "zh": "把垃圾拿出去",
          "en": "to carry something outside, especially trash",
          "example": {
            "en": "Can you take out the trash on your way down?",
            "zh": "你下楼的时候顺便把垃圾带下去好吗？"
          }
        },
        {
          "zh": "点外卖",
          "en": "to buy food from a restaurant and eat it elsewhere",
          "example": {
            "en": "Let's just take out some noodles tonight.",
            "zh": "今晚就点个外卖面吧。"
          }
        }
      ],
      "l1_note": "“外卖”不是 outside food 或 send food；美式说 takeout / to go。动词是 take out 或 order in。",
      "confusables": [
        "eat out",
        "order in"
      ],
      "collocations": [
        "take out the trash",
        "takeout food",
        "take out a loan"
      ]
    },
    {
      "id": "break-down",
      "head": "break down",
      "base": "break",
      "particle": "down",
      "ipa": "ˈbreɪk daʊn",
      "tier": 1,
      "level": "B1",
      "chip": "home",
      "register": "neutral",
      "separable": false,
      "zh": "（机器）坏掉；情绪崩溃",
      "senses": [
        {
          "zh": "电器或车出故障",
          "en": "to stop working",
          "example": {
            "en": "The washing machine broke down again — third time this year.",
            "zh": "洗衣机又坏了，今年第三次。"
          }
        },
        {
          "zh": "情绪崩溃",
          "en": "to lose control of your feelings",
          "example": {
            "en": "She broke down when she heard the news.",
            "zh": "她听到消息就崩溃了。"
          }
        }
      ],
      "l1_note": "机器坏不是 be broken 才地道，口语更常说 it broke down。",
      "confusables": [
        "give out",
        "break up"
      ],
      "collocations": [
        "the car broke down",
        "break down in tears"
      ]
    },
    {
      "id": "fix-up",
      "head": "fix up",
      "base": "fix",
      "particle": "up",
      "ipa": "ˈfɪks ʌp",
      "tier": 2,
      "level": "B1",
      "chip": "home",
      "register": "spoken",
      "separable": true,
      "zh": "修整、收拾好",
      "senses": [
        {
          "zh": "把旧东西修整好",
          "en": "to repair or improve something old",
          "example": {
            "en": "We fixed up the spare room before my parents visited.",
            "zh": "我爸妈来之前我们把空房间收拾出来了。"
          }
        }
      ],
      "confusables": [
        "fix",
        "do up"
      ],
      "collocations": [
        "fix up the apartment",
        "fix up an old bike"
      ],
      "l1_note": "修整旧东西；fix up 也有“安排见面”。"
    },
    {
      "id": "put-together",
      "head": "put together",
      "base": "put",
      "particle": "together",
      "ipa": "ˈpʊt təˈɡɛðər",
      "tier": 1,
      "level": "A2",
      "chip": "home",
      "register": "neutral",
      "separable": true,
      "zh": "组装；凑齐",
      "senses": [
        {
          "zh": "把零件组装起来",
          "en": "to assemble something from parts",
          "example": {
            "en": "It took us three hours to put together the bookshelf.",
            "zh": "我们花了三个小时才把书架装好。"
          }
        }
      ],
      "l1_note": "组装家具是 put together / assemble，不是 make up（那是编造）。",
      "confusables": [
        "take apart",
        "set up"
      ],
      "collocations": [
        "put together a desk",
        "put together a plan"
      ]
    },
    {
      "id": "take-apart",
      "head": "take apart",
      "base": "take",
      "particle": "apart",
      "ipa": "ˈteɪk əˈpɑrt",
      "tier": 2,
      "level": "B1",
      "chip": "home",
      "register": "neutral",
      "separable": true,
      "zh": "拆开",
      "senses": [
        {
          "zh": "把东西拆成零件",
          "en": "to separate something into its parts",
          "example": {
            "en": "He took apart the remote to clean the buttons.",
            "zh": "他把遥控器拆开清理按键。"
          }
        }
      ],
      "confusables": [
        "put together",
        "break down"
      ],
      "collocations": [
        "take apart the machine",
        "take it apart"
      ],
      "l1_note": "拆开；take apart 也指严厉批评。"
    },
    {
      "id": "lock-up",
      "head": "lock up",
      "base": "lock",
      "particle": "up",
      "ipa": "ˈlɑk ʌp",
      "tier": 2,
      "level": "B1",
      "chip": "home",
      "register": "neutral",
      "separable": false,
      "zh": "锁好门窗",
      "senses": [
        {
          "zh": "出门前锁好",
          "en": "to lock all the doors and windows",
          "example": {
            "en": "Last one out, please lock up — the back door sticks.",
            "zh": "最后走的人记得锁门，后门有点卡。"
          }
        }
      ],
      "confusables": [
        "shut down",
        "close up"
      ],
      "collocations": [
        "lock up the office",
        "lock up at night"
      ],
      "l1_note": "锁好门窗；lock up 也指关进监狱。"
    },
    {
      "id": "knock-over",
      "head": "knock over",
      "base": "knock",
      "particle": "over",
      "ipa": "ˈnɑk ˈoʊvər",
      "tier": 1,
      "level": "A2",
      "chip": "home",
      "register": "spoken",
      "separable": true,
      "zh": "碰倒、打翻",
      "senses": [
        {
          "zh": "不小心碰倒东西",
          "en": "to hit something so that it falls",
          "example": {
            "en": "I knocked over my coffee reaching for the charger.",
            "zh": "我伸手拿充电器时把咖啡碰洒了。"
          }
        }
      ],
      "l1_note": "“打翻”不能说 hit over；knock over 是碰到倒下，spill 是液体洒出来。",
      "confusables": [
        "spill",
        "turn over"
      ],
      "collocations": [
        "knock over a glass",
        "knock it over"
      ]
    },
    {
      "id": "spill-over",
      "head": "spill over",
      "base": "spill",
      "particle": "over",
      "ipa": "ˈspɪl ˈoʊvər",
      "tier": 3,
      "level": "B1",
      "chip": "home",
      "register": "neutral",
      "separable": false,
      "zh": "溢出；（矛盾）蔓延到别处",
      "senses": [
        {
          "zh": "液体溢出容器",
          "en": "to flow over the edge of a container",
          "example": {
            "en": "The soup spilled over and made a mess of the stove.",
            "zh": "汤溢出来，把灶台弄得一塌糊涂。"
          }
        }
      ],
      "confusables": [
        "boil over",
        "knock over"
      ],
      "collocations": [
        "spill over the edge",
        "spill over into"
      ],
      "l1_note": "溢出或情绪蔓延；spill 是洒出来。"
    },
    {
      "id": "give-out-on",
      "head": "give out on",
      "base": "give",
      "particle": "out",
      "ipa": "ˈɡɪv aʊt ɑn",
      "tier": 3,
      "level": "B1",
      "chip": "home",
      "register": "spoken",
      "separable": false,
      "zh": "（机器、身体）罢工、撑不住了",
      "senses": [
        {
          "zh": "东西在人用的时候坏掉",
          "en": "when a machine or part of your body stops working",
          "example": {
            "en": "My laptop gave out on me right before the deadline.",
            "zh": "我的笔记本在截止前一刻罢工了。"
          }
        }
      ],
      "confusables": [
        "break down",
        "run out"
      ],
      "collocations": [
        "give out on someone",
        "my knees gave out"
      ],
      "l1_note": "东西在人用时掉链子；give out 是分发、耗尽。"
    },
    {
      "id": "hang-up",
      "head": "hang up",
      "base": "hang",
      "particle": "up",
      "ipa": "ˈhæŋ ʌp",
      "tier": 1,
      "level": "A2",
      "chip": "home",
      "register": "neutral",
      "separable": true,
      "zh": "挂起来；挂电话",
      "senses": [
        {
          "zh": "把衣服挂起来",
          "en": "to put clothes on a hanger or hook",
          "example": {
            "en": "Hang up your coat before it gets wrinkled.",
            "zh": "把外套挂起来，别弄皱了。"
          }
        },
        {
          "zh": "挂断电话",
          "en": "to end a phone call",
          "example": {
            "en": "Don't hang up yet — I'm looking for the address.",
            "zh": "先别挂，我在找地址。"
          }
        }
      ],
      "l1_note": "挂电话是 hang up，不是 close the phone（中式）。",
      "confusables": [
        "hang out",
        "hang on"
      ],
      "collocations": [
        "hang up the phone",
        "hang up your jacket"
      ]
    },
    {
      "id": "get-rid-of",
      "head": "get rid of",
      "base": "get",
      "particle": "of",
      "ipa": "ˈɡɛt rɪd əv",
      "tier": 1,
      "level": "B1",
      "chip": "home",
      "register": "spoken",
      "separable": false,
      "zh": "处理掉、摆脱",
      "senses": [
        {
          "zh": "把不想要的东西清掉",
          "en": "to remove something you do not want",
          "example": {
            "en": "We got rid of the old sofa before the move.",
            "zh": "搬家前我们把旧沙发处理掉了。"
          }
        }
      ],
      "l1_note": "“处理掉”不是 deal with（那是处理问题）；扔东西是 get rid of。",
      "confusables": [
        "throw away",
        "clear out"
      ],
      "collocations": [
        "get rid of clutter",
        "get rid of a habit"
      ]
    },
    {
      "id": "clean-up",
      "head": "clean up",
      "base": "clean",
      "particle": "up",
      "ipa": "ˈklin ʌp",
      "chip": "home",
      "register": "neutral",
      "separable": true,
      "zh": "打扫干净",
      "senses": [
        {
          "zh": "把脏乱收拾好",
          "en": "to make a place clean",
          "example": {
            "en": "Clean up the kitchen before the delivery guy comes.",
            "zh": "外卖小哥来之前把厨房收拾干净。"
          }
        }
      ],
      "l1_note": "打扫是 clean up；clean 单独是擦某个东西。",
      "confusables": [
        "tidy up",
        "clear out"
      ],
      "collocations": [
        "clean up the kitchen",
        "clean it up"
      ]
    },
    {
      "id": "tidy-up",
      "head": "tidy up",
      "base": "tidy",
      "particle": "up",
      "ipa": "ˈtaɪdi ʌp",
      "chip": "home",
      "register": "spoken",
      "separable": true,
      "zh": "收拾整齐",
      "senses": [
        {
          "zh": "把东西归位",
          "en": "to put things back in order",
          "example": {
            "en": "Tidy up your desk before you leave.",
            "zh": "走之前把桌子收拾整齐。"
          }
        }
      ],
      "l1_note": "收拾整齐是 tidy up；美式也常说 straighten up。",
      "confusables": [
        "clean up",
        "put away"
      ],
      "collocations": [
        "tidy up the room",
        "tidy it up"
      ]
    },
