            "zh": "趁蚂蚁没来把渣扫了。"
          }
        }
      ],
      "l1_note": "扫起来是 sweep up；sweep 单独是扫。",
      "confusables": [
        "mop up",
        "clean up"
      ],
      "collocations": [
        "sweep up the mess",
        "sweep it up"
      ]
    },
    {
      "id": "mop-up",
      "head": "mop up",
      "base": "mop",
      "particle": "up",
      "ipa": "ˈmɑp ʌp",
      "chip": "home",
      "register": "neutral",
      "separable": true,
      "zh": "拖干净",
      "senses": [
        {
          "zh": "把洒的水拖掉",
