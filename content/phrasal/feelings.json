      "senses": [
        {
          "zh": "随便放松一下",
          "example": {
            "en": "We just chilled out at home all weekend.",
            "zh": "整个周末我们就在家放松。"
          }
        }
      ],
      "l1_note": "“放松”不是 relax yourself（怪）；chill out / take it easy 更口语。",
      "collocations": [
        "chill out at home",
        "chill out with friends"
      ],
      "confusables": [
        "wind down",
        "hang out"
      ]
    },
    {
      "id": "stress-out",
      "head": "stress out",
      "base": "stress",
      "particle": "out",
      "ipa": "ˈstrɛs aʊt",
      "chip": "office",
      "register": "spoken",
      "separable": true,
      "zh": "压力大到崩溃",
      "senses": [
        {
          "zh": "被事情压得焦虑",
          "example": {
            "en": "I'm stressed out about the presentation on Monday.",
            "zh": "周一那个汇报让我压力很大。"
          }
        }
      ],
      "l1_note": "“我有压力”不是 I have pressure；是 I'm stressed out / under a lot of pressure。",
      "collocations": [
        "stress out about work",
        "stress someone out"
      ],
      "confusables": [
        "freak out",
        "burn out"
      ]
    },
    {
      "id": "blow-up",
      "head": "blow up",
      "base": "blow",
      "particle": "up",
      "ipa": "ˈbloʊ ʌp",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "发火；爆炸",
      "senses": [
        {
          "zh": "突然发火",
          "example": {
            "en": "He blew up when he saw the bill.",
            "zh": "他看到账单就炸了。"
          }
        }
      ],
      "collocations": [
        "blow up at someone",
        "blow up over nothing"
      ],
      "confusables": [
        "blow off",
        "freak out"
      ],
      "l1_note": "发火是 blow up (at)；blow up 也指爆炸、放大照片。"
    },
    {
      "id": "tone-down",
      "head": "tone down",
