{
  "theme": "feelings",
  "entries": [
    {
      "id": "calm-down",
      "head": "calm down",
      "base": "calm",
      "particle": "down",
      "ipa": "ˈkɑm daʊn",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "冷静下来",
      "senses": [
        {
          "zh": "从激动或生气里平复",
          "example": {
            "en": "Calm down — we can still fix this before Friday.",
            "zh": "冷静点，周五前我们还来得及补救。"
          }
        }
      ],
      "l1_note": "“冷静”对别人说 calm down，对自己说 take a breath；中文一句“冷静”，英语分对象。",
      "collocations": [
        "calm down a bit",
        "calm someone down"
      ],
      "confusables": [
        "chill out",
        "wind down"
      ]
    },
    {
      "id": "freak-out",
      "head": "freak out",
      "base": "freak",
      "particle": "out",
      "ipa": "ˈfrik aʊt",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "抓狂、吓坏",
      "senses": [
        {
          "zh": "情绪突然失控",
          "example": {
            "en": "I freaked out when I saw the deadline was today.",
            "zh": "看到截止日期是今天，我直接抓狂了。"
          }
        }
      ],
      "l1_note": "“我慌了”不是 I am panic；口语是 I freaked out。",
      "collocations": [
        "freak out about a test",
        "freak someone out"
      ],
      "confusables": [
        "stress out",
        "panic"
      ]
    },
    {
      "id": "fall-apart",
      "head": "fall apart",
      "base": "fall",
      "particle": "apart",
      "ipa": "ˈfɔl əˈpɑrt",
      "chip": "social",
      "register": "neutral",
      "separable": false,
      "zh": "崩溃、散架",
      "senses": [
        {
          "zh": "情绪或计划垮掉",
          "example": {
            "en": "Everything fell apart the week my dad got sick.",
            "zh": "我爸生病那一周，所有事都垮了。"
          }
        }
      ],
      "collocations": [
        "fall apart under pressure",
        "the plan fell apart"
      ],
      "confusables": [
        "break down",
        "come apart"
      ],
      "l1_note": "“垮掉”不只用 break down；fall apart 指整体崩掉，人和计划都行。"
    },
    {
