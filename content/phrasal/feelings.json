      "ipa": "ˈtʃɪr ʌp",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "振作起来；让……开心",
      "senses": [
        {
          "zh": "从低落里振作",
          "example": {
            "en": "Cheer up — the interview went better than you think.",
            "zh": "振作点，面试比你想象的好。"
          }
        }
      ],
      "l1_note": "“开心一点”不是 be happy一点；口语劝人是 cheer up。",
      "collocations": [
        "cheer up a friend",
        "cheer someone up"
      ],
      "confusables": [
        "light up",
        "calm down"
      ]
    },
    {
      "id": "wind-down",
      "head": "wind down",
      "base": "wind",
      "particle": "down",
      "ipa": "ˈwaɪnd daʊn",
      "chip": "leisure",
      "register": "neutral",
      "separable": false,
