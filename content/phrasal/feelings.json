      "register": "neutral",
      "separable": true,
      "zh": "把话说软一点",
      "senses": [
        {
          "zh": "缓和语气或强度",
          "example": {
            "en": "You might want to tone down that email before you send it.",
            "zh": "那封邮件发之前你也许该把话放软点。"
          }
        }
      ],
      "collocations": [
        "tone down the criticism",
        "tone down your language"
      ],
      "confusables": [
        "calm down",
        "soften"
      ],
      "l1_note": "把话放软；不是 make the tone low（中式）。"
    },
    {
      "id": "get-down",
      "head": "get down",
      "base": "get",
      "particle": "down",
      "ipa": "ˈɡɛt daʊn",
