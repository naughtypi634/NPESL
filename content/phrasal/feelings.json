      ],
      "l1_note": "“放下”不是 put down（那是把东西放下）；情绪上的放下是 let go of。",
      "collocations": [
        "let go of the past",
        "let go of a grudge"
      ],
      "confusables": [
        "put down",
        "move on"
      ]
    },
    {
