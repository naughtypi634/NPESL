      "base": "whip",
      "particle": "up",
      "ipa": "ˈwɪp ʌp",
      "tier": 2,
      "level": "B1",
      "chip": "dining",
      "register": "spoken",
      "separable": true,
      "zh": "快手做（一顿饭）",
      "senses": [
        {
          "zh": "很快地做出一顿饭",
          "en": "to make a meal quickly with what you have",
          "example": {
            "en": "I can whip up some fried rice in ten minutes.",
            "zh": "我十分钟能炒个饭。"
          }
        }
      ],
      "confusables": [
        "throw together",
        "cook up"
      ],
      "collocations": [
        "whip up dinner",
        "whip up a quick lunch"
      ],
      "l1_note": "快手做饭用 whip up，不是 cook fast 才自然。"
    },
    {
      "id": "warm-up",
