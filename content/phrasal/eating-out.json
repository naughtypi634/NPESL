{
  "theme": "eating-out",
  "entries": [
    {
      "id": "eat-out",
      "head": "eat out",
      "base": "eat",
      "particle": "out",
      "ipa": "ˈit aʊt",
      "tier": 1,
      "level": "A2",
      "chip": "dining",
      "register": "spoken",
      "separable": false,
      "zh": "下馆子、在外面吃",
      "senses": [
        {
          "zh": "去餐厅吃饭",
          "en": "to eat at a restaurant instead of at home",
          "example": {
            "en": "We eat out maybe twice a month — it adds up fast.",
            "zh": "我们一个月大概下两次馆子，钱涨得很快。"
          }
        }
      ],
      "l1_note": "“出去吃”不是 go out to eat 才地道；eat out 两个词就够，而且不带宾语。",
      "confusables": [
        "take out",
        "order in"
      ],
      "collocations": [
        "eat out for dinner",
        "eat out on the weekend"
      ]
    },
    {
      "id": "order-in",
      "head": "order in",
      "base": "order",
      "particle": "in",
      "ipa": "ˈɔrdər ɪn",
      "tier": 2,
      "level": "B1",
      "chip": "dining",
      "register": "spoken",
      "separable": false,
      "zh": "点外卖送到家",
      "senses": [
        {
          "zh": "叫外卖",
          "en": "to have food delivered to your home",
          "example": {
            "en": "It's pouring — let's order in tonight.",
            "zh": "下大雨了，今晚点外卖吧。"
          }
        }
      ],
      "confusables": [
        "take out",
        "eat out"
      ],
      "collocations": [
        "order in pizza",
        "order in for the whole team"
      ],
      "l1_note": "点外卖送到家是 order in；takeout 是名词。"
    },
    {
      "id": "pick-at",
      "head": "pick at",
      "base": "pick",
      "particle": "at",
      "ipa": "ˈpɪk æt",
      "tier": 2,
      "level": "B1",
      "chip": "dining",
      "register": "spoken",
      "separable": false,
      "zh": "没胃口地戳着吃、挑着吃",
      "senses": [
        {
          "zh": "小口小口地吃、吃不下",
          "en": "to eat only small amounts without much appetite",
          "example": {
            "en": "She only picked at her food and left half of it.",
            "zh": "她只挑着吃了几口，剩了一半。"
          }
        }
      ],
      "confusables": [
        "eat up",
        "snack on"
      ],
      "collocations": [
        "pick at your food",
        "pick at a salad"
      ],
      "l1_note": "没胃口地戳着吃是 pick at；pick 一个东西是挑。"
    },
    {
      "id": "eat-up",
      "head": "eat up",
      "base": "eat",
      "particle": "up",
      "ipa": "ˈit ʌp",
      "tier": 1,
      "level": "A2",
      "chip": "dining",
      "register": "spoken",
      "separable": true,
      "zh": "吃光",
      "senses": [
        {
          "zh": "把东西全部吃完",
          "en": "to finish all the food",
          "example": {
            "en": "The kids ate up every last dumpling.",
            "zh": "孩子们把饺子吃得一个不剩。"
          }
        }
      ],
      "l1_note": "“吃完”不是 eat finished；eat up / finish 才自然。eats up 还有“消耗掉”的意思。",
      "confusables": [
        "use up",
        "pick at"
      ],
      "collocations": [
        "eat up your vegetables",
        "eat up the leftovers"
      ]
    },
    {
      "id": "whip-up",
