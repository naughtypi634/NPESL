{
  "theme": "weekend-plan",
  "entries": [
    {
      "id": "hold-off",
      "head": "hold off",
      "base": "hold",
      "particle": "off",
      "ipa": "ˈhoʊld ɔf",
      "tier": 2,
      "level": "B1",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "暂缓、先等等",
      "senses": [
        {
          "zh": "先不做，等条件成熟",
          "en": "to delay doing something",
          "example": {
            "en": "Let's hold off on the launch until the bug is fixed.",
            "zh": "等这个 bug 修好再上线吧。"
          }
        }
      ],
      "l1_note": "“先不”不是 hold on（那是等一下）；推迟意思是 hold off (on)。",
      "confusables": [
        "put off",
        "hold on"
      ],
      "collocations": [
        "hold off on a decision",
        "hold off until Friday"
      ]
    },
    {
      "id": "put-off",
      "head": "put off",
      "base": "put",
      "particle": "off",
      "ipa": "ˈpʊt ɔf",
      "tier": 1,
      "level": "B1",
      "chip": "office",
      "register": "spoken",
      "separable": true,
      "zh": "推迟；让人反感",
      "senses": [
        {
          "zh": "把事往后推",
          "en": "to change something to a later time",
          "example": {
            "en": "We put off the meeting until next Tuesday.",
            "zh": "我们把会议推到下周二了。"
          }
        },
        {
          "zh": "让人不想靠近",
          "en": "to make someone lose interest or feel uncomfortable",
          "example": {
            "en": "His constant complaining really puts people off.",
            "zh": "他没完没了地抱怨，让人很不想接近。"
          }
        }
      ],
      "l1_note": "“拖延”不是 delay it again；put off 还有“倒胃口、让人反感”这层意思。",
      "confusables": [
        "hold off",
        "call off"
      ],
      "collocations": [
        "put off a decision",
        "put someone off"
      ]
    },
    {
      "id": "push-back",
      "head": "push back",
      "base": "push",
      "particle": "back",
      "ipa": "ˈpʊʃ bæk",
      "tier": 2,
      "level": "B1",
      "chip": "meetings",
      "register": "neutral",
      "separable": true,
      "zh": "推迟（时间）；反对",
      "senses": [
        {
          "zh": "把时间往后挪",
          "en": "to change an event to a later time",
          "example": {
            "en": "They pushed the deadline back by a week.",
            "zh": "他们把截止日往后推了一周。"
          }
        }
      ],
      "confusables": [
        "bring forward",
        "put off"
      ],
      "collocations": [
        "push back the deadline",
        "push back on an idea"
      ],
      "l1_note": "推迟时间；bring forward 是提前。"
    },
    {
      "id": "bring-forward",
      "head": "bring forward",
      "base": "bring",
      "particle": "forward",
      "ipa": "ˈbrɪŋ ˈfɔrwərd",
      "tier": 2,
      "level": "B1",
      "chip": "meetings",
      "register": "neutral",
      "separable": true,
      "zh": "提前（时间）",
      "senses": [
        {
          "zh": "把安排挪到更早",
          "en": "to change an event to an earlier time",
          "example": {
            "en": "Can we bring the meeting forward to 9:30?",
            "zh": "会议能提前到九点半吗？"
          }
        }
      ],
      "l1_note": "提前是 bring forward，不是 bring earlier；推后是 push back。",
      "confusables": [
        "push back",
        "move up"
      ],
      "collocations": [
        "bring forward a meeting",
        "bring the date forward"
      ]
    },
    {
      "id": "get-around-to",
      "head": "get around to",
      "base": "get",
      "particle": "around",
      "ipa": "ˈɡɛt əˈraʊnd tu",
      "tier": 2,
      "level": "B1",
      "chip": "home",
      "register": "spoken",
      "separable": false,
      "zh": "终于抽出时间做",
      "senses": [
        {
          "zh": "拖了很久才做",
          "en": "to finally do something you have been putting off",
          "example": {
            "en": "I still haven't gotten around to cleaning the fridge.",
            "zh": "我一直没腾出时间清理冰箱。"
          }
        }
      ],
      "l1_note": "“终于有时间做”不是 finally have time；get around to 强调拖了很久。",
      "confusables": [
        "put off",
        "find time"
      ],
      "collocations": [
        "get around to it",
        "get around to reading"
      ]
    },
    {
      "id": "fit-in",
      "head": "fit in",
      "base": "fit",
      "particle": "in",
      "ipa": "ˈfɪt ɪn",
      "tier": 1,
      "level": "B1",
      "chip": "office",
      "register": "spoken",
      "separable": true,
      "zh": "挤出时间安排；融入",
      "senses": [
        {
          "zh": "在忙里插入一件事",
          "en": "to find time for something in a busy schedule",
          "example": {
            "en": "I can fit you in at four if that works.",
            "zh": "四点我能给你腾出时间，行吗？"
          }
        },
        {
          "zh": "融入一个群体",
          "en": "to feel accepted by a group",
          "example": {
            "en": "It took a while to fit in at the new office.",
            "zh": "我花了一阵子才融入新办公室。"
          }
        }
      ],
      "l1_note": "“插队加个日程”不是 put you in my time；fit someone in 才是。",
      "confusables": [
        "squeeze in",
        "settle in"
      ],
      "collocations": [
        "fit in a meeting",
        "fit in with the team"
      ]
    },
    {
      "id": "squeeze-in",
      "head": "squeeze in",
      "base": "squeeze",
      "particle": "in",
      "ipa": "ˈskwiz ɪn",
      "tier": 3,
      "level": "B1",
      "chip": "office",
      "register": "spoken",
      "separable": true,
      "zh": "硬挤进去、挤时间",
      "senses": [
        {
          "zh": "时间很紧还塞进一件事",
          "en": "to manage to do something even though there is little time",
          "example": {
            "en": "I squeezed in a quick call between meetings.",
            "zh": "我在两个会之间硬塞了个电话。"
          }
        }
      ],
      "confusables": [
        "fit in",
        "cram in"
      ],
      "collocations": [
        "squeeze in a workout",
        "squeeze it in"
      ],
      "l1_note": "硬挤时间；fit in 是安排得下。"
    },
    {
      "id": "come-up",
      "head": "come up",
      "base": "come",
      "particle": "up",
      "ipa": "ˈkʌm ʌp",
      "tier": 1,
      "level": "B1",
      "chip": "office",
      "register": "spoken",
      "separable": false,
      "zh": "（时间）临近；（事）冒出来",
      "senses": [
        {
          "zh": "某件事快要到了",
          "en": "when an event is going to happen soon",
          "example": {
            "en": "The deadline is coming up, so I'm staying late.",
            "zh": "截止日快到了，我最近都在加班。"
          }
        }
      ],
      "l1_note": "“快到了”不是 is coming soon 才自然；日程临近常说 is coming up。",
      "confusables": [
        "come up with",
        "come along"
      ],
      "collocations": [
        "a deadline is coming up",
        "come up in a meeting"
      ]
    },
    {
      "id": "set-aside",
      "head": "set aside",
      "base": "set",
      "particle": "aside",
      "ipa": "ˈsɛt əˈsaɪd",
      "tier": 1,
      "level": "B1",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "留出（时间、钱）",
      "senses": [
        {
          "zh": "专门腾出时间或预算",
          "en": "to keep time or money for a special purpose",
          "example": {
            "en": "Set aside an hour every morning for reading.",
            "zh": "每天早上留一小时读书。"
          }
        }
      ],
      "l1_note": "“留时间”不是 leave time（也行）但更常用 set aside；留钱也是它。",
      "confusables": [
        "save up",
        "put aside"
      ],
      "collocations": [
        "set aside time",
        "set aside money"
      ]
    },
    {
      "id": "stick-to",
      "head": "stick to",
      "base": "stick",
      "particle": "to",
      "ipa": "ˈstɪk tu",
      "tier": 2,
      "level": "B1",
      "chip": "dining",
      "register": "spoken",
      "separable": false,
      "zh": "坚持（计划、饮食）",
      "senses": [
        {
          "zh": "按计划不改变",
          "en": "to continue with a plan or rule without changing it",
          "example": {
            "en": "I'll stick to water tonight — I have an early meeting.",
            "zh": "我今晚就喝水，明天一早有会。"
          }
        }
      ],
      "confusables": [
        "stick with",
        "keep to"
      ],
      "collocations": [
        "stick to the plan",
        "stick to a diet"
      ],
      "l1_note": "坚持计划；stick with 是坚持不换。"
    },
    {
      "id": "sign-up-for",
      "head": "sign up for",
      "base": "sign",
      "particle": "up",
      "ipa": "ˈsaɪn ʌp fɔr",
      "tier": 1,
      "level": "B1",
      "chip": "study",
      "register": "neutral",
      "separable": false,
      "zh": "报名参加",
      "senses": [
        {
          "zh": "报名课程、活动",
          "en": "to put your name on a list for a course or activity",
          "example": {
            "en": "I signed up for a speaking class on Tuesday nights.",
            "zh": "我报了个周二晚上的口语课。"
          }
        }
      ],
      "l1_note": "报名是 sign up for，不是 apply for（那是正式申请职位/签证）。",
      "confusables": [
        "apply for",
        "enroll in"
      ],
      "collocations": [
        "sign up for a class",
        "sign up for a newsletter"
      ]
    },
    {
      "id": "take-up",
      "head": "take up",
      "base": "take",
      "particle": "up",
      "ipa": "ˈteɪk ʌp",
      "tier": 1,
      "level": "B1",
      "chip": "leisure",
      "register": "neutral",
      "separable": true,
      "zh": "开始（一项爱好、运动）",
      "senses": [
        {
          "zh": "开始培养一个爱好",
          "en": "to start doing an activity regularly",
          "example": {
            "en": "I took up swimming after my knee started hurting.",
            "zh": "膝盖开始疼以后我改练游泳了。"
          }
        }
      ],
      "l1_note": "“开始学”不是 start to learn 才自然；开始一项活动常用 take up。",
      "confusables": [
        "take on",
        "pick up"
      ],
      "collocations": [
        "take up a hobby",
        "take up running"
      ]
    },
    {
      "id": "take-to",
      "head": "take to",
      "base": "take",
      "particle": "to",
      "ipa": "ˈteɪk tu",
      "tier": 2,
      "level": "B1",
      "chip": "leisure",
      "register": "spoken",
      "separable": false,
      "zh": "很快就喜欢上、上手",
      "senses": [
        {
          "zh": "一开始就喜欢或适应",
          "en": "to start to like something or get good at it quickly",
          "example": {
            "en": "She took to the guitar faster than anyone expected.",
            "zh": "她学吉他快得超出所有人预料。"
          }
        }
      ],
      "confusables": [
        "get into",
        "warm up to"
      ],
      "collocations": [
        "take to a new hobby",
        "take to someone"
      ],
      "l1_note": "很快喜欢或上手；get into 是逐渐喜欢。"
    },
    {
      "id": "get-into",
      "head": "get into",
      "base": "get",
      "particle": "into",
      "ipa": "ˈɡɛt ˈɪntu",
      "tier": 1,
      "level": "B1",
      "chip": "leisure",
      "register": "spoken",
      "separable": false,
      "zh": "喜欢上、沉迷",
      "senses": [
        {
          "zh": "逐渐喜欢并投入",
          "en": "to become interested in something",
          "example": {
            "en": "I got into baking during the lockdown and never stopped.",
            "zh": "封控期间我开始迷上烘焙，一直没停。"
          }
        }
      ],
      "l1_note": "“入坑”不是 fall into the pit；英语是 get into something。",
      "confusables": [
        "take to",
        "be into"
      ],
      "collocations": [
        "get into photography",
        "get into a routine"
      ]
    },
    {
      "id": "be-into",
      "head": "be into",
      "base": "be",
      "particle": "into",
      "ipa": "ˈbi ˈɪntu",
      "tier": 2,
      "level": "B1",
      "chip": "leisure",
      "register": "spoken",
      "separable": false,
      "zh": "对……很感兴趣",
      "senses": [
        {
          "zh": "喜欢并投入某个领域",
          "en": "to be very interested in something",
          "example": {
            "en": "I'm really into bouldering these days.",
            "zh": "我最近很迷攀岩。"
          }
        }
      ],
      "l1_note": "“我很喜欢”不是 I very like it（中式）；I'm really into it 才地道。",
      "confusables": [
        "get into",
        "be fond of"
      ],
      "collocations": [
        "be into photography",
        "be into someone"
      ]
    },
    {
      "id": "work-on",
      "head": "work on",
      "base": "work",
      "particle": "on",
      "ipa": "ˈwɝrk ɑn",
      "tier": 1,
      "level": "B1",
      "chip": "study",
      "register": "neutral",
      "separable": false,
      "zh": "在做（项目）；改善",
      "senses": [
        {
          "zh": "正在做某件事",
          "en": "to spend time doing or improving something",
          "example": {
            "en": "I'm working on my pronunciation this month.",
            "zh": "我这个月在练发音。"
          }
        }
      ],
      "l1_note": "“我在练发音”不是 I am practicing pronunciation 才自然；work on 更宽，含改进。",
      "confusables": [
        "work out",
        "work through"
      ],
      "collocations": [
        "work on a project",
        "work on your English"
      ]
    },
    {
      "id": "plan-out",
      "head": "plan out",
      "base": "plan",
      "particle": "out",
      "ipa": "ˈplæn aʊt",
      "chip": "leisure",
      "register": "neutral",
      "separable": true,
      "zh": "把计划排出来",
      "senses": [
        {
          "zh": "一步步安排好",
          "en": "to decide all the details of a plan",
          "example": {
            "en": "We planned out the whole trip in one evening.",
            "zh": "我们一个晚上就把行程排好了。"
          }
        }
      ],
      "l1_note": "排计划是 plan out；plan 单独是打算。",
      "confusables": [
        "map out",
        "line up"
      ],
      "collocations": [
        "plan out a trip",
        "plan it out"
      ]
    },
    {
      "id": "map-out",
      "head": "map out",
      "base": "map",
      "particle": "out",
      "ipa": "ˈmæp aʊt",
      "chip": "leisure",
      "register": "neutral",
      "separable": true,
      "zh": "规划出（路线、步骤）",
      "senses": [
        {
          "zh": "把整体路线画出来",
          "en": "to plan something in detail",
          "example": {
            "en": "She mapped out a weekend route with three stops.",
            "zh": "她规划了一条三个点的周末路线。"
          }
        }
      ],
      "l1_note": "规划是 map out，带“画出来”的画面。",
      "confusables": [
        "plan out",
        "work out"
      ],
      "collocations": [
        "map out a route",
        "map it out"
      ]
    },
    {
      "id": "block-out",
      "head": "block out",
      "base": "block",
      "particle": "out",
      "ipa": "ˈblɑk aʊt",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "空出（一段时间）",
      "senses": [
        {
          "zh": "在日程里留出整块时间",
          "en": "to reserve a period of time",
          "example": {
            "en": "Block out Sunday morning for the gym.",
            "zh": "周日早上留出来去健身。"
          }
        }
      ],
      "l1_note": "留出整段时间是 block out；set aside 更通用。",
      "confusables": [
        "set aside",
        "carve out"
      ],
      "collocations": [
        "block out two hours",
        "block it out"
      ]
    },
    {
      "id": "carve-out",
      "head": "carve out",
      "base": "carve",
      "particle": "out",
      "ipa": "ˈkɑrv aʊt",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "硬挤出（时间）",
      "senses": [
        {
          "zh": "从忙碌里抠出时间",
          "en": "to find time for something with difficulty",
          "example": {
            "en": "He carved out an hour for lunch between calls.",
            "zh": "他在电话会之间硬挤出一小时吃午饭。"
          }
        }
      ],
      "l1_note": "挤出时间是 carve out；不是 squeeze out（那是榨干）。",
      "confusables": [
        "block out",
        "squeeze in"
      ],
      "collocations": [
        "carve out time",
        "carve out a niche"
      ]
    },
    {
      "id": "line-up",
      "head": "line up",
      "base": "line",
      "particle": "up",
      "ipa": "ˈlaɪn ʌp",
      "chip": "leisure",
      "register": "neutral",
      "separable": true,
      "zh": "安排好、找齐",
      "senses": [
        {
          "zh": "把人和事排好",
          "en": "to arrange things or people in advance",
          "example": {
            "en": "I've lined up two friends for Saturday.",
            "zh": "周六我已经约好两个朋友了。"
          }
        }
      ],
      "l1_note": "安排好是 line up；排队也是 line up（美式）。",
      "confusables": [
        "plan out",
        "round up"
      ],
      "collocations": [
        "line up plans",
        "line something up"
      ]
    },
    {
      "id": "pencil-in",
      "head": "pencil in",
      "base": "pencil",
      "particle": "in",
      "ipa": "ˈpɛnsəl ɪn",
      "chip": "office",
      "register": "spoken",
      "separable": true,
      "zh": "暂定（时间）",
      "senses": [
        {
          "zh": "先占个时间，可能改",
          "en": "to arrange something provisionally",
          "example": {
            "en": "Let's pencil in Friday and confirm later.",
            "zh": "先暂定周五，之后再确认。"
          }
        }
      ],
      "l1_note": "暂定是 pencil in，暗示还可能改。",
      "confusables": [
        "block out",
        "line up"
      ],
      "collocations": [
        "pencil in a date",
        "pencil it in"
      ]
    },
    {
      "id": "book-up",
      "head": "book up",
      "base": "book",
      "particle": "up",
      "ipa": "ˈbʊk ʌp",
      "chip": "leisure",
      "register": "neutral",
      "separable": false,
      "zh": "订满",
      "senses": [
        {
          "zh": "位子被约满",
          "en": "when everything is already reserved",
          "example": {
            "en": "The good restaurants are booked up on Saturday.",
            "zh": "周六好点的餐厅都订满了。"
          }
        }
      ],
      "l1_note": "订满是 be booked up；book 是预订。",
      "confusables": [
        "full up",
        "take up"
      ],
      "collocations": [
        "fully booked up",
        "the hotel is booked up"
      ]
    },
    {
      "id": "call-off",
      "head": "call off",
      "base": "call",
      "particle": "off",
      "ipa": "ˈkɔl ɔf",
      "chip": "leisure",
      "register": "neutral",
      "separable": true,
      "zh": "取消",
      "senses": [
        {
          "zh": "取消已定的活动",
          "en": "to cancel something planned",
          "example": {
            "en": "They called off the picnic because of the storm.",
            "zh": "因为暴风雨他们把野餐取消了。"
          }
        }
      ],
      "l1_note": "取消是 call off；不是 cancel off（中式叠加）。",
      "confusables": [
        "put off",
        "back out"
      ],
      "collocations": [
        "call off a plan",
        "call it off"
      ]
    },
    {
      "id": "back-out-plan",
      "head": "back out",
      "base": "back",
      "particle": "out",
      "ipa": "ˈbæk aʊt",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "临时退出、反悔",
