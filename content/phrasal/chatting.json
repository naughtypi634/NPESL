{
  "theme": "chatting",
  "entries": [
    {
      "id": "hang-out",
      "head": "hang out",
      "base": "hang",
      "particle": "out",
      "ipa": "ˈhæŋ aʊt",
      "tier": 1,
      "level": "A2",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "一起待着、玩",
      "senses": [
        {
          "zh": "没具体安排地一起待着",
          "en": "to spend time with people without a specific plan",
          "example": {
            "en": "We just hung out at my place and watched old movies.",
            "zh": "我们就在我家待着看了几部老电影。"
          }
        }
      ],
      "l1_note": "“一起玩”不是 play together（那是小孩）；成年人是 hang out。",
      "confusables": [
        "hang around",
        "hang on"
      ],
      "collocations": [
        "hang out with friends",
        "hang out at the mall"
      ]
    },
    {
      "id": "catch-up",
      "head": "catch up",
      "base": "catch",
      "particle": "up",
      "ipa": "ˈkætʃ ʌp",
      "tier": 1,
      "level": "A2",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "叙旧；赶上进度",
      "senses": [
        {
          "zh": "见面聊聊近况",
          "en": "to meet someone and talk about what has happened",
          "example": {
            "en": "Let's catch up over coffee next week.",
            "zh": "下周找时间喝咖啡聊聊近况。"
          }
        }
      ],
      "l1_note": "“叙旧”不是 talk old things；catch up 才是那个词。",
      "confusables": [
        "catch up on",
        "keep up with"
      ],
      "collocations": [
        "catch up with a friend",
        "catch up over lunch"
      ]
    },
    {
      "id": "get-along",
      "head": "get along",
      "base": "get",
      "particle": "along",
      "ipa": "ˈɡɛt əˈlɔŋ",
      "tier": 1,
      "level": "A2",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "相处得好",
      "senses": [
        {
          "zh": "和人合得来",
          "en": "to have a good relationship with someone",
          "example": {
            "en": "My roommate and I get along better than I expected.",
            "zh": "我和室友处得比想象中好。"
          }
        }
      ],
      "l1_note": "合得来是 get along (with)，不是 get well with。",
      "confusables": [
        "get on with",
        "get by"
      ],
      "collocations": [
        "get along with coworkers",
        "get along well"
      ]
    },
    {
      "id": "tag-along",
      "head": "tag along",
      "base": "tag",
      "particle": "along",
      "ipa": "ˈtæɡ əˈlɔŋ",
      "tier": 3,
      "level": "B1",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "跟着去、蹭着一起",
      "senses": [
        {
          "zh": "没被邀请也跟着去",
          "en": "to go with someone, often without being invited",
          "example": {
            "en": "Mind if I tag along? I don't know anyone there.",
            "zh": "我跟着去可以吗？那边我一个人都不认识。"
          }
        }
      ],
      "confusables": [
        "come along",
        "join in"
      ],
      "collocations": [
        "tag along with friends",
        "tag along on a trip"
      ],
      "l1_note": "“跟着去”不是 go with them；tag along 带“不请自来、蹭着去”的味道。"
    },
    {
      "id": "join-in",
      "head": "join in",
      "base": "join",
      "particle": "in",
      "ipa": "ˈdʒɔɪn ɪn",
      "tier": 2,
      "level": "B1",
      "chip": "leisure",
      "register": "spoken",
      "separable": false,
      "zh": "加入（正在进行的活动）",
      "senses": [
        {
          "zh": "参与已经开始了的事",
          "en": "to take part in an activity that is already happening",
          "example": {
            "en": "Everyone was singing, so I joined in.",
            "zh": "大家都在唱，我也跟着唱了。"
          }
        }
      ],
      "confusables": [
        "join",
        "take part in"
      ],
      "collocations": [
        "join in the game",
        "join in the conversation"
      ],
      "l1_note": "join 是加入组织，join in 是加入正在进行的活动；中文都叫“加入”。"
    },
    {
      "id": "warm-up-to",
      "head": "warm up to",
      "base": "warm",
      "particle": "up",
      "ipa": "ˈwɔrm ʌp tu",
      "tier": 3,
      "level": "B1",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "慢慢喜欢上、接受",
      "senses": [
        {
          "zh": "一开始不喜欢，后来接受",
          "en": "to start to like someone or something gradually",
          "example": {
            "en": "I didn't like him at first, but I'm warming up to him.",
            "zh": "我一开始不喜欢他，但现在慢慢接受了。"
          }
        }
      ],
      "confusables": [
        "get into",
        "take to"
      ],
      "collocations": [
        "warm up to an idea",
        "warm up to someone"
      ],
      "l1_note": "“慢慢接受”不是 accept slowly 才自然；warm up to 指态度转暖。"
    },
    {
      "id": "strike-up",
      "head": "strike up",
      "base": "strike",
      "particle": "up",
      "ipa": "ˈstraɪk ʌp",
      "chip": "social",
      "register": "neutral",
      "separable": true,
      "zh": "开始（攀谈、交朋友）",
      "senses": [
        {
          "zh": "主动开口聊起来",
          "en": "to start a conversation or friendship",
          "example": {
            "en": "He struck up a conversation with the person next to him.",
            "zh": "他跟旁边的人聊了起来。"
          }
        }
      ],
      "l1_note": "攀谈是 strike up a conversation，不是 start a talk（中式）。",
      "confusables": [
        "chat",
        "open up"
      ],
      "collocations": [
        "strike up a conversation",
        "strike up a friendship"
      ]
    },
    {
      "id": "hit-it-off",
      "head": "hit it off",
      "base": "hit",
      "particle": "off",
      "ipa": "ˈhɪt ɪt ɔf",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "一见如故",
      "senses": [
        {
          "zh": "一见面就合得来",
          "en": "to like each other immediately",
          "example": {
            "en": "We hit it off right away and talked for two hours.",
            "zh": "我们一见如故，聊了两个小时。"
          }
        }
      ],
      "l1_note": "一见如故是 hit it off，不是 get along at once（生硬）。",
      "confusables": [
        "get along",
        "warm up to"
      ],
      "collocations": [
        "hit it off with someone",
        "hit it off immediately"
      ]
    },
    {
      "id": "go-on-about",
      "head": "go on about",
      "base": "go",
      "particle": "on",
      "ipa": "ˈɡoʊ ɑn əˈbaʊt",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "没完没了地说",
      "senses": [
        {
          "zh": "反复讲同一件事",
          "en": "to keep talking about something",
          "example": {
            "en": "He keeps going on about his new phone.",
            "zh": "他一直在讲他的新手机。"
          }
        }
      ],
      "l1_note": "go on about 带不耐烦的意味，不是普通“说”。",
      "confusables": [
        "drone on",
        "ramble on"
      ],
      "collocations": [
        "go on about work",
        "go on about it"
      ]
    },
    {
      "id": "drone-on",
      "head": "drone on",
      "base": "drone",
      "particle": "on",
      "ipa": "ˈdroʊn ɑn",
      "chip": "office",
      "register": "spoken",
      "separable": false,
      "zh": "单调地讲个不停",
      "senses": [
        {
          "zh": "让人犯困地念",
          "en": "to talk for a long time in a boring voice",
          "example": {
            "en": "The speaker droned on for an hour.",
            "zh": "演讲者干巴巴讲了一小时。"
          }
        }
      ],
      "l1_note": "drone on 带贬义，指声音单调。",
      "confusables": [
        "go on about",
        "ramble on"
      ],
      "collocations": [
        "drone on about rules",
        "drone on for hours"
      ]
    },
    {
      "id": "ramble-on",
      "head": "ramble on",
      "base": "ramble",
      "particle": "on",
      "ipa": "ˈræmbəl ɑn",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "东拉西扯地讲",
      "senses": [
        {
          "zh": "没有重点地聊",
          "en": "to talk without a clear point",
          "example": {
            "en": "Sorry for rambling on — I'm just nervous.",
            "zh": "抱歉扯远了，我就是紧张。"
          }
        }
      ],
      "l1_note": "ramble on 是没重点地讲，不是散步（ramble）。",
      "confusables": [
        "drone on",
        "go on about"
      ],
      "collocations": [
        "ramble on about nothing",
        "ramble on for ten minutes"
      ]
    },
    {
      "id": "cut-in",
      "head": "cut in",
      "base": "cut",
      "particle": "in",
      "ipa": "ˈkʌt ɪn",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "插话；加塞",
      "senses": [
        {
          "zh": "打断别人说话",
          "en": "to interrupt someone who is speaking",
          "example": {
            "en": "Sorry to cut in, but the taxi's here.",
            "zh": "不好意思打断一下，车到了。"
          }
        }
      ],
      "l1_note": "插话是 cut in；插队（车）也是 cut in，看语境。",
      "confusables": [
        "jump in",
        "butt in"
      ],
      "collocations": [
        "cut in on a conversation",
        "cut in mid-sentence"
      ]
    },
    {
      "id": "jump-in",
      "head": "jump in",
      "base": "jump",
      "particle": "in",
      "ipa": "ˈdʒʌmp ɪn",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "插话、踊跃加入",
      "senses": [
        {
          "zh": "主动加入谈话",
          "en": "to start taking part in a conversation",
          "example": {
            "en": "Feel free to jump in if I miss anything.",
            "zh": "我漏了什么你随时插话。"
          }
        }
      ],
      "l1_note": "jump in 是主动加入，语气比 cut in 友好。",
      "confusables": [
        "cut in",
        "join in"
      ],
      "collocations": [
        "jump in with a question",
        "jump in anytime"
      ]
    },
    {
      "id": "chime-in",
      "head": "chime in",
      "base": "chime",
      "particle": "in",
      "ipa": "ˈtʃaɪm ɪn",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "附和、补充一句",
      "senses": [
        {
          "zh": "在对话里加一句",
          "en": "to add a comment to a conversation",
          "example": {
            "en": "Several people chimed in with the same idea.",
            "zh": "好几个人附和了同一个想法。"
          }
        }
      ],
      "l1_note": "chime in 是友好地补充，不是敲钟（chime）。",
      "confusables": [
        "jump in",
        "weigh in"
      ],
      "collocations": [
        "chime in with a suggestion",
        "chime in on the call"
      ]
    },
    {
      "id": "butt-in",
      "head": "butt in",
      "base": "butt",
      "particle": "in",
      "ipa": "ˈbʌt ɪn",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "插嘴（不礼貌）",
      "senses": [
        {
          "zh": "没被邀请就插话",
          "en": "to interrupt rudely",
          "example": {
            "en": "Don't butt in when adults are talking.",
            "zh": "大人说话别插嘴。"
          }
        }
      ],
      "l1_note": "butt in 比 cut in 更粗鲁，带责备。",
      "confusables": [
        "cut in",
        "butt out"
      ],
      "collocations": [
        "butt in on a conversation",
        "butt in with an opinion"
      ]
    },
    {
      "id": "get-through-to",
      "head": "get through to",
      "base": "get",
      "particle": "through",
      "ipa": "ˈɡɛt θru tu",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "让……听进去；打通电话",
      "senses": [
        {
          "zh": "说服对方理解",
          "en": "to make someone understand what you mean",
          "example": {
            "en": "I just can't get through to my dad about this.",
            "zh": "这事我就是跟我爸说不通。"
          }
        }
      ],
      "l1_note": "get through to 有两个意思：让人听进去、电话打通。",
      "confusables": [
        "get across",
        "reach"
      ],
      "collocations": [
        "get through to someone",
        "get through to the office"
      ]
    },
    {
      "id": "put-across",
      "head": "put across",
      "base": "put",
      "particle": "across",
      "ipa": "ˈpʊt əˈkrɔs",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "把（观点）表达清楚",
      "senses": [
        {
          "zh": "讲明白",
          "en": "to explain an idea clearly",
          "example": {
            "en": "She put her point across without sounding aggressive.",
            "zh": "她把观点讲清楚了，又不显得咄咄逼人。"
          }
        }
      ],
      "l1_note": "put across 是表达清楚；put on 是穿、假装。",
      "confusables": [
        "get across",
        "put forward"
      ],
      "collocations": [
        "put an idea across",
        "put it across well"
      ]
    },
    {
      "id": "get-across",
      "head": "get across",
      "base": "get",
      "particle": "across",
      "ipa": "ˈɡɛt əˈkrɔs",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "让人听懂",
      "senses": [
        {
          "zh": "把意思传达到",
          "en": "to succeed in making people understand",
          "example": {
            "en": "The diagram helped get the idea across.",
            "zh": "这张图帮大家理解了。"
          }
        }
      ],
      "l1_note": "get across 强调“成功传达”，put across 强调“去表达”。",
      "confusables": [
        "put across",
        "get through to"
      ],
      "collocations": [
        "get the message across",
        "get it across"
      ]
    },
    {
      "id": "talk-over",
      "head": "talk over",
      "base": "talk",
      "particle": "over",
      "ipa": "ˈtɔk ˈoʊvər",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "详细商量",
      "senses": [
        {
          "zh": "一起讨论",
          "en": "to discuss something thoroughly",
          "example": {
            "en": "Let's talk it over before we tell the team.",
            "zh": "先商量好再跟团队说。"
          }
        }
      ],
      "l1_note": "talk over 是商量；talk over someone 是盖过别人说话。",
      "confusables": [
        "talk through",
        "hash out"
      ],
      "collocations": [
        "talk over a plan",
        "talk it over"
      ]
    },
    {
      "id": "talk-through",
      "head": "talk through",
      "base": "talk",
      "particle": "through",
      "ipa": "ˈtɔk θru",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "把……一步步讲清楚",
      "senses": [
        {
          "zh": "边讲边理清",
          "en": "to explain or discuss step by step",
          "example": {
            "en": "Can you talk me through what happened?",
            "zh": "你能一步步说说发生了什么吗？"
          }
        }
      ],
      "l1_note": "talk through 是过一遍流程；talk over 是商量。",
      "confusables": [
        "talk over",
        "walk through"
      ],
      "collocations": [
        "talk through the steps",
        "talk it through"
      ]
    },
    {
      "id": "hear-out",
      "head": "hear out",
      "base": "hear",
      "particle": "out",
      "ipa": "ˈhɪr aʊt",
      "chip": "social",
      "register": "spoken",
      "separable": true,
      "zh": "听人把话说完",
      "senses": [
        {
          "zh": "耐心听完",
          "en": "to listen to someone until they finish",
          "example": {
            "en": "Hear me out before you say no.",
            "zh": "先听我说完再拒绝。"
          }
        }
      ],
      "l1_note": "听人说完是 hear someone out，代词夹中间。",
      "confusables": [
        "listen to",
        "hear about"
      ],
      "collocations": [
        "hear someone out",
        "hear me out"
      ]
    },
    {
      "id": "tune-out",
      "head": "tune out",
      "base": "tune",
      "particle": "out",
      "ipa": "ˈtun aʊt",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "走神、听不进去",
      "senses": [
        {
          "zh": "注意力飘走",
          "en": "to stop paying attention",
          "example": {
            "en": "I tuned out halfway through the lecture.",
            "zh": "讲座听到一半我就走神了。"
          }
        }
      ],
      "l1_note": "tune out 是主动不听；tune in 是收听。",
      "confusables": [
        "zone out",
        "space out"
      ],
      "collocations": [
        "tune out the noise",
        "tune out during a meeting"
      ]
    },
    {
      "id": "zone-out",
      "head": "zone out",
      "base": "zone",
      "particle": "out",
      "ipa": "ˈzoʊn aʊt",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "发呆、神游",
      "senses": [
        {
          "zh": "脑子放空",
          "en": "to stop thinking about what is happening",
          "example": {
            "en": "Sorry, I zoned out — what did you say?",
            "zh": "抱歉我走神了，你说什么？"
          }
        }
      ],
      "l1_note": "zone out 是发呆；不是“进区”（zone）。",
      "confusables": [
        "space out",
        "tune out"
      ],
      "collocations": [
        "zone out in class",
        "zone out for a minute"
      ]
    },
    {
      "id": "space-out",
      "head": "space out",
      "base": "space",
      "particle": "out",
      "ipa": "ˈspeɪs aʊt",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "发呆、脑子空白",
      "senses": [
        {
          "zh": "短时间失神",
          "en": "to become inattentive for a moment",
          "example": {
            "en": "He spaced out and missed his stop.",
            "zh": "他发呆坐过了站。"
          }
        }
      ],
      "l1_note": "space out 和 zone out 近似，美式都很常用。",
      "confusables": [
        "zone out",
        "tune out"
      ],
      "collocations": [
        "space out on the subway",
        "space out mid-sentence"
      ]
    },
    {
      "id": "nod-along",
      "head": "nod along",
      "base": "nod",
      "particle": "along",
      "ipa": "ˈnɑd əˈlɔŋ",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "点头附和",
      "senses": [
        {
          "zh": "没太懂也跟着点头",
          "en": "to nod while someone talks, sometimes without understanding",
          "example": {
            "en": "I just nodded along and hoped nobody asked me anything.",
            "zh": "我就跟着点头，祈祷没人问我。"
          }
        }
      ],
      "l1_note": "nod along 常暗示“其实没听懂”，带自嘲。",
      "confusables": [
        "play along",
        "agree"
      ],
      "collocations": [
        "nod along in a meeting",
        "nod along to the story"
      ]
    },
    {
      "id": "laugh-off",
      "head": "laugh off",
      "base": "laugh",
      "particle": "off",
      "ipa": "ˈlæf ɔf",
      "chip": "social",
      "register": "neutral",
      "separable": true,
      "zh": "一笑置之",
      "senses": [
        {
          "zh": "用笑带过尴尬",
          "en": "to treat something as a joke to avoid dealing with it",
          "example": {
            "en": "He laughed off the mistake, but everyone noticed.",
            "zh": "他一笑带过，但大家都看见了。"
          }
