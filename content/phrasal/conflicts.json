        "back off",
        "give in"
      ],
      "collocations": [
        "refuse to back down",
        "back down from a demand"
      ]
    },
    {
      "id": "back-off",
      "head": "back off",
      "base": "back",
      "particle": "off",
      "ipa": "ˈbæk ɔf",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "退让、别逼我",
      "senses": [
        {
          "zh": "停止施压",
          "en": "to stop pushing someone or something",
          "example": {
            "en": "Back off — I said I'd think about it.",
            "zh": "别逼了，我说了会考虑。"
          }
        }
      ],
      "l1_note": "back off 语气硬，常用于让人别再追问。",
      "confusables": [
        "back down",
        "lay off"
      ],
      "collocations": [
        "tell someone to back off",
        "back off a bit"
      ]
    },
