      "ipa": "ˈhoʊld aʊt",
      "chip": "social",
      "register": "neutral",
      "separable": false,
      "zh": "坚持不让步",
      "senses": [
        {
          "zh": "顶住压力不松口",
          "en": "to refuse to agree or give in",
          "example": {
            "en": "They held out for a better offer.",
            "zh": "他们一直撑着等更好的条件。"
          }
        }
      ],
      "l1_note": "hold out 是坚持；hold out for 是坚持等更好的。",
      "confusables": [
        "hold on",
        "back down"
      ],
      "collocations": [
        "hold out for more",
        "hold out under pressure"
      ]
    },
