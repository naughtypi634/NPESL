      "ipa": "ˈstɔrm ɔf",
      "chip": "social",
      "register": "neutral",
      "separable": false,
      "zh": "愤然离开",
      "senses": [
        {
          "zh": "生气地甩门走人",
          "en": "to leave somewhere angrily",
          "example": {
            "en": "He stormed off in the middle of dinner.",
            "zh": "他饭吃到一半就甩脸走了。"
          }
        }
      ],
      "l1_note": "愤然离开是 storm off，不是 leave angrily（太直白）。",
      "confusables": [
        "walk out",
        "storm out"
      ],
      "collocations": [
        "storm off in anger",
        "storm off mid-sentence"
      ]
    },
    {
      "id": "walk-out",
      "head": "walk out",
      "base": "walk",
      "particle": "out",
      "ipa": "ˈwɔk aʊt",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "退场、罢工",
      "senses": [
        {
          "zh": "为抗议离开",
          "en": "to leave a place as a protest",
          "example": {
            "en": "Half the team walked out of the meeting.",
            "zh": "一半人从会上退场了。"
          }
        }
      ],
      "l1_note": "walk out 是抗议性离开；walk out on sb 是抛下某人。",
      "confusables": [
        "storm off",
        "walk away"
      ],
      "collocations": [
        "walk out of a meeting",
        "walk out on someone"
      ]
    },
    {
