      "ipa": "ˈstænd ʌp fɔr",
      "chip": "social",
      "register": "neutral",
      "separable": false,
      "zh": "维护、为……出头",
      "senses": [
        {
          "zh": "替人说话",
          "en": "to defend someone or something",
          "example": {
            "en": "She stood up for me when everyone else stayed quiet.",
            "zh": "别人都不吭声的时候她替我说话。"
