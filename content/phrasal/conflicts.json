{
  "theme": "conflicts",
  "entries": [
    {
      "id": "fall-out",
      "head": "fall out",
      "base": "fall",
      "particle": "out",
      "ipa": "ˈfɔl aʊt",
      "tier": 2,
      "level": "B1",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "闹翻、吵翻",
      "senses": [
        {
          "zh": "朋友之间闹掰",
          "en": "to argue with someone and stop being friendly",
          "example": {
            "en": "The two of them fell out over money and stopped talking.",
            "zh": "他俩为了钱闹翻，后来就不说话了。"
          }
        }
      ],
      "confusables": [
        "break up",
        "fall through"
      ],
      "collocations": [
        "fall out with someone",
        "fall out over something"
      ],
      "l1_note": "闹翻是 fall out (with)；fall out 也指掉头发、掉牙。"
    },
    {
      "id": "let-down",
      "head": "let down",
      "base": "let",
      "particle": "down",
      "ipa": "ˈlɛt daʊn",
      "tier": 1,
      "level": "B1",
      "chip": "social",
      "register": "spoken",
      "separable": true,
      "zh": "让……失望",
      "senses": [
        {
          "zh": "辜负指望",
          "en": "to make someone disappointed by not doing what they expected",
          "example": {
            "en": "I promised to help and then let her down at the last minute.",
            "zh": "我答应了帮忙，结果最后一刻让她失望了。"
          }
        }
      ],
      "l1_note": "“让我失望”不是 make me disappointed 才自然；let me down 更口语。",
      "confusables": [
        "disappoint",
        "put down"
      ],
      "collocations": [
        "let someone down",
        "feel let down"
      ]
    },
    {
      "id": "stand-up",
      "head": "stand up",
      "base": "stand",
      "particle": "up",
      "ipa": "ˈstænd ʌp",
      "tier": 2,
      "level": "B1",
      "chip": "social",
      "register": "spoken",
      "separable": true,
      "zh": "（约会）放人鸽子；站起来",
      "senses": [
        {
          "zh": "约好了却不去",
          "en": "to fail to meet someone you had a date with",
          "example": {
            "en": "She waited an hour at the restaurant — he stood her up.",
            "zh": "她在餐厅等了一小时，他放了她鸽子。"
          }
        }
      ],
      "confusables": [
        "blow off",
        "stand up for"
      ],
      "collocations": [
        "stand someone up",
        "get stood up"
      ],
      "l1_note": "放鸽子是 stand someone up，代词夹中间；不说 stand up someone。"
    },
    {
      "id": "give-in",
      "head": "give in",
      "base": "give",
      "particle": "in",
      "ipa": "ˈɡɪv ɪn",
      "tier": 2,
      "level": "B1",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "让步、屈服",
      "senses": [
        {
          "zh": "被说服或顶不住而妥协",
          "en": "to stop resisting and accept what someone wants",
          "example": {
            "en": "I gave in and ordered fries at midnight.",
            "zh": "我最后还是妥协了，半夜点了薯条。"
          }
        }
      ],
      "l1_note": "give in 是让步，give up 是放弃；中文都叫“算了”，英语不一样。",
      "confusables": [
        "give up",
        "give out"
      ],
      "collocations": [
        "give in to temptation",
        "give in to pressure"
      ]
    },
    {
      "id": "make-up-for",
      "head": "make up for",
      "base": "make",
      "particle": "up",
      "ipa": "ˈmeɪk ʌp fɔr",
      "tier": 1,
      "level": "B1",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "弥补",
      "senses": [
        {
          "zh": "用别的方式补回来",
          "en": "to do something good to replace something bad",
          "example": {
            "en": "I missed her birthday, so I'm making up for it this weekend.",
            "zh": "我错过了她生日，这周末补上。"
          }
        }
      ],
      "l1_note": "“弥补”不是 make up it（顺序错）；make up for 后面跟弥补的事，代词不能插进短语。",
      "confusables": [
        "make up",
        "make it up to"
      ],
      "collocations": [
        "make up for lost time",
        "make up for a mistake"
      ]
    },
    {
      "id": "sort-out",
      "head": "sort out",
      "base": "sort",
      "particle": "out",
      "ipa": "ˈsɔrt aʊt",
      "chip": "social",
      "register": "spoken",
      "separable": true,
      "zh": "把（矛盾）解决掉",
      "senses": [
        {
          "zh": "把问题理清楚解决",
          "en": "to solve a problem or disagreement",
          "example": {
            "en": "We need to sort this out before it gets worse.",
            "zh": "得在变糟之前把这事解决掉。"
          }
        }
      ],
      "l1_note": "解决矛盾是 sort out，不是 solve out（中式）。",
      "confusables": [
        "hash out",
        "work out"
      ],
      "collocations": [
        "sort out a fight",
        "sort it out"
      ]
    },
    {
      "id": "hash-out",
      "head": "hash out",
      "base": "hash",
      "particle": "out",
      "ipa": "ˈhæʃ aʊt",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "把分歧谈清楚",
      "senses": [
        {
          "zh": "反复讨论达成一致",
          "en": "to discuss something until you agree",
          "example": {
            "en": "Let's hash out the details before the meeting.",
            "zh": "开会前先把细节谈拢。"
          }
        }
      ],
      "l1_note": "hash out 是美式口语，指谈出结果，不是随便聊聊。",
      "confusables": [
        "sort out",
        "talk over"
      ],
      "collocations": [
        "hash out a deal",
        "hash it out"
      ]
    },
    {
      "id": "patch-up",
      "head": "patch up",
      "base": "patch",
      "particle": "up",
      "ipa": "ˈpætʃ ʌp",
      "chip": "social",
      "register": "spoken",
      "separable": true,
      "zh": "和好、修补关系",
      "senses": [
        {
          "zh": "闹别扭后修复",
          "en": "to repair a relationship after a fight",
          "example": {
            "en": "They patched things up after a week of silence.",
            "zh": "冷战一周后他们和好了。"
          }
        }
      ],
      "l1_note": "修补关系是 patch up；make up 更口语、更常见。",
      "confusables": [
        "make up",
        "sort out"
      ],
      "collocations": [
        "patch up a friendship",
        "patch things up"
      ]
    },
    {
      "id": "shut-out",
      "head": "shut out",
      "base": "shut",
      "particle": "out",
      "ipa": "ˈʃʌt aʊt",
      "chip": "social",
      "register": "neutral",
      "separable": true,
      "zh": "把……排除在外",
      "senses": [
        {
          "zh": "故意不理某人",
          "en": "to refuse to include someone",
          "example": {
            "en": "She's been shutting me out since the argument.",
            "zh": "吵架之后她一直把我排除在外。"
          }
        }
      ],
      "l1_note": "冷落是 shut out，不是 close the door to（太字面）。",
      "confusables": [
        "freeze out",
        "leave out"
      ],
      "collocations": [
        "shut someone out",
        "shut out a friend"
      ]
    },
    {
      "id": "freeze-out",
      "head": "freeze out",
      "base": "freeze",
      "particle": "out",
      "ipa": "ˈfriz aʊt",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "排挤",
      "senses": [
        {
          "zh": "用冷处理逼人走",
          "en": "to make someone feel unwelcome until they leave",
          "example": {
            "en": "The new manager froze out anyone who disagreed with him.",
            "zh": "新经理把不同意他的人都排挤走了。"
          }
        }
      ],
      "l1_note": "排挤是 freeze out，比 ignore 更有“逼走”的意思。",
      "confusables": [
        "shut out",
        "push around"
      ],
      "collocations": [
        "freeze someone out",
        "freeze out the critics"
      ]
    },
    {
      "id": "storm-off",
      "head": "storm off",
      "base": "storm",
