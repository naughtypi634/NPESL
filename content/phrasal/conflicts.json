      "register": "spoken",
      "separable": false,
      "zh": "替……说话（美式口语）",
      "senses": [
        {
          "zh": "站出来护着",
          "en": "to defend someone, especially a friend",
          "example": {
            "en": "Stick up for your brother instead of laughing.",
            "zh": "别笑了，替你说句话去。"
          }
        }
      ],
      "l1_note": "stick up for 是美式口语，和 stand up for 同义。",
      "confusables": [
        "stand up for",
        "speak up"
      ],
      "collocations": [
        "stick up for a friend",
        "stick up for yourself"
      ]
    },
