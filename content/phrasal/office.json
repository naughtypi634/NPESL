{
  "theme": "office",
  "entries": [
    {
      "id": "show-up-office",
      "head": "show up",
      "base": "show",
      "particle": "up",
      "ipa": "ˈʃoʊ ʌp",
      "chip": "office",
      "register": "spoken",
      "separable": false,
      "zh": "到岗、露面",
      "senses": [
        {
          "zh": "人出现在该在的地方",
          "en": "to arrive at work or an event",
          "example": {
            "en": "He showed up forty minutes late with coffee for nobody.",
            "zh": "他迟到四十分钟，还只给自己买了咖啡。"
          }
        }
      ],
      "l1_note": "到岗是 show up / turn up，不是 appear at work（太书面）。",
      "confusables": [
        "turn up",
        "sign in"
      ],
      "collocations": [
        "show up on time",
        "show up late"
      ],
      "collocations_zh": [
        "准时到",
        "迟到"
      ]
    },
    {
      "id": "take-on-office",
      "head": "take on",
      "base": "take",
      "particle": "on",
      "ipa": "ˈteɪk ɑn",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "承担（额外工作）",
      "senses": [
        {
          "zh": "接下更多任务",
          "en": "to accept extra work or responsibility",
          "example": {
            "en": "Don't take on another project until this one ships.",
            "zh": "这个项目上线前别再接新活了。"
          }
        }
      ],
      "l1_note": "承担用 take on；take up 是占用时间或开始爱好。",
      "confusables": [
        "take up",
        "take over"
      ],
      "collocations": [
        "take on a project",
        "take on more work"
      ],
      "collocations_zh": [
        "接项目",
        "接更多活"
      ]
    },
    {
      "id": "fill-in-for",
      "head": "fill in for",
      "base": "fill",
      "particle": "in",
      "ipa": "ˈfɪl ɪn fɔr",
      "chip": "office",
      "register": "spoken",
      "separable": false,
      "zh": "替班",
      "senses": [
        {
          "zh": "临时顶替某人",
          "en": "to do someone's job while they are away",
          "example": {
            "en": "Can you fill in for me on Friday? My kid has a fever.",
            "zh": "周五能替我一下吗？孩子发烧了。"
          }
        }
      ],
      "l1_note": "替班是 fill in for；fill out 是填表。",
      "confusables": [
        "stand in",
        "cover for"
      ],
      "collocations": [
        "fill in for a colleague",
        "fill in for someone"
      ],
      "collocations_zh": [
        "替同事班",
        "替某人"
      ]
    },
    {
      "id": "step-in",
      "head": "step in",
      "base": "step",
      "particle": "in",
      "ipa": "ˈstɛp ɪn",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "出面介入",
      "senses": [
        {
          "zh": "领导或同事介入处理",
          "en": "to get involved to help solve a problem",
          "example": {
            "en": "My manager stepped in before the argument got worse.",
            "zh": "经理在吵起来之前出面了。"
          }
        }
      ],
      "l1_note": "介入是 step in；step up 是挺身承担。",
      "confusables": [
        "step up",
        "take over"
      ],
      "collocations": [
        "step in to help",
        "step in early"
      ],
      "collocations_zh": [
        "出面帮忙",
        "早点介入"
      ]
    },
    {
      "id": "pitch-in",
      "head": "pitch in",
      "base": "pitch",
      "particle": "in",
      "ipa": "ˈpɪtʃ ɪn",
      "chip": "office",
      "register": "spoken",
      "separable": false,
      "zh": "搭把手",
      "senses": [
        {
          "zh": "大家一起出力",
          "en": "to help with a shared task",
          "example": {
            "en": "Everyone pitched in to get the deck done by six.",
            "zh": "大家一起动手，六点前把方案做完了。"
          }
        }
      ],
      "l1_note": "搭把手是 pitch in；凑钱是 chip in，差一个字母。",
      "confusables": [
        "chip in",
        "help out"
      ],
      "collocations": [
        "pitch in on a task",
        "pitch in together"
      ],
      "collocations_zh": [
        "一起出力",
        "一起干"
      ]
    },
    {
      "id": "get-ahead",
      "head": "get ahead",
      "base": "get",
      "particle": "ahead",
      "ipa": "ˈɡɛt əˈhɛd",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "出人头地",
      "senses": [
        {
          "zh": "职业上领先",
          "en": "to become more successful than others",
          "example": {
            "en": "She got ahead by taking the projects nobody wanted.",
            "zh": "她靠接没人要的项目走在了前面。"
          }
        }
      ],
      "l1_note": "出人头地是 get ahead；get ahead of 是抢在某人前面。",
      "confusables": [
        "get ahead of",
        "move up"
      ],
      "collocations": [
        "get ahead at work",
        "get ahead in your career"
      ],
      "collocations_zh": [
        "职场领先",
        "职业发展快"
      ]
    },
    {
      "id": "keep-up-office",
      "head": "keep up",
      "base": "keep",
      "particle": "up",
      "ipa": "ˈkip ʌp",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "跟得上",
      "senses": [
        {
          "zh": "速度或进度不掉队",
          "en": "to stay at the same pace as the work",
          "example": {
            "en": "I can't keep up with these ticket requests.",
            "zh": "这些工单我跟不上了。"
          }
        }
      ],
      "l1_note": "跟得上用 keep up (with)；跟上司无关。",
      "confusables": [
        "catch up",
        "keep on"
      ],
      "collocations": [
        "keep up with the workload",
        "keep up the pace"
      ],
      "collocations_zh": [
        "跟上工作量",
        "保持节奏"
      ]
    },
    {
      "id": "step-down-office",
      "head": "step down",
      "base": "step",
      "particle": "down",
      "ipa": "ˈstɛp daʊn",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "卸任",
      "senses": [
        {
          "zh": "主动辞去职位",
          "en": "to leave an important position",
          "example": {
            "en": "The director stepped down after the audit.",
            "zh": "审计之后总监卸任了。"
          }
        }
      ],
      "l1_note": "卸任是 step down；step aside 是让位给别人。",
      "confusables": [
        "step aside",
        "bow out"
      ],
      "collocations": [
        "step down as manager",
        "step down from the role"
      ],
      "collocations_zh": [
        "卸任经理",
        "卸下职位"
      ]
    },
    {
      "id": "move-up",
      "head": "move up",
      "base": "move",
      "particle": "up",
      "ipa": "ˈmuv ʌp",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "升职、往上走",
      "senses": [
        {
          "zh": "职位提升",
          "en": "to get a higher position",
          "example": {
            "en": "He moved up to team lead after two years.",
            "zh": "两年后他升成了组长。"
          }
        }
      ],
      "l1_note": "升职是 move up / get promoted；move up 也指时间提前。",
      "confusables": [
        "get ahead",
        "move on"
      ],
      "collocations": [
        "move up the ladder",
        "move up to manager"
      ],
      "collocations_zh": [
        "晋升",
        "升到经理"
      ]
    },
    {
      "id": "deal-with",
      "head": "deal with",
      "base": "deal",
      "particle": "with",
      "ipa": "ˈdil wɪð",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "把事情解决掉；处理情绪；涉及（话题）",
      "senses": [
        {
          "zh": "把事情解决掉",
          "en": "to take action on a problem",
          "example": {
            "en": "I'll deal with the vendor emails this afternoon.",
            "zh": "供应商的邮件我下午处理。"
          }
        },
        {
          "zh": "处理情绪",
          "en": "to manage a difficult feeling",
          "example": {
            "en": "She's still learning how to deal with stress at work.",
            "zh": "她还在学着怎么处理工作压力。"
          }
        },
        {
          "zh": "涉及话题",
          "en": "to be about a subject",
          "example": {
            "en": "The second chapter deals with refunds and returns.",
            "zh": "第二章讲退款和退货。"
          }
        }
      ],
      "l1_note": "处理是 deal with，不是 deal（少了 with）。",
      "confusables": [
        "look into",
        "sort out"
      ],
      "collocations": [
        "deal with a complaint",
        "deal with it"
      ],
      "collocations_zh": [
        "处理投诉",
        "处理掉"
      ]
    },
    {
      "id": "sit-down-with",
      "head": "sit down with",
      "base": "sit",
      "particle": "down",
      "ipa": "ˈsɪt daʊn wɪð",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "和（某人）坐下来谈",
      "senses": [
        {
          "zh": "正式谈一次",
          "en": "to have a serious conversation with someone",
          "example": {
            "en": "I need to sit down with my manager about the workload.",
            "zh": "我得跟经理坐下来谈谈工作量。"
          }
        }
      ],
      "l1_note": "坐下来谈是 sit down with；不是 sit with（那只是坐一起）。",
      "confusables": [
        "talk over",
        "check with"
      ],
      "collocations": [
        "sit down with a client",
        "sit down with the team"
      ],
      "collocations_zh": [
        "和客户坐下来谈",
        "和团队谈"
      ]
    },
    {
      "id": "report-back",
      "head": "report back",
      "base": "report",
      "particle": "back",
      "ipa": "rɪˈpɔrt bæk",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "汇报回来",
      "senses": [
        {
          "zh": "办完事后回话",
          "en": "to return with information",
          "example": {
            "en": "Report back by Thursday and we'll decide Friday.",
            "zh": "周四前汇报，我们周五定。"
          }
        }
      ],
      "l1_note": "汇报是 report back (to)，不是 report to（那是上级）。",
      "confusables": [
        "follow up",
        "get back to"
      ],
      "collocations": [
        "report back to the team",
        "report back on the findings"
      ],
      "collocations_zh": [
        "向团队汇报",
        "汇报结果"
      ]
    },
    {
      "id": "draw-up-office",
      "head": "draw up",
      "base": "draw",
      "particle": "up",
      "ipa": "ˈdrɔ ʌp",
      "chip": "office",
      "register": "written",
      "separable": true,
      "zh": "起草",
      "senses": [
        {
          "zh": "写出正式文件",
          "en": "to prepare a document",
          "example": {
            "en": "Legal is drawing up the contract now.",
            "zh": "法务正在起草合同。"
          }
        }
      ],
      "l1_note": "起草是 draw up；draw 单独是画。",
      "confusables": [
        "write up",
        "put together"
      ],
      "collocations": [
        "draw up a contract",
        "draw up a plan"
      ],
      "collocations_zh": [
        "起草合同",
        "起草计划"
      ]
    },
    {
      "id": "write-up",
      "head": "write up",
      "base": "write",
      "particle": "up",
      "ipa": "ˈraɪt ʌp",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "整理成文",
      "senses": [
        {
          "zh": "把记录写成文档",
          "en": "to write a full report from notes",
          "example": {
            "en": "Can you write up the meeting notes today?",
            "zh": "今天的会议纪要你能整理出来吗？"
          }
        }
      ],
      "l1_note": "整理成文是 write up；write down 是随手记下。",
      "confusables": [
        "write down",
        "draw up"
      ],
      "collocations": [
        "write up a report",
        "write it up"
      ],
      "collocations_zh": [
        "写报告",
        "整理成文"
      ]
    },
    {
      "id": "type-up",
      "head": "type up",
      "base": "type",
      "particle": "up",
      "ipa": "ˈtaɪp ʌp",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "打出来",
      "senses": [
        {
          "zh": "把纸面内容打成电子版",
          "en": "to type something written by hand",
          "example": {
            "en": "I'll type up my notes before the call.",
            "zh": "开会前我把笔记打出来。"
          }
        }
      ],
      "l1_note": "打字成稿是 type up；type 单独是打字动作。",
      "confusables": [
        "write up",
        "note down"
      ],
      "collocations": [
        "type up notes",
        "type it up"
      ],
      "collocations_zh": [
        "打字整理笔记",
        "打出来"
      ]
    },
    {
      "id": "file-away",
      "head": "file away",
      "base": "file",
      "particle": "away",
      "ipa": "ˈfaɪl əˈweɪ",
      "chip": "admin",
      "register": "neutral",
      "separable": true,
      "zh": "归档",
      "senses": [
        {
          "zh": "把文件收进档案",
          "en": "to store documents in their proper place",
          "example": {
            "en": "File away the signed copies and keep one at your desk.",
            "zh": "签好的那份归档，桌上留一份。"
          }
        }
      ],
      "l1_note": "归档是 file away；file 单独是提交（file a report）。",
      "confusables": [
        "put away",
        "archive"
      ],
      "collocations": [
        "file away contracts",
        "file it away"
      ],
      "collocations_zh": [
        "归档合同",
        "归档"
      ]
    },
    {
      "id": "work-through",
      "head": "work through",
      "base": "work",
      "particle": "through",
      "ipa": "ˈwɝrk θru",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "逐个处理完",
      "senses": [
        {
          "zh": "一项项做完",
          "en": "to deal with things one by one until finished",
          "example": {
            "en": "I'm working through the backlog this week.",
            "zh": "这周我在清理积压的活。"
          }
        }
      ],
      "l1_note": "逐个处理是 work through；work out 是想明白。",
      "confusables": [
        "work out",
        "get through"
      ],
      "collocations": [
        "work through a list",
        "work through the backlog"
      ],
      "collocations_zh": [
        "逐个处理清单",
        "清理积压"
      ]
    },
    {
      "id": "knuckle-down",
      "head": "knuckle down",
      "base": "knuckle",
      "particle": "down",
      "ipa": "ˈnʌkəl daʊn",
      "chip": "office",
      "register": "spoken",
      "separable": false,
      "zh": "埋头干",
      "senses": [
        {
          "zh": "收心认真干",
          "en": "to start working seriously",
          "example": {
            "en": "We need to knuckle down if we want this by Friday.",
            "zh": "想周五交出来，就得收心干活了。"
          }
        }
      ],
      "l1_note": "埋头干是 knuckle down；不是“跪下”。",
      "confusables": [
        "buckle down",
        "get down to"
      ],
      "collocations": [
        "knuckle down and finish",
        "knuckle down to work"
      ],
      "collocations_zh": [
        "埋头干完",
        "埋头工作"
      ]
    },
    {
      "id": "buckle-down",
      "head": "buckle down",
      "base": "buckle",
      "particle": "down",
      "ipa": "ˈbʌkəl daʊn",
      "chip": "office",
      "register": "spoken",
      "separable": false,
      "zh": "认真干起来",
      "senses": [
        {
          "zh": "下决心专注",
          "en": "to focus and work hard",
          "example": {
            "en": "She buckled down and finished the report in one night.",
            "zh": "她一晚上认真把报告写完了。"
          }
        }
      ],
      "l1_note": "buckle down 和 knuckle down 同义，美式都常用。",
      "confusables": [
        "knuckle down",
        "get down to"
      ],
      "collocations": [
        "buckle down to work",
        "buckle down and study"
      ],
      "collocations_zh": [
        "认真工作",
        "认真学"
      ]
    },
    {
      "id": "slave-away",
      "head": "slave away",
      "base": "slave",
      "particle": "away",
      "ipa": "ˈsleɪv əˈweɪ",
      "chip": "office",
      "register": "spoken",
      "separable": false,
      "zh": "苦干",
      "senses": [
        {
          "zh": "长期辛苦干活",
          "en": "to work very hard for a long time",
          "example": {
            "en": "I've been slaving away on this deck all week.",
            "zh": "这一周我都在死磕这份方案。"
          }
        }
      ],
      "l1_note": "slave away 带抱怨色彩，别对老板说。",
      "confusables": [
        "slog away",
        "work away"
      ],
      "collocations": [
        "slave away at a desk",
        "slave away for hours"
      ],
      "collocations_zh": [
        "在桌前苦干",
        "苦干几小时"
      ]
    },
    {
      "id": "slog-away",
      "head": "slog away",
      "base": "slog",
      "particle": "away",
      "ipa": "ˈslɑɡ əˈweɪ",
      "chip": "office",
      "register": "spoken",
      "separable": false,
      "zh": "埋头苦干",
      "senses": [
        {
          "zh": "枯燥地持续干",
          "en": "to keep working hard on something boring",
          "example": {
            "en": "He slogged away at the spreadsheet till midnight.",
            "zh": "他对着表格干到半夜。"
          }
        }
      ],
      "l1_note": "slog away 强调枯燥，slave away 强调被使唤。",
      "confusables": [
        "slave away",
        "plug away"
      ],
      "collocations": [
        "slog away at a task",
        "slog away all day"
      ],
      "collocations_zh": [
        "埋头做任务",
        "干一整天"
      ]
    },
    {
      "id": "churn-out",
      "head": "churn out",
      "base": "churn",
      "particle": "out",
      "ipa": "ˈtʃɝn aʊt",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "批量产出（含贬义）",
      "senses": [
        {
          "zh": "不管质量地大量做",
          "en": "to produce a lot of something quickly, often badly",
          "example": {
            "en": "The team churns out ten posts a day now.",
            "zh": "团队现在一天能出十篇稿子。"
          }
        }
      ],
      "l1_note": "churn out 暗示质量一般，夸人别用。",
      "confusables": [
        "crank out",
        "roll out"
      ],
      "collocations": [
        "churn out reports",
        "churn it out"
      ],
      "collocations_zh": [
        "批量出报告",
        "批量产出"
      ]
    },
    {
      "id": "crank-out",
      "head": "crank out",
      "base": "crank",
      "particle": "out",
      "ipa": "ˈkræŋk aʊt",
      "chip": "office",
      "register": "spoken",
      "separable": true,
      "zh": "赶出来",
      "senses": [
        {
          "zh": "快速生产",
          "en": "to produce something quickly",
          "example": {
            "en": "We cranked out three versions before lunch.",
            "zh": "午饭前我们赶出了三个版本。"
          }
        }
      ],
      "l1_note": "crank out 比 churn out 少一点贬义，仍是“赶工”。",
      "confusables": [
        "churn out",
        "knock out"
      ],
      "collocations": [
        "crank out a draft",
        "crank it out"
      ],
      "collocations_zh": [
        "赶出草稿",
        "赶出来"
      ]
    },
    {
      "id": "farm-out",
      "head": "farm out",
      "base": "farm",
      "particle": "out",
      "ipa": "ˈfɑrm aʊt",
      "chip": "clients",
