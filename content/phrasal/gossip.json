{
  "theme": "gossip",
  "entries": [
    {
      "id": "break-up",
      "head": "break up",
      "base": "break",
      "particle": "up",
      "ipa": "ˈbreɪk ʌp",
      "tier": 1,
      "level": "A2",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "分手；解散",
      "senses": [
        {
          "zh": "情侣分手",
          "en": "when two people end a romantic relationship",
          "example": {
            "en": "They broke up after two years and she moved out.",
            "zh": "他们在一起两年后分手，她搬走了。"
          }
        }
      ],
      "l1_note": "“分手”不是 separate（那是分开坐/分居）。break up 还可以指会议散会。",
      "confusables": [
        "break down",
        "split up"
      ],
      "collocations": [
        "break up with someone",
        "break up over text"
      ]
    },
    {
      "id": "hear-about",
      "head": "hear about",
      "base": "hear",
      "particle": "about",
      "ipa": "ˈhɪr əˈbaʊt",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "听说（某事）",
      "senses": [
        {
          "zh": "从别人那里听到",
          "en": "to learn about something by hearing it from others",
          "example": {
            "en": "I heard about the merger from a guy in accounting.",
            "zh": "我从财务部一个人那里听说了并购的事。"
          }
        }
      ],
      "l1_note": "听说不是 listen about；hear about 是听到某件事。",
      "confusables": [
        "hear of",
        "find out"
      ],
      "collocations": [
        "hear about the news",
        "hear about it"
      ]
    },
    {
      "id": "find-out",
      "head": "find out",
      "base": "find",
      "particle": "out",
      "ipa": "ˈfaɪnd aʊt",
      "chip": "social",
      "register": "spoken",
      "separable": true,
      "zh": "打听到、弄清楚",
      "senses": [
        {
          "zh": "把真相查出来",
          "en": "to discover a fact",
          "example": {
            "en": "How did you find out she's leaving?",
            "zh": "你怎么打听到她要走的？"
          }
        }
      ],
      "l1_note": "find out 是弄清楚一件事，find 是找到东西，别混。",
      "confusables": [
        "figure out",
        "look into"
      ],
      "collocations": [
        "find out the truth",
        "find out about it"
      ]
    },
    {
      "id": "let-on",
      "head": "let on",
      "base": "let",
      "particle": "on",
      "ipa": "ˈlɛt ɑn",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "透露、让人知道",
      "senses": [
        {
          "zh": "不轻易说出",
          "en": "to tell someone something that was a secret",
          "example": {
            "en": "He never let on that he was quitting.",
            "zh": "他一直没透露要辞职。"
          }
        }
      ],
      "l1_note": "let on 是透露，不是 let in（让进来）。",
      "confusables": [
        "let out",
        "keep quiet"
      ],
      "collocations": [
        "never let on",
        "let on about it"
      ]
    },
    {
      "id": "clue-in",
      "head": "clue in",
      "base": "clue",
      "particle": "in",
      "ipa": "ˈklu ɪn",
      "chip": "office",
      "register": "spoken",
      "separable": true,
      "zh": "把内情告诉某人",
      "senses": [
        {
          "zh": "让人了解情况",
          "en": "to give someone the information they are missing",
          "example": {
            "en": "Someone clue me in — what happened at the meeting?",
            "zh": "谁跟我说说，会上到底发生了什么？"
          }
        }
      ],
      "l1_note": "clue in 是美式口语，不是“给线索”的书面说法。",
      "confusables": [
        "fill in",
        "let on"
      ],
      "collocations": [
        "clue someone in",
        "clue me in"
      ]
    },
    {
      "id": "tip-off",
      "head": "tip off",
      "base": "tip",
      "particle": "off",
      "ipa": "ˈtɪp ɔf",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "通风报信",
      "senses": [
        {
          "zh": "私下告诉某人消息",
          "en": "to warn someone privately about something",
          "example": {
            "en": "A friend in HR tipped me off about the layoffs.",
            "zh": "人事部一个朋友私下告诉我裁员的事。"
          }
        }
      ],
      "l1_note": "tip off 是私下告知，不是给小费（tip）。",
      "confusables": [
        "let on",
        "warn"
      ],
      "collocations": [
        "tip someone off",
        "tip off the press"
      ]
    },
    {
      "id": "hush-up",
      "head": "hush up",
      "base": "hush",
      "particle": "up",
      "ipa": "ˈhʌʃ ʌp",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "压下、不让声张",
      "senses": [
        {
          "zh": "把丑事捂住",
          "en": "to stop something from becoming public",
          "example": {
            "en": "They tried to hush up the complaint.",
            "zh": "他们想把投诉压下去。"
          }
        }
      ],
      "l1_note": "hush up 带负面色彩，常用于掩盖丑闻。",
      "confusables": [
        "cover up",
        "play down"
      ],
      "collocations": [
        "hush up a scandal",
        "hush it up"
      ]
    },
    {
      "id": "play-down",
      "head": "play down",
      "base": "play",
      "particle": "down",
      "ipa": "ˈpleɪ daʊn",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "淡化、轻描淡写",
      "senses": [
        {
          "zh": "故意说没那么严重",
          "en": "to make something seem less important",
          "example": {
            "en": "The company played down the recall.",
            "zh": "公司把召回的事说得很轻。"
          }
        }
      ],
      "l1_note": "play down 是故意淡化，不是“玩下来”。",
      "confusables": [
        "tone down",
        "hush up"
      ],
      "collocations": [
        "play down the risks",
        "play it down"
      ]
    },
    {
      "id": "go-around",
      "head": "go around",
      "base": "go",
      "particle": "around",
      "ipa": "ˈɡoʊ əˈraʊnd",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "（消息）传开",
      "senses": [
        {
          "zh": "谣言在小范围流传",
          "en": "when news or a rumor spreads among people",
          "example": {
            "en": "There's a rumor going around that the store is closing.",
            "zh": "到处在传这家店要关门。"
          }
        }
      ],
      "l1_note": "“传开”不是 spread around by people；there's a rumor going around 是固定说法。",
      "confusables": [
        "get around",
        "get wind of"
      ],
      "collocations": [
        "a rumor going around",
        "word going around"
      ]
    },
    {
      "id": "get-wind-of",
      "head": "get wind of",
      "base": "get",
      "particle": "of",
      "ipa": "ˈɡɛt wɪnd əv",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "听到风声",
      "senses": [
        {
          "zh": "间接得知秘密消息",
          "en": "to learn about something secret indirectly",
          "example": {
            "en": "The press got wind of the deal before it was signed.",
            "zh": "协议还没签，媒体就听到风声了。"
          }
        }
      ],
      "l1_note": "get wind of 是“听到风声”，不是“得到风”。",
      "confusables": [
        "hear about",
        "find out"
      ],
      "collocations": [
        "get wind of a plan",
        "get wind of it"
      ]
    },
    {
      "id": "stumble-on",
      "head": "stumble on",
      "base": "stumble",
      "particle": "on",
      "ipa": "ˈstʌmbəl ɑn",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "偶然发现",
      "senses": [
        {
          "zh": "无意中看到",
          "en": "to find something by accident",
          "example": {
            "en": "I stumbled on their chat history by accident.",
            "zh": "我无意中看到了他们的聊天记录。"
          }
        }
      ],
      "l1_note": "stumble on 是偶然撞见，不是走路绊倒（stumble）。",
      "confusables": [
        "run into",
        "bump into"
      ],
      "collocations": [
        "stumble on a secret",
        "stumble on the truth"
      ]
    },
    {
      "id": "leak-out",
      "head": "leak out",
      "base": "leak",
      "particle": "out",
      "ipa": "ˈlik aʊt",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "泄露出去",
      "senses": [
        {
          "zh": "消息传出去",
          "en": "when secret information becomes public",
          "example": {
            "en": "The details leaked out before the official announcement.",
            "zh": "细节在正式公布前就漏出去了。"
          }
        }
      ],
      "l1_note": "泄露是 leak out，不是 leak（漏水）一个词就够。",
      "confusables": [
        "get out",
        "hush up"
      ],
      "collocations": [
        "the news leaked out",
        "leak out to the press"
      ]
    },
    {
      "id": "own-up",
      "head": "own up",
      "base": "own",
      "particle": "up",
      "ipa": "ˈoʊn ʌp",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "承认（是自己干的）",
      "senses": [
        {
          "zh": "主动认错",
          "en": "to admit that you did something wrong",
          "example": {
            "en": "Nobody owned up to sending that email.",
            "zh": "没人承认那封邮件是自己发的。"
          }
        }
      ],
      "l1_note": "承认是自己干的是 own up (to)，不是 admit up。",
      "confusables": [
        "fess up",
        "confess"
      ],
      "collocations": [
        "own up to a mistake",
        "own up to it"
      ]
    },
    {
      "id": "fess-up",
      "head": "fess up",
      "base": "fess",
      "particle": "up",
      "ipa": "ˈfɛs ʌp",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "坦白",
      "senses": [
        {
          "zh": "不情愿地承认",
          "en": "to admit something, often reluctantly",
          "example": {
            "en": "Come on, fess up — who ate the last slice?",
            "zh": "说吧，最后一块谁吃了？"
          }
        }
      ],
      "l1_note": "fess up 很口语，正式场合用 admit。",
      "confusables": [
        "own up",
        "admit"
      ],
      "collocations": [
        "fess up to it",
        "fess up about the mistake"
      ]
    },
    {
      "id": "call-out-gossip",
      "head": "call out",
      "base": "call",
      "particle": "out",
      "ipa": "ˈkɔl aʊt",
      "chip": "office",
      "register": "spoken",
      "separable": true,
      "zh": "公开指出（某人的问题）",
      "senses": [
        {
          "zh": "当面或网上点名",
          "en": "to publicly criticize someone for something they did",
          "example": {
            "en": "She called him out for taking credit for her idea.",
            "zh": "她公开指出他抢了她的功劳。"
          }
        }
      ],
      "l1_note": "call out 是公开点名，不是叫出去。",
      "confusables": [
        "point out",
        "call off"
      ],
      "collocations": [
        "call someone out for lying",
        "call it out"
      ]
    },
    {
      "id": "run-into",
      "head": "run into",
      "base": "run",
      "particle": "into",
      "ipa": "ˈrʌn ˈɪntu",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "偶然碰到（人）",
      "senses": [
        {
          "zh": "街上偶遇",
          "en": "to meet someone by chance",
          "example": {
            "en": "I ran into my boss at the gym — awkward.",
            "zh": "我在健身房碰到老板，尴尬死了。"
          }
        }
      ],
      "l1_note": "偶遇是 run into，不是 run to（跑向）。",
      "confusables": [
        "bump into",
        "come across"
      ],
      "collocations": [
        "run into an old friend",
        "run into someone"
      ]
    },
    {
      "id": "bump-into",
      "head": "bump into",
      "base": "bump",
      "particle": "into",
      "ipa": "ˈbʌmp ˈɪntu",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "碰见、撞见",
      "senses": [
        {
          "zh": "意外碰上",
          "en": "to meet someone unexpectedly",
          "example": {
            "en": "Guess who I bumped into at the subway station?",
            "zh": "猜我在地铁站碰见谁了？"
          }
        }
      ],
      "l1_note": "bump into 比 run into 更随意；撞到东西也是 bump into。",
      "confusables": [
        "run into",
        "come across"
      ],
      "collocations": [
        "bump into a colleague",
        "bump into each other"
      ]
    },
    {
      "id": "play-along",
      "head": "play along",
      "base": "play",
      "particle": "along",
      "ipa": "ˈpleɪ əˈlɔŋ",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "配合、顺着演",
      "senses": [
        {
          "zh": "假装不知道配合别人",
          "en": "to pretend to agree or go along with something",
          "example": {
            "en": "Just play along and don't tell her we know.",
            "zh": "你就配合一下，别告诉她我们知道了。"
          }
        }
      ],
      "l1_note": "play along 是配合演出，不是“一起玩”。",
      "confusables": [
        "go along",
        "join in"
      ],
      "collocations": [
        "play along with the joke",
        "play along with it"
      ]
    },
    {
      "id": "string-along",
      "head": "string along",
      "base": "string",
      "particle": "along",
      "ipa": "ˈstrɪŋ əˈlɔŋ",
      "chip": "social",
      "register": "spoken",
      "separable": true,
      "zh": "吊着（不给准话）",
      "senses": [
        {
          "zh": "一直拖着对方的期待",
          "en": "to keep someone hoping without giving a real answer",
          "example": {
            "en": "He's been stringing her along for months.",
            "zh": "他吊着她好几个月了。"
          }
        }
      ],
      "l1_note": "string along 带欺骗意味，不是“一起串”。",
      "confusables": [
        "lead on",
        "drag on"
      ],
      "collocations": [
        "string someone along",
        "string her along"
      ]
    },
    {
      "id": "lead-on",
      "head": "lead on",
      "base": "lead",
      "particle": "on",
      "ipa": "ˈlid ɑn",
      "chip": "social",
      "register": "spoken",
      "separable": true,
      "zh": "误导、给人错觉",
      "senses": [
        {
          "zh": "让人误以为有戏",
          "en": "to make someone believe you are more interested than you are",
          "example": {
            "en": "Don't lead him on if you're not interested.",
            "zh": "没兴趣就别给他错觉。"
          }
        }
      ],
      "l1_note": "lead on 是让人误会；lead to 是导致。",
      "confusables": [
        "string along",
        "lead to"
      ],
      "collocations": [
        "lead someone on",
        "lead him on"
      ]
    },
    {
      "id": "mess-around",
      "head": "mess around",
      "base": "mess",
      "particle": "around",
      "ipa": "ˈmɛs əˈraʊnd",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "乱来、胡搞",
      "senses": [
        {
          "zh": "感情上不认真",
          "en": "to behave in a way that is not serious or honest",
          "example": {
            "en": "I heard he's messing around with someone at work.",
            "zh": "听说他在公司跟人乱来。"
          }
        }
      ],
      "l1_note": "mess around 也指瞎玩、浪费时间，看语境。",
      "confusables": [
        "fool around",
        "mess up"
      ],
      "collocations": [
        "mess around with someone",
        "mess around at work"
      ]
    },
    {
      "id": "put-up-to",
      "head": "put up to",
      "base": "put",
      "particle": "to",
      "ipa": "ˈpʊt ʌp tu",
      "chip": "social",
      "register": "spoken",
      "separable": true,
      "zh": "怂恿（某人做）",
      "senses": [
        {
          "zh": "背后鼓动",
          "en": "to persuade someone to do something, often wrong",
          "example": {
            "en": "Who put you up to this?",
            "zh": "谁怂恿你这么干的？"
          }
        }
      ],
      "l1_note": "put up to 是怂恿，不是 put up with（忍受）。",
      "confusables": [
        "talk into",
        "put up with"
      ],
      "collocations": [
        "put someone up to it",
        "put him up to it"
      ]
    },
    {
      "id": "talk-into",
      "head": "talk into",
      "base": "talk",
      "particle": "into",
      "ipa": "ˈtɔk ˈɪntu",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "说服（去做）",
      "senses": [
        {
          "zh": "劝到同意",
          "en": "to persuade someone to do something",
          "example": {
            "en": "She talked me into joining the group chat.",
            "zh": "她把我劝进了群聊。"
          }
        }
      ],
      "l1_note": "说服去做是 talk into，劝退是 talk out of，方向相反。",
      "confusables": [
        "talk out of",
        "persuade"
      ],
      "collocations": [
        "talk someone into it",
        "talk me into going"
      ]
    },
    {
      "id": "talk-out-of",
      "head": "talk out of",
      "base": "talk",
      "particle": "out",
      "ipa": "ˈtɔk aʊt əv",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "劝退、说服别做",
      "senses": [
        {
          "zh": "把人劝住",
          "en": "to persuade someone not to do something",
          "example": {
            "en": "I tried to talk him out of quitting.",
            "zh": "我试着劝他别辞职。"
          }
        }
      ],
      "l1_note": "talk out of 是劝住，不是谈话本身。",
      "confusables": [
        "talk into",
        "talk over"
      ],
      "collocations": [
        "talk someone out of it",
        "talk her out of leaving"
      ]
    },
    {
      "id": "drag-up",
      "head": "drag up",
      "base": "drag",
      "particle": "up",
      "ipa": "ˈdræɡ ʌp",
      "chip": "social",
      "register": "spoken",
      "separable": true,
      "zh": "翻旧账",
      "senses": [
        {
          "zh": "把过去的事重新拿出来说",
          "en": "to bring up an unpleasant past event",
          "example": {
            "en": "Please don't drag up that story again.",
            "zh": "别又把那件事翻出来了。"
          }
        }
      ],
      "l1_note": "翻旧账是 drag up，不是 bring up（中性）。",
      "confusables": [
        "bring up",
        "dig up"
      ],
      "collocations": [
        "drag up the past",
        "drag it up"
      ]
    },
    {
      "id": "dig-up",
      "head": "dig up",
      "base": "dig",
      "particle": "up",
      "ipa": "ˈdɪɡ ʌp",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "挖出（旧事、内幕）",
      "senses": [
        {
          "zh": "把被遗忘的事查出来",
          "en": "to find old information that was hidden",
          "example": {
            "en": "The reporter dug up an old interview.",
            "zh": "记者挖出了一段旧采访。"
          }
        }
      ],
      "l1_note": "挖内幕用 dig up；挖土也是 dig。",
      "confusables": [
        "drag up",
        "find out"
      ],
      "collocations": [
        "dig up dirt",
        "dig up the past"
      ]
    },
    {
      "id": "cover-for",
      "head": "cover for",
      "base": "cover",
      "particle": "for",
      "ipa": "ˈkʌvər fɔr",
      "chip": "office",
