      "base": "ask",
      "particle": "out",
      "ipa": "ˈæsk aʊt",
      "chip": "social",
      "register": "spoken",
      "separable": true,
      "zh": "约（人）出去",
      "senses": [
        {
          "zh": "开口约约会",
          "en": "to invite someone you like on a date",
          "example": {
            "en": "He asked her out after three weeks of chatting.",
            "zh": "聊了三周他终于约她出去了。"
          }
        }
      ],
      "l1_note": "约出去是 ask someone out，代词夹中间。",
      "confusables": [
        "go out with",
        "ask for"
      ],
      "collocations": [
        "ask someone out",
        "ask her out"
      ]
    },
    {
