{
  "theme": "communication",
  "entries": [
    {
      "id": "follow-up",
      "head": "follow up",
      "base": "follow",
      "particle": "up",
      "ipa": "ˈfɑloʊ ʌp",
      "tier": 1,
      "level": "B1",
      "chip": "clients",
      "register": "neutral",
      "separable": false,
      "zh": "跟进、后续联系",
      "senses": [
        {
          "zh": "过一段时间再联系推进",
          "en": "to contact someone again about something not yet finished",
          "example": {
            "en": "I'll follow up with the client on Monday.",
            "zh": "我周一再跟客户联系。"
          }
        }
      ],
      "l1_note": "“跟进”不是 follow（跟着走）；商务场景必须 follow up。",
      "confusables": [
        "keep up with",
        "get back to"
      ],
      "collocations": [
        "follow up on an email",
        "follow up with a client"
      ],
      "collocations_zh": [
        "跟进邮件",
        "跟进客户"
      ]
    },
    {
      "id": "put-forward",
      "head": "put forward",
      "base": "put",
      "particle": "forward",
      "ipa": "ˈpʊt ˈfɔrwərd",
      "tier": 2,
      "level": "B1",
      "chip": "meetings",
      "register": "neutral",
      "separable": true,
      "zh": "提出（建议、方案）",
      "senses": [
        {
          "zh": "在会上提出想法",
          "en": "to suggest an idea for other people to consider",
          "example": {
            "en": "I put forward a plan for working from home two days a week.",
            "zh": "我提了个一周两天远程的方案。"
          }
        }
      ],
      "confusables": [
        "come up with",
        "bring up"
      ],
      "collocations": [
        "put forward a proposal",
        "put forward an idea"
      ],
      "l1_note": "“提出”不是 put out（那是熄灭、拿出）；提建议用 put forward。",
      "collocations_zh": [
        "提出方案",
        "提出想法"
      ]
    },
    {
      "id": "reach-out",
      "head": "reach out",
      "base": "reach",
      "particle": "out",
      "ipa": "ˈritʃ aʊt",
      "tier": 1,
      "level": "B1",
      "chip": "clients",
      "register": "neutral",
      "separable": false,
      "zh": "主动联系",
      "senses": [
        {
          "zh": "给别人发消息或打电话",
          "en": "to contact someone to ask for help or offer something",
          "example": {
            "en": "Feel free to reach out if you have any questions.",
            "zh": "有问题随时联系我。"
          }
        }
      ],
      "l1_note": "商务邮件里“联系我”不是 contact with me（错），是 reach out to me / contact me。",
      "confusables": [
        "get in touch",
        "follow up"
      ],
      "collocations": [
        "reach out to a client",
        "reach out for help"
      ],
      "collocations_zh": [
        "联系客户",
        "寻求帮助"
      ]
    },
    {
      "id": "touch-base",
      "head": "touch base",
      "base": "touch",
      "particle": "base",
      "ipa": "ˈtʌtʃ beɪs",
      "tier": 3,
      "level": "B2",
      "chip": "meetings",
      "register": "spoken",
      "separable": false,
      "zh": "简单碰一下、同步一下",
      "senses": [
        {
          "zh": "短时间沟通一下近况",
          "en": "to talk to someone briefly to share updates",
          "example": {
            "en": "Let's touch base on Friday before the client meeting.",
            "zh": "周五见客户前我们先碰一下。"
          }
        }
      ],
      "confusables": [
        "check in",
        "catch up"
      ],
      "collocations": [
        "touch base with the team",
        "touch base next week"
      ],
      "l1_note": "商务口头语，不是“接触基地”；中文没有对应词，别逐字翻。",
      "collocations_zh": [
        "和团队碰一下",
        "下周碰头"
      ]
    },
    {
      "id": "run-by",
      "head": "run by",
      "base": "run",
      "particle": "by",
      "ipa": "ˈrʌn baɪ",
      "tier": 2,
      "level": "B1",
      "chip": "meetings",
      "register": "spoken",
      "separable": true,
      "zh": "先给某人过目、征求同意",
      "senses": [
        {
          "zh": "把想法先说给某人听",
          "en": "to tell someone an idea to get their opinion",
          "example": {
            "en": "Let me run this by my manager before we commit.",
            "zh": "正式定下来之前我先跟经理过一下这个想法。"
          }
        }
      ],
      "l1_note": "“跟领导说一下”不是 tell my boss 就完事；run it by someone 是征求同意。代词夹中间。",
      "confusables": [
        "put forward",
        "check with"
      ],
      "collocations": [
        "run it by someone",
        "run an idea by the team"
      ],
      "collocations_zh": [
        "给某人过目",
        "让团队过一下"
      ]
    },
    {
      "id": "wrap-up",
      "head": "wrap up",
      "base": "wrap",
      "particle": "up",
      "ipa": "ˈræp ʌp",
      "tier": 2,
      "level": "B1",
      "chip": "meetings",
      "register": "spoken",
      "separable": true,
      "zh": "收尾、结束",
      "senses": [
        {
          "zh": "把会议或工作收尾",
          "en": "to finish a meeting or piece of work",
          "example": {
            "en": "Let's wrap up in five minutes — I have another call.",
            "zh": "我们五分钟内收尾吧，我还有个电话会。"
          }
        }
      ],
      "confusables": [
        "wind up",
        "finish up"
      ],
      "collocations": [
        "wrap up a meeting",
        "wrap things up"
      ],
      "l1_note": "“收尾”不是 close the meeting 才地道；wrap up 更口语。",
      "collocations_zh": [
        "结束会议",
        "收尾"
      ]
    },
    {
      "id": "hand-over",
      "head": "hand over",
      "base": "hand",
      "particle": "over",
      "ipa": "ˈhænd ˈoʊvər",
      "tier": 2,
      "level": "B1",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "移交、交接",
      "senses": [
        {
          "zh": "把工作交给别人",
          "en": "to give control or responsibility to someone else",
          "example": {
            "en": "I'll hand over the files before I leave on Friday.",
            "zh": "我周五走之前把文件交接好。"
          }
        }
      ],
      "confusables": [
        "take over",
        "hand in"
      ],
      "collocations": [
        "hand over a project",
        "hand over to the new manager"
      ],
      "l1_note": "移交是 hand over；hand in 是交作业，别混。",
      "collocations_zh": [
        "移交项目",
        "移交给新经理"
      ]
    },
    {
      "id": "take-over",
      "head": "take over",
      "base": "take",
      "particle": "over",
      "ipa": "ˈteɪk ˈoʊvər",
      "tier": 1,
      "level": "B1",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "接管、接手",
      "senses": [
        {
          "zh": "接手别人的工作或职位",
          "en": "to take control of a job or company from someone",
          "example": {
            "en": "She's taking over the account while he's on leave.",
            "zh": "他休假期间她接手这个客户。"
          }
        }
      ],
      "l1_note": "接手工作不是 take the work over 才自然；take over 后直接跟宾语即可。",
      "confusables": [
        "take on",
        "hand over"
      ],
      "collocations": [
        "take over a project",
        "take over from someone"
      ],
      "collocations_zh": [
        "接管项目",
        "接手某人工作"
      ]
    },
    {
      "id": "look-into",
      "head": "look into",
      "base": "look",
      "particle": "into",
      "ipa": "ˈlʊk ˈɪntu",
      "tier": 1,
      "level": "B1",
      "chip": "admin",
      "register": "neutral",
      "separable": false,
      "zh": "调查、了解一下",
      "senses": [
        {
          "zh": "去查清楚一件事",
          "en": "to try to find out the facts about something",
          "example": {
            "en": "Thanks for the report — I'll look into it today.",
            "zh": "谢谢反馈，我今天就去查一下。"
          }
        }
      ],
      "l1_note": "“调查”不是 look for（那是找东西）；look into 才是查原因。",
      "confusables": [
        "look for",
        "look up"
      ],
      "collocations": [
        "look into a complaint",
        "look into the issue"
      ],
      "collocations_zh": [
        "调查投诉",
        "查问题"
      ]
    },
    {
      "id": "go-over",
      "head": "go over",
      "base": "go",
      "particle": "over",
      "ipa": "ˈɡoʊ ˈoʊvər",
      "tier": 1,
      "level": "B1",
      "chip": "study",
      "register": "neutral",
      "separable": true,
      "zh": "把内容从头看一遍；走过去；串门",
      "senses": [
        {
          "zh": "把内容从头看一遍",
          "en": "to examine or review something carefully",
          "example": {
            "en": "Let's go over the answers before the test.",
            "zh": "考试前我们把答案过一遍。"
          }
        },
        {
          "zh": "走过去",
          "en": "to move towards someone or something",
          "example": {
            "en": "Go over to the counter and ask for a bag.",
            "zh": "去柜台那边要个袋子。"
          }
        },
        {
          "zh": "串门",
          "en": "to visit someone's home briefly",
          "example": {
            "en": "We went over to our neighbors' place for tea.",
            "zh": "我们去邻居家坐了坐，喝了杯茶。"
          }
        }
      ],
      "l1_note": "“复习”不是 review it again and again 才自然；go over 更口语。",
      "confusables": [
        "run through",
        "look over"
      ],
      "collocations": [
        "go over the notes",
        "go over a mistake"
      ],
      "collocations_zh": [
        "过笔记",
        "过错误"
      ]
    },
    {
      "id": "run-through",
      "head": "run through",
      "base": "run",
      "particle": "through",
      "ipa": "ˈrʌn θru",
      "tier": 2,
      "level": "B1",
      "chip": "study",
      "register": "neutral",
      "separable": true,
      "zh": "正式场合前快速演练；贯穿；蔓延",
      "senses": [
        {
          "zh": "正式场合前快速演练",
          "en": "to practice or review something quickly",
          "example": {
            "en": "Let's run through the slides once before we present.",
            "zh": "上讲台前我们把幻灯片过一遍。"
          }
        },
        {
          "zh": "贯穿",
          "en": "to spread through a place or group",
          "example": {
            "en": "A wave of excitement ran through the office.",
            "zh": "一阵兴奋传遍了办公室。"
          }
        },
        {
          "zh": "蔓延",
          "en": "to be present throughout something",
          "example": {
            "en": "A thread of humor runs through the whole speech.",
            "zh": "整篇演讲贯穿着一种幽默。"
          }
        }
      ],
      "confusables": [
        "go over",
        "walk through"
      ],
      "collocations": [
        "run through the plan",
        "run through a presentation"
      ],
      "l1_note": "演练是 run through；run over 是碾过，别混。",
      "collocations_zh": [
        "过计划",
        "演练演示"
      ]
    },
    {
      "id": "come-up-with",
      "head": "come up with",
      "base": "come",
      "particle": "up",
      "ipa": "ˈkʌm ʌp wɪð",
      "tier": 1,
      "level": "B1",
      "chip": "meetings",
      "register": "spoken",
      "separable": false,
      "zh": "想出（主意、办法）",
      "senses": [
        {
          "zh": "提出一个新的想法",
          "en": "to think of an idea or solution",
          "example": {
            "en": "Nobody could come up with a better name for the app.",
            "zh": "没人能想出一个更好的 App 名字。"
          }
        }
      ],
      "l1_note": "“想出”不是 think out / think up（也可以但少）；come up with 后直接跟想出的东西。",
      "confusables": [
        "put forward",
        "think up"
      ],
      "collocations": [
        "come up with an idea",
        "come up with a plan"
      ],
      "collocations_zh": [
        "想出主意",
        "想出计划"
      ]
    },
    {
      "id": "go-ahead",
      "head": "go ahead",
      "base": "go",
      "particle": "ahead",
      "ipa": "ˈɡoʊ əˈhɛd",
      "tier": 1,
      "level": "A2",
      "chip": "meetings",
      "register": "spoken",
      "separable": false,
      "zh": "继续；你请便",
      "senses": [
        {
          "zh": "得到许可可以开始",
          "en": "used to give someone permission to start",
          "example": {
            "en": "If you're ready, go ahead and send the email.",
            "zh": "准备好了就把邮件发出去吧。"
          }
        }
      ],
      "l1_note": "“你先来”不是 you first 才地道；go ahead 是许可也是让对方先做。",
      "confusables": [
        "go on",
        "carry on"
      ],
      "collocations": [
        "go ahead with the plan",
        "go ahead and ask"
      ],
      "collocations_zh": [
        "推进计划",
        "直接问"
      ]
    },
    {
      "id": "make-up",
      "head": "make up",
      "base": "make",
      "particle": "up",
      "ipa": "ˈmeɪk ʌp",
      "tier": 1,
      "level": "B1",
      "chip": "social",
      "register": "spoken",
      "separable": false,
      "zh": "编造一个说法；吵架后和好；构成",
      "senses": [
        {
          "zh": "编造一个说法",
          "en": "to invent an excuse or story",
          "example": {
            "en": "He made up some excuse about the subway being delayed.",
            "zh": "他编了个地铁延误的借口。"
          }
        },
        {
          "zh": "吵架后和好",
          "en": "to become friends again after an argument",
          "example": {
            "en": "They argued for an hour and made up before dessert.",
            "zh": "他们吵了一小时，甜点还没上就和好了。"
          }
        },
        {
          "zh": "构成",
          "en": "to form or compose something",
          "example": {
            "en": "Women make up half of the team.",
            "zh": "团队里女性占一半。"
          }
        }
      ],
      "l1_note": "和好用 make up 或 make up with someone；编故事也是 make up，靠上下文区分。",
      "confusables": [
        "make up for",
        "make out"
      ],
      "collocations": [
        "make up with a friend",
        "make up an excuse"
      ],
      "collocations_zh": [
        "和朋友和好",
        "编借口"
      ]
    },
    {
      "id": "keep-up-with",
      "head": "keep up with",
      "base": "keep",
      "particle": "up",
      "ipa": "ˈkip ʌp wɪð",
      "tier": 1,
      "level": "B1",
      "chip": "study",
      "register": "neutral",
      "separable": false,
      "zh": "跟得上（节奏、进度）",
      "senses": [
        {
          "zh": "跟上讨论或进度",
          "en": "to stay at the same pace as a discussion or schedule",
          "example": {
            "en": "I lost the thread after the second slide — I couldn't keep up with the discussion.",
            "zh": "第二张幻灯片之后我就跟丢了，跟不上讨论。"
          }
        }
      ],
      "l1_note": "“跟上”不是 follow up（那是后续跟进）；进度用 keep up with。",
      "confusables": [
        "follow up",
        "catch up on"
      ],
      "collocations": [
        "keep up with the class",
        "keep up with the news"
      ],
      "collocations_zh": [
        "跟上课程",
        "跟上新闻"
      ]
    },
    {
      "id": "spell-out",
      "head": "spell out",
      "base": "spell",
      "particle": "out",
      "ipa": "ˈspɛl aʊt",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "一条条讲清楚",
      "senses": [
        {
          "zh": "把要求说明白",
          "en": "to explain something in very clear detail",
          "example": {
            "en": "Let me spell out what the client actually needs.",
            "zh": "我把客户到底要什么讲清楚。"
          }
        }
      ],
      "l1_note": "讲清楚是 spell out，不是 say clearly（太泛）。",
      "confusables": [
        "lay out",
        "talk through"
      ],
      "collocations": [
        "spell out the rules",
        "spell it out"
      ],
      "collocations_zh": [
        "讲清规则",
        "一条条讲"
      ]
    },
    {
      "id": "lay-out",
      "head": "lay out",
      "base": "lay",
      "particle": "out",
      "ipa": "ˈleɪ aʊt",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "摆出来说明",
      "senses": [
        {
          "zh": "把选项或计划摊开讲",
          "en": "to explain something in an organized way",
          "example": {
            "en": "She laid out three options for the launch.",
            "zh": "她把上线的三个方案摆出来讲。"
          }
        }
      ],
      "l1_note": "lay out 是摊开讲；layout 名词是布局。",
      "confusables": [
        "spell out",
        "set out"
      ],
      "collocations": [
        "lay out a plan",
        "lay it out"
      ],
      "collocations_zh": [
        "摆出计划",
        "摊开讲"
      ]
    },
    {
      "id": "touch-on",
      "head": "touch on",
      "base": "touch",
      "particle": "on",
      "ipa": "ˈtʌtʃ ɑn",
      "chip": "meetings",
      "register": "neutral",
      "separable": false,
      "zh": "简单提到",
      "senses": [
        {
          "zh": "顺带说一句",
          "en": "to mention a subject briefly",
          "example": {
            "en": "He touched on the budget but didn't give numbers.",
            "zh": "他提到了预算但没给数字。"
          }
        }
      ],
      "l1_note": "简单提到是 touch on，不是 touch（摸）。",
      "confusables": [
        "bring up",
        "go into"
      ],
      "collocations": [
        "touch on a topic",
        "briefly touch on"
      ],
      "collocations_zh": [
        "提到话题",
        "简单提"
      ]
    },
    {
      "id": "sum-up",
      "head": "sum up",
      "base": "sum",
      "particle": "up",
      "ipa": "ˈsʌm ʌp",
      "chip": "meetings",
      "register": "neutral",
      "separable": true,
      "zh": "总结",
      "senses": [
        {
          "zh": "把要点收拢",
          "en": "to give the main points again",
          "example": {
            "en": "Let me sum up before we vote.",
            "zh": "投票前我先总结一下。"
          }
        }
      ],
      "l1_note": "总结是 sum up；不是 summarize up（重复）。",
      "confusables": [
        "wrap up",
        "recap"
      ],
      "collocations": [
        "sum up the meeting",
        "sum it up"
      ],
      "collocations_zh": [
        "总结会议",
        "总结"
      ]
    },
    {
      "id": "follow-through",
      "head": "follow through",
      "base": "follow",
      "particle": "through",
      "ipa": "ˈfɑloʊ θru",
      "chip": "office",
      "register": "neutral",
      "separable": false,
      "zh": "落实到底",
      "senses": [
        {
          "zh": "答应的事做完",
          "en": "to complete what you promised",
          "example": {
            "en": "He never follows through on anything he says.",
            "zh": "他说的话从来没有落实过。"
          }
        }
      ],
      "l1_note": "落实是 follow through (on)；follow up 是跟进联系。",
      "confusables": [
        "follow up",
        "carry out"
      ],
      "collocations": [
        "follow through on a promise",
        "follow through with the plan"
      ],
      "collocations_zh": [
        "落实承诺",
        "贯彻计划"
      ]
    },
    {
      "id": "carry-out",
      "head": "carry out",
      "base": "carry",
      "particle": "out",
      "ipa": "ˈkæri aʊt",
      "chip": "office",
      "register": "neutral",
      "separable": true,
      "zh": "执行、实施",
      "senses": [
        {
          "zh": "把决定做出来",
          "en": "to do a plan or task",
          "example": {
            "en": "We carried out the survey over two weeks.",
            "zh": "我们用两周完成了这项调查。"
          }
        }
      ],
