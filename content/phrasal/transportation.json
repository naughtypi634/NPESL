      "particle": "by",
      "ipa": "ˈskwiz baɪ",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "挤过去",
      "senses": [
        {
          "zh": "从缝隙中挤过",
          "en": "to get past by pressing through a small space",
          "example": {
            "en": "Excuse me, can I squeeze by?",
            "zh": "不好意思，能让我挤过去吗？"
          }
        }
      ],
      "l1_note": "挤过去是 squeeze by；挤出时间是 squeeze in。",
      "confusables": [
        "squeeze in",
        "get past"
      ],
      "collocations": [
        "squeeze by on the subway",
        "squeeze by the crowd"
      ]
    },
    {
      "id": "weave-through",
      "head": "weave through",
      "base": "weave",
      "particle": "through",
      "ipa": "ˈwiv θru",
