      "register": "neutral",
      "separable": false,
      "zh": "在……之间穿行",
      "senses": [
        {
          "zh": "绕来绕去穿过",
          "en": "to move in and out between things",
          "example": {
            "en": "The scooter wove through traffic like a video game.",
            "zh": "电动车在车流里钻来钻去。"
          }
        }
      ],
      "l1_note": "穿梭是 weave through，不是 cross through（只是穿过）。",
      "confusables": [
        "cut through",
        "squeeze by"
