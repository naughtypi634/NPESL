{
  "theme": "transportation",
  "entries": [
    {
      "id": "get-in",
      "head": "get in",
      "base": "get",
      "particle": "in",
      "ipa": "ˈɡɛt ɪn",
      "tier": 1,
      "level": "A2",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "上（小）车",
      "senses": [
        {
          "zh": "钻进轿车、出租车、网约车",
          "en": "to enter a car or other small vehicle",
          "example": {
            "en": "Get in — we're blocking the whole lane.",
            "zh": "快上车，我们挡着整条道了。"
          }
        }
      ],
      "l1_note": "小空间用 get in（轿车、网约车），大空间用 get on（地铁、公交、高铁、飞机）。中文都是“上车”，所以这里必错。",
      "confusables": [
        "get on",
        "get off"
      ],
      "collocations": [
        "get in the car",
        "get in a taxi"
      ]
    },
    {
      "id": "get-on",
      "head": "get on",
      "base": "get",
      "particle": "on",
      "ipa": "ˈɡɛt ɑn",
      "tier": 1,
      "level": "A2",
      "chip": "transit",
      "register": "neutral",
      "separable": false,
      "zh": "上（大）车",
      "senses": [
        {
          "zh": "上地铁、公交、高铁、飞机",
          "en": "to board a bus, train, subway, or plane",
          "example": {
            "en": "Get on at Line 2 and transfer at People's Square.",
            "zh": "坐 2 号线，在人民广场换乘。"
          }
        }
      ],
      "l1_note": "中文“坐地铁”会让人漏掉上下车：get on the subway 是上车，take the subway 是乘坐。",
      "confusables": [
        "get in",
        "get off"
      ],
      "collocations": [
        "get on the subway",
        "get on the bus",
        "get on a train"
      ]
    },
    {
      "id": "get-off",
      "head": "get off",
      "base": "get",
      "particle": "off",
      "ipa": "ˈɡɛt ɔf",
      "tier": 1,
      "level": "A2",
      "chip": "transit",
      "register": "neutral",
      "separable": false,
      "zh": "下（车）",
      "senses": [
        {
          "zh": "从交通工具上下来",
          "en": "to leave a bus, train, or plane",
          "example": {
            "en": "Get off at the third stop and you'll see the mall.",
            "zh": "第三站下车就能看到商场。"
          }
        }
      ],
      "l1_note": "下车不是 get down（那是从高处下来）。get off work 才是下班。",
      "confusables": [
        "get on",
        "get down"
      ],
      "collocations": [
        "get off the bus",
        "get off at the next stop",
        "get off work"
      ]
    },
    {
      "id": "get-around",
      "head": "get around",
      "base": "get",
      "particle": "around",
      "ipa": "ˈɡɛt əˈraʊnd",
      "tier": 2,
      "level": "B1",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "出行、四处走动",
      "senses": [
        {
          "zh": "在城市里往来",
          "en": "to travel from place to place in an area",
          "example": {
            "en": "The subway is the fastest way to get around Shanghai.",
            "zh": "在上海出行，地铁最快。"
          }
        }
      ],
      "confusables": [
        "get by",
        "get through"
      ],
      "collocations": [
        "get around town",
        "get around by bike"
      ],
      "l1_note": "出行、四处走动；get around to 是抽空做。"
    },
    {
      "id": "pull-over",
      "head": "pull over",
      "base": "pull",
      "particle": "over",
      "ipa": "ˈpʊl ˈoʊvər",
      "tier": 2,
      "level": "B1",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "靠边停车",
      "senses": [
        {
          "zh": "把车停到路边",
          "en": "to drive to the side of the road and stop",
          "example": {
            "en": "The driver pulled over to check the address on his phone.",
            "zh": "司机靠边停下，看手机上的地址。"
          }
        }
      ],
      "l1_note": "“停车”有三个：pull over 靠边、park 停进车位、stop 停下。中文一个“停车”对应三个词。",
      "confusables": [
        "pull up",
        "park"
      ],
      "collocations": [
        "pull over to the side",
        "pull over and ask"
      ]
    },
    {
      "id": "slow-down",
      "head": "slow down",
      "base": "slow",
      "particle": "down",
      "ipa": "ˈsloʊ daʊn",
      "tier": 1,
      "level": "A2",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "减速；放慢节奏",
      "senses": [
        {
          "zh": "车减速",
          "en": "to drive more slowly",
          "example": {
            "en": "Slow down — there's a speed camera up ahead.",
            "zh": "慢点，前面有测速。"
          }
        },
        {
          "zh": "生活节奏放慢",
          "en": "to do things less fast and with less pressure",
          "example": {
            "en": "You've been working nonstop. Slow down a bit.",
            "zh": "你一直在连轴转，缓一缓吧。"
          }
        }
      ],
      "l1_note": "“慢一点”对车说 slow down，对人说 take it easy；中文的“放慢”两种情况一个词就够，英语要分开。",
      "confusables": [
        "speed up",
        "calm down"
      ],
      "collocations": [
        "slow down the car",
        "slow down a bit"
      ]
    },
    {
      "id": "fill-up",
      "head": "fill up",
      "base": "fill",
      "particle": "up",
      "ipa": "ˈfɪl ʌp",
      "tier": 2,
      "level": "B1",
      "chip": "transit",
      "register": "spoken",
      "separable": true,
      "zh": "加满油；装满",
      "senses": [
        {
          "zh": "给车加满油",
          "en": "to put gas in a car until the tank is full",
          "example": {
            "en": "Let's fill up before we get on the highway.",
            "zh": "上高速前先把油加满。"
          }
        }
      ],
      "l1_note": "“加油”不是 add oil（那是中式英语）。加油是 fill up / get gas。",
      "confusables": [
        "top up",
        "use up"
      ],
      "collocations": [
        "fill up the tank",
        "fill up at the gas station"
      ]
    },
    {
      "id": "run-out-of",
      "head": "run out of",
      "base": "run",
      "particle": "out",
      "ipa": "ˈrʌn aʊt əv",
      "tier": 1,
      "level": "A2",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "用完、耗尽",
      "senses": [
        {
          "zh": "某样东西用完了",
          "en": "to have no more of something",
          "example": {
            "en": "We ran out of gas on the way to the airport.",
            "zh": "我们在去机场的路上把油用完了。"
          }
        }
      ],
      "l1_note": "中文“我没钱了”别说 I have no money 那么生硬，口语是 I ran out of money。",
      "confusables": [
        "use up",
        "run out"
      ],
      "collocations": [
        "run out of time",
        "run out of patience",
        "run out of gas"
      ]
    },
    {
      "id": "watch-out",
      "head": "watch out",
      "base": "watch",
      "particle": "out",
      "ipa": "ˈwɑtʃ aʊt",
      "tier": 1,
      "level": "A2",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "小心、当心",
      "senses": [
        {
          "zh": "提醒有危险",
          "en": "used to warn someone about danger",
          "example": {
            "en": "Watch out — the escalator is packed.",
            "zh": "小心点，扶梯上全是人。"
          }
        }
      ],
      "l1_note": "提醒别人不是 be careful 才地道；watch out 更短更常用，后面接 for 再加对象。",
      "confusables": [
        "look out",
        "be careful"
      ],
      "collocations": [
        "watch out for cars",
        "watch out for pickpockets"
      ]
    },
    {
      "id": "touch-down",
      "head": "touch down",
      "base": "touch",
      "particle": "down",
      "ipa": "ˈtʌtʃ daʊn",
      "chip": "airport",
      "register": "neutral",
      "separable": false,
      "zh": "（飞机）着陆",
      "senses": [
        {
          "zh": "轮子着地",
          "en": "when a plane lands",
          "example": {
            "en": "We touched down twenty minutes late.",
            "zh": "我们晚点二十分钟落地。"
          }
        }
      ],
      "l1_note": "着陆是 touch down（两个词）；land 也对，但 touchdown 是名词。",
      "confusables": [
        "land",
        "take off"
      ],
      "collocations": [
        "the plane touched down",
        "touch down on time"
      ]
    },
    {
      "id": "pull-up-bus",
      "head": "pull up",
      "base": "pull",
      "particle": "up",
      "ipa": "ˈpʊl ʌp",
      "chip": "transit",
      "register": "neutral",
      "separable": false,
      "zh": "（车）停靠",
      "senses": [
        {
          "zh": "车开到某处停下",
          "en": "when a vehicle stops at a place",
          "example": {
            "en": "The bus pulled up right as I got to the stop.",
            "zh": "我刚到站公交就停了。"
          }
        }
      ],
      "l1_note": "停靠是 pull up；pull over 是靠边停，两者位置感不同。",
      "confusables": [
        "pull over",
        "pull in"
      ],
      "collocations": [
        "the bus pulled up",
        "pull up outside"
      ]
    },
    {
      "id": "pull-away",
      "head": "pull away",
      "base": "pull",
      "particle": "away",
      "ipa": "ˈpʊl əˈweɪ",
      "chip": "transit",
      "register": "neutral",
      "separable": false,
      "zh": "（车）开走",
      "senses": [
        {
          "zh": "停下的车启动离开",
          "en": "when a vehicle starts moving away",
          "example": {
            "en": "I ran for it, but the train pulled away.",
            "zh": "我冲过去，车还是开走了。"
          }
        }
      ],
      "l1_note": "开走是 pull away；pull out 是从车位驶出。",
      "confusables": [
        "pull out",
        "drive off"
      ],
      "collocations": [
        "the train pulled away",
        "the car pulled away"
      ]
    },
    {
      "id": "speed-up",
      "head": "speed up",
      "base": "speed",
      "particle": "up",
      "ipa": "ˈspid ʌp",
      "chip": "transit",
      "register": "neutral",
      "separable": false,
      "zh": "加速",
      "senses": [
        {
          "zh": "开快一点",
          "en": "to go faster",
          "example": {
            "en": "Speed up a little — we're going to miss the exit.",
            "zh": "开快点，要错过出口了。"
          }
        }
      ],
      "l1_note": "加速是 speed up；slow down 是减速，成对。",
      "confusables": [
        "slow down",
        "hurry up"
      ],
      "collocations": [
        "speed up on the highway",
        "the train sped up"
      ]
    },
    {
      "id": "stop-over",
      "head": "stop over",
      "base": "stop",
      "particle": "over",
      "ipa": "ˈstɑp ˈoʊvər",
      "chip": "airport",
      "register": "neutral",
      "separable": false,
      "zh": "中途停留",
      "senses": [
        {
          "zh": "长途飞行中途停一站",
          "en": "to stay somewhere briefly during a longer trip",
          "example": {
            "en": "We stopped over in Seoul for six hours.",
            "zh": "我们在首尔中转停留了六小时。"
          }
        }
      ],
      "l1_note": "中途停留是 stop over；名词是 stopover。",
      "confusables": [
        "lay over",
        "stay over"
      ],
      "collocations": [
        "stop over in Tokyo",
        "stop over for a night"
      ]
    },
    {
      "id": "lay-over",
      "head": "lay over",
      "base": "lay",
      "particle": "over",
      "ipa": "ˈleɪ ˈoʊvər",
      "chip": "airport",
      "register": "neutral",
      "separable": false,
      "zh": "（航班）中转等待",
      "senses": [
        {
          "zh": "等下一班飞机",
          "en": "to wait at an airport between flights",
          "example": {
            "en": "We laid over in Dubai for four hours.",
            "zh": "我们在迪拜中转等了四小时。"
          }
        }
      ],
      "l1_note": "lay over 多指航班中转；名词 layover。",
      "confusables": [
        "stop over",
        "wait around"
      ],
      "collocations": [
        "lay over in Dubai",
        "a long layover"
      ]
    },
    {
      "id": "hop-on",
      "head": "hop on",
      "base": "hop",
      "particle": "on",
      "ipa": "ˈhɑp ɑn",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "跳上车",
      "senses": [
        {
          "zh": "短途随便上一下",
          "en": "to get on a vehicle quickly",
          "example": {
            "en": "Hop on the 43 bus — it goes straight there.",
            "zh": "上 43 路，直达。"
          }
        }
      ],
      "l1_note": "hop on 语气轻松，短途常用；正式场合用 get on。",
      "confusables": [
        "get on",
        "hop off"
      ],
      "collocations": [
        "hop on the bus",
        "hop on a bike"
      ]
    },
    {
      "id": "hop-off",
      "head": "hop off",
      "base": "hop",
      "particle": "off",
      "ipa": "ˈhɑp ɔf",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "跳下车",
      "senses": [
        {
          "zh": "很快下车",
          "en": "to get off a vehicle quickly",
          "example": {
            "en": "Hop off at the next stop — the market is right there.",
            "zh": "下一站下，市场就在那儿。"
          }
        }
      ],
      "l1_note": "hop off 口语、短途；正式用 get off。",
      "confusables": [
        "get off",
        "hop on"
      ],
      "collocations": [
        "hop off at the corner",
        "hop off the bus"
      ]
    },
    {
      "id": "pile-in",
      "head": "pile in",
      "base": "pile",
      "particle": "in",
      "ipa": "ˈpaɪl ɪn",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "一窝蜂挤进（车）",
      "senses": [
        {
          "zh": "一群人挤上车",
          "en": "when several people get into a vehicle at once",
          "example": {
            "en": "Six of us piled in and drove to the airport.",
            "zh": "我们六个人一窝蜂挤上车去机场。"
          }
        }
      ],
      "l1_note": "一群人挤进去是 pile in，不是 crowd into（也对但书面）。",
      "confusables": [
        "pile out",
        "get in"
      ],
      "collocations": [
        "pile in the car",
        "everyone piled in"
      ]
    },
    {
      "id": "pile-out",
      "head": "pile out",
      "base": "pile",
      "particle": "out",
      "ipa": "ˈpaɪl aʊt",
      "chip": "transit",
      "register": "spoken",
      "separable": false,
      "zh": "一窝蜂下车",
      "senses": [
        {
          "zh": "一群人涌下车",
          "en": "when several people get out at once",
          "example": {
            "en": "Everyone piled out when the doors opened.",
            "zh": "门一开大家全涌下车。"
          }
        }
      ],
      "l1_note": "pile out 常出现在到站场景。",
      "confusables": [
        "pile in",
        "get off"
      ],
      "collocations": [
        "pile out of the bus",
        "the kids piled out"
      ]
    },
    {
      "id": "crawl-along",
      "head": "crawl along",
      "base": "crawl",
      "particle": "along",
      "ipa": "ˈkrɔl əˈlɔŋ",
      "chip": "transit",
      "register": "neutral",
      "separable": false,
      "zh": "（车流）慢慢挪",
      "senses": [
        {
          "zh": "堵成一串往前蹭",
          "en": "when traffic moves very slowly",
          "example": {
            "en": "We crawled along for an hour on the ring road.",
            "zh": "我们在环路上慢慢挪了一小时。"
          }
        }
      ],
      "l1_note": "车流慢行是 crawl along，不是 move slowly（太泛）。",
      "confusables": [
        "inch along",
        "back up"
      ],
      "collocations": [
        "traffic crawled along",
        "crawl along the highway"
      ]
    },
    {
      "id": "inch-along",
      "head": "inch along",
      "base": "inch",
      "particle": "along",
      "ipa": "ˈɪntʃ əˈlɔŋ",
      "chip": "transit",
      "register": "neutral",
      "separable": false,
      "zh": "一点一点往前挪",
      "senses": [
        {
          "zh": "极慢地前移",
          "en": "to move forward very slowly",
          "example": {
            "en": "The line inched along toward the security gate.",
            "zh": "队伍一点点挪向安检口。"
          }
        }
      ],
      "l1_note": "一寸寸挪是 inch along，比 crawl along 更慢。",
      "confusables": [
        "crawl along",
        "slow down"
      ],
      "collocations": [
        "traffic inched along",
        "inch along the queue"
      ]
    },
    {
      "id": "crash-into",
      "head": "crash into",
      "base": "crash",
      "particle": "into",
      "ipa": "ˈkræʃ ˈɪntu",
      "chip": "transit",
      "register": "neutral",
      "separable": false,
      "zh": "撞上",
      "senses": [
        {
          "zh": "车撞到东西",
          "en": "when a vehicle hits something",
          "example": {
            "en": "He crashed into a pole while checking his phone.",
            "zh": "他看手机时撞上了电线杆。"
          }
        }
      ],
      "l1_note": "撞上是 crash into，不是 hit on（撞到人用 hit）。",
      "confusables": [
        "run into",
        "bump into"
      ],
      "collocations": [
        "crash into a pole",
        "crash into the back of a car"
      ]
    },
    {
      "id": "set-down",
      "head": "set down",
      "base": "set",
      "particle": "down",
      "ipa": "ˈsɛt daʊn",
      "chip": "transit",
      "register": "neutral",
      "separable": true,
      "zh": "让（乘客）下车",
      "senses": [
        {
          "zh": "司机让人下车",
          "en": "when a driver lets passengers get out",
          "example": {
            "en": "The driver set us down at the north gate.",
            "zh": "司机把我们放在北门。"
          }
        }
      ],
      "l1_note": "set down 是让下车；set off 是出发。",
      "confusables": [
        "drop off",
        "let off"
      ],
      "collocations": [
        "set passengers down",
        "set someone down"
      ]
    },
    {
      "id": "squeeze-by",
      "head": "squeeze by",
