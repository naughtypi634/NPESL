{
  "family": "category_value",
  "expressions": [
    {
      "id": "highest",
      "word": "the highest",
      "meaning_zh": "最高",
      "function": "peak",
      "register": "neutral",
      "intensity": "neutral",
      "conditions": {},
      "example_frame": "{top_category} has the highest value in {series}, at {top_value}.",
      "collocations": ["the highest value", "the highest share"],
      "caution_zh": "说的是某个时间点上的最高值，不是“历史最高”。"
    },
    {
      "id": "lowest",
      "word": "the lowest",
      "meaning_zh": "最低",
      "function": "peak",
      "register": "neutral",
      "intensity": "neutral",
      "conditions": {},
      "example_frame": "{bottom_category} has the lowest value in {series}, at {bottom_value}.",
      "collocations": ["the lowest value", "the lowest point"],
      "caution_zh": "和 the highest 成对使用，注意别写成 the most low。"
    },
    {
      "id": "higher-than",
      "word": "higher than",
      "meaning_zh": "高于",
      "function": "compare",
      "register": "neutral",
      "intensity": "neutral",
      "conditions": { "gap_min": 1 },
      "example_frame": "{top_category} is {gap} points higher than {bottom_category} in {series}.",
      "collocations": ["higher than", "slightly higher than", "much higher than"],
      "caution_zh": "百分点差距用 points，不用 percent。"
    },
    {
      "id": "slightly-higher",
      "word": "slightly higher than",
      "meaning_zh": "略高于",
      "function": "compare",
      "register": "neutral",
      "intensity": "slight",
      "conditions": { "gap_ratio_max": 0.08 },
      "example_frame": "{pair_a} is slightly higher than {pair_b} in {series}.",
      "collocations": ["slightly higher than", "a little higher than"],
      "caution_zh": "只用于差距很小的情况；差距大时用 much higher。"
    },
    {
      "id": "nearly-twice",
      "word": "nearly twice",
      "meaning_zh": "接近两倍",
      "function": "compare",
      "register": "neutral",
      "intensity": "sharp",
      "conditions": { "ratio_min": 1.8, "ratio_max": 2.2 },
      "example_frame": "{ratio_a} is nearly twice {ratio_b} in {series}.",
      "collocations": ["nearly twice as high as", "about twice"],
      "caution_zh": "只有比例真的接近 2 倍时才用；1.3 倍不能叫 nearly twice。"
    },
    {
      "id": "biggest-increase",
      "word": "the biggest increase",
      "meaning_zh": "最大增幅",
      "function": "up",
      "register": "neutral",
      "intensity": "neutral",
      "conditions": {},
      "example_frame": "{increase_category} posted the biggest increase, from {increase_from} in {from_period} to {increase_to} in {to_period}.",
      "collocations": ["the biggest increase", "the largest rise"],
      "caution_zh": "比较的是变化量，不是最终数值；最终最高不等于增幅最大。"
    },
    {
      "id": "smallest-change",
      "word": "the smallest change",
      "meaning_zh": "最小变化",
      "function": "flat",
      "register": "neutral",
      "intensity": "slight",
      "conditions": {},
      "example_frame": "{small_category} changed the least, from {small_from} in {from_period} to {small_to} in {to_period}.",
      "collocations": ["the smallest change", "changed the least"],
      "caution_zh": "变化小不等于没有变化；说的时候最好带上两个数字。"
    }
  ]
}
