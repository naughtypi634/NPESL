        },
        {
          "en": "be at",
          "zh": "是",
          "register": "spoken",
          "grammar": "be at + 数值",
          "collocations": [
            "is at 5,600 yuan"
          ],
          "note_zh": "口语最简。"
        },
        {
          "en": "reach",
          "zh": "达到",
          "register": "neutral",
          "grammar": "及物动词；reach + 数值",
          "collocations": [
            "reaches 5,600 yuan",
            "reach 12 percent"
          ],
          "note_zh": "中性；强调到达某个水平。"
        },
        {
          "en": "come in at",
          "zh": "达到",
          "register": "spoken",
          "grammar": "come in at + 数值",
          "collocations": [
            "comes in at 5,600 yuan"
          ],
          "note_zh": "口语/商务，常指成本或价格。"
        }
      ],
      "patterns": [
        {
          "id": "bar-it-a2",
          "level": "a2",
          "register": "spoken",
          "frame": "{category} is at {value}.",
          "zh_frame": "{category}为 {value}。",
          "note_zh": "最简单的单值句。"
        },
        {
          "id": "bar-it-b1",
          "level": "b1",
          "register": "written",
          "frame": "{category} stood at {value}.",
          "zh_frame": "{category}为 {value}。",
          "note_zh": "stand at 的过去式 stood。"
