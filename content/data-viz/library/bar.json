{
  "type": "bar",
  "features": {
    "highest": {
      "label_zh": "最高值",
      "requires": [
        "category",
        "value",
        "top_category",
        "top_value"
      ],
      "words": [
        {
          "en": "the highest",
          "zh": "最高的",
          "register": "neutral",
          "grammar": "the highest + 名词 + at + 数值",
          "collocations": [
            "the highest rent",
            "the highest value"
          ],
          "note_zh": "形容数值或水平；人数最多用 the most。"
        },
        {
          "en": "top",
          "zh": "居首的",
          "register": "spoken",
          "grammar": "top + 名词 / top the list",
          "collocations": [
            "the top district",
            "top the ranking"
          ],
          "note_zh": "口语常用，暗示排名第一。"
        },
        {
          "en": "lead",
          "zh": "领先",
          "register": "written",
          "grammar": "lead + 名词 / lead the group",
          "collocations": [
            "lead the group",
            "lead by 1,400 yuan"
          ],
          "note_zh": "书面，强调与第二名的差距。"
        },
        {
          "en": "come first",
          "zh": "排在第一位",
          "register": "neutral",
          "grammar": "come first / come top",
          "collocations": [
            "comes first in the ranking"
          ],
          "note_zh": "中性；比 rank first 口语。"
        }
      ],
      "patterns": [
        {
          "id": "bar-hi-a2",
          "level": "a2",
          "register": "spoken",
          "frame": "{category} is the highest, at {value}.",
          "zh_frame": "{category}最高，为 {value}。",
          "note_zh": "the highest 后不重复名词也可以。"
        },
        {
          "id": "bar-hi-b1",
          "level": "b1",
          "register": "written",
          "frame": "{category} had the highest figure, at {value}.",
          "zh_frame": "{category}的数值最高，为 {value}。",
          "note_zh": "figure 指图表里的数值，很常用。"
        }
      ],
      "compare": [
        "highest-vs-most",
        "rank-vs-rate"
      ],
      "traps": [
        {
          "wrong_en": "This bar is the most high.",
          "right_en": "This bar is the highest.",
          "why_zh": "high 的最高级是 highest，不是 most high。"
        }
      ],
      "registers": {
        "general": "{category} is the highest, at {value}.",
        "ielts": "{category} recorded the highest figure, at {value}.",
        "business": "{category} leads the group at {value}."
      }
    },
    "lowest": {
      "label_zh": "最低值",
      "requires": [
        "category",
        "value"
      ],
      "words": [
        {
          "en": "the lowest",
          "zh": "最低的",
          "register": "neutral",
          "grammar": "the lowest + 名词 + at + 数值",
          "collocations": [
            "the lowest rent",
            "the lowest value"
          ],
          "note_zh": "形容数值；人数最少用 the fewest。"
        },
        {
          "en": "bottom",
          "zh": "垫底的",
          "register": "spoken",
          "grammar": "bottom of + 名词 / bottom the list",
          "collocations": [
            "at the bottom of the ranking"
          ],
          "note_zh": "口语，暗示排名最后。"
        },
        {
          "en": "come last",
          "zh": "排在最后",
          "register": "neutral",
          "grammar": "come last",
          "collocations": [
            "comes last in the group"
          ],
          "note_zh": "中性，直接说排名。"
        },
        {
          "en": "trail",
          "zh": "落后",
          "register": "written",
          "grammar": "trail + 名词 / trail by + 数值",
          "collocations": [
            "trail the leader by 4,300 yuan"
          ],
          "note_zh": "书面，强调与领先者的差距。"
        }
      ],
      "patterns": [
        {
          "id": "bar-lo-a2",
          "level": "a2",
          "register": "spoken",
          "frame": "{category} is the lowest, at {value}.",
          "zh_frame": "{category}最低，为 {value}。",
          "note_zh": "最简单的最低值句。"
        },
        {
          "id": "bar-lo-b1",
          "level": "b1",
          "register": "written",
          "frame": "{category} had the lowest figure, at {value}.",
          "zh_frame": "{category}的数值最低，为 {value}。",
          "note_zh": "figure 可替换 value。"
        }
      ],
      "compare": [
        "highest-vs-most",
        "gap-vs-difference"
      ],
      "traps": [
        {
          "wrong_en": "This bar is the lowest one of all.",
          "right_en": "This bar is the lowest of all.",
          "why_zh": "lowest 后直接接 of all，不加 one。"
        }
      ],
      "registers": {
        "general": "{category} is the lowest, at {value}.",
        "ielts": "{category} recorded the lowest figure, at {value}.",
        "business": "{category} trails the group at {value}."
      }
    },
    "large_gap": {
      "label_zh": "明显差距",
      "requires": [
        "category",
        "value",
        "gap",
        "top_category",
        "top_value"
      ],
      "words": [
        {
          "en": "a wide gap",
          "zh": "很大差距",
          "register": "neutral",
          "grammar": "a wide gap between X and Y",
          "collocations": [
            "a wide gap between the top two",
            "a gap of 4,300 yuan"
          ],
          "note_zh": "gap 可数；说差距大小用 wide / narrow。"
        },
        {
          "en": "far ahead",
          "zh": "遥遥领先",
          "register": "spoken",
          "grammar": "far ahead of + 名词",
          "collocations": [
            "far ahead of the next district"
          ],
          "note_zh": "口语，强调领先幅度。"
        },
        {
          "en": "more than double",
          "zh": "两倍多",
          "register": "neutral",
          "grammar": "more than double + 名词",
          "collocations": [
            "more than double the next value"
          ],
          "note_zh": "用于约两倍的差距。"
        },
        {
          "en": "a clear lead",
          "zh": "明显领先",
          "register": "written",
          "grammar": "have a clear lead over + 名词",
          "collocations": [
            "a clear lead over the runner-up"
          ],
          "note_zh": "书面，常配 runner-up（第二名）。"
        }
      ],
      "patterns": [
        {
          "id": "bar-lg-a2",
          "level": "a2",
          "register": "spoken",
          "frame": "{category} is far ahead of the others, at {value}.",
          "zh_frame": "{category}明显领先，为 {value}。",
          "note_zh": "far ahead of 是固定搭配。"
        },
        {
          "id": "bar-lg-b1",
          "level": "b1",
          "register": "written",
          "frame": "There is a gap of {gap} between {top_category} and {category}.",
          "zh_frame": "{top_category}和{category}之间有 {gap} 的差距。",
          "note_zh": "a gap of + 数值 + between…and…。"
        }
      ],
      "compare": [
        "gap-vs-difference"
      ],
      "traps": [
        {
          "wrong_en": "The gap is 4,300 yuan big.",
          "right_en": "The gap is 4,300 yuan.",
          "why_zh": "数值后不加 big。"
        }
      ],
      "registers": {
        "general": "{category} is far ahead, at {value}.",
        "ielts": "{top_category} led {category} by {gap}.",
        "business": "{top_category} holds a clear lead of {gap} over {category}."
      }
    },
    "small_gap": {
      "label_zh": "差距很小",
      "requires": [
        "category",
        "value",
        "gap",
        "top_category",
        "top_value"
      ],
      "words": [
        {
          "en": "close",
          "zh": "接近",
          "register": "spoken",
          "grammar": "close to + 名词 / in value",
          "collocations": [
            "close to the top value",
            "the two are close"
          ],
          "note_zh": "口语最常用。"
        },
        {
          "en": "a narrow gap",
          "zh": "很小差距",
          "register": "neutral",
          "grammar": "a narrow gap between X and Y",
          "collocations": [
            "a narrow gap of 400 yuan"
          ],
          "note_zh": "和 wide gap 相对。"
        },
        {
          "en": "only slightly higher",
          "zh": "只略高",
          "register": "written",
          "grammar": "only slightly + 比较级",
          "collocations": [
            "only slightly higher than"
          ],
          "note_zh": "书面，强调差距小。"
        },
        {
          "en": "almost level",
          "zh": "几乎持平",
          "register": "written",
          "grammar": "almost level with + 名词",
          "collocations": [
            "almost level with the leader"
          ],
          "note_zh": "暗示差距可以忽略。"
        }
      ],
      "patterns": [
        {
          "id": "bar-sg-a2",
          "level": "a2",
          "register": "spoken",
          "frame": "{category} and {top_category} are close: {value} versus {top_value}.",
          "zh_frame": "{category}和{top_category}很接近：{value} 对 {top_value}。",
          "note_zh": "versus 表示对比。"
        },
        {
          "id": "bar-sg-b1",
          "level": "b1",
          "register": "written",
          "frame": "The gap between {top_category} and {category} is only {gap}.",
          "zh_frame": "{top_category}和{category}之间的差距只有 {gap}。",
          "note_zh": "only 强调差距小。"
        }
      ],
      "compare": [
        "gap-vs-difference",
        "highest-vs-most"
      ],
      "traps": [
        {
          "wrong_en": "Coffee is near to tea.",
          "right_en": "Coffee is close to tea.",
          "why_zh": "语法上 near 不接 to；close to 才是固定搭配。"
        }
      ],
      "registers": {
        "general": "{category} and {top_category} are close: {value} against {top_value}.",
        "ielts": "{category} was only {gap} below {top_category}, at {value}.",
        "business": "{category} is almost level with {top_category}, just {gap} behind."
      }
    },
    "ranking": {
      "label_zh": "排名",
      "requires": [
        "category",
        "value",
        "rank"
      ],
      "words": [
        {
          "en": "rank",
          "zh": "排名",
          "register": "neutral",
          "grammar": "rank + 序数词 / rank third",
