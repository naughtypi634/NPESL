      "registers": {
        "general": "{category} is {value}, much higher than {top_category}.",
        "ielts": "{category} stood at {value}, compared with {top_value} for {top_category}.",
        "business": "{category} sits well above {top_category}: {value} against {top_value}."
      }
    },
    "item": {
      "label_zh": "单项数值",
      "requires": [
        "category",
        "value"
      ],
      "words": [
        {
          "en": "stand at",
          "zh": "为",
          "register": "written",
          "grammar": "stand at + 数值",
