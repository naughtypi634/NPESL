          "grammar": "there is little difference between X and Y",
          "collocations": [
            "little difference between the two"
          ],
          "note_zh": "书面；little 表示几乎没有。"
        }
      ],
      "patterns": [
        {
          "id": "bar-sv-a2",
          "level": "a2",
          "register": "spoken",
          "frame": "The values are about the same: {value} for {category}.",
          "zh_frame": "数值差不多：{category}为 {value}。",
          "note_zh": "about the same 后接数值。"
        },
        {
          "id": "bar-sv-b1",
          "level": "b1",
          "register": "written",
          "frame": "There is little difference between the categories, with {category} at {value}.",
          "zh_frame": "各类别差别不大，{category}为 {value}。",
          "note_zh": "little difference 比 no difference 留有余地。"
        }
      ],
      "compare": [
        "gap-vs-difference",
        "highest-vs-most"
      ],
      "traps": [
        {
          "wrong_en": "The values are same.",
          "right_en": "The values are the same.",
          "why_zh": "same 前必须加 the。"
        }
      ],
      "registers": {
        "general": "The values are about the same; {category} is at {value}.",
        "ielts": "The categories were broadly similar, with {category} at {value}.",
        "business": "There is little to separate the categories; {category} sits at {value}."
