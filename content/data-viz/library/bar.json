        },
        {
          "id": "bar-rk-b1",
          "level": "b1",
          "register": "written",
          "frame": "{category} ranks {rank}, with a figure of {value}.",
          "zh_frame": "{category}排第 {rank}，数值为 {value}。",
          "note_zh": "rank + 序数词，不加 the。"
