      "registers": {
        "general": "{category} is {value}.",
        "ielts": "{category} stood at {value}.",
        "business": "{category} comes in at {value}."
      }
    }
  },
  "comparisons": [
    {
      "id": "highest-vs-most",
      "a": "highest",
      "b": "most",
      "meaning_zh": "highest 指水平或数值最高；most 指数量最多。",
      "grammar_zh": "the highest + 可数/不可数名词；the most + 可数名词复数",
      "collocations_zh": "the highest rent / the most orders",
      "usage_zh": "rate、share、price 用 highest；orders、people、cups 用 most。",
      "examples": [
        {
          "en": "The district has the highest rent and the most coffee shops.",
          "zh": "这个区租金最高，咖啡店也最多。"
        }
      ]
    },
    {
      "id": "gap-vs-difference",
      "a": "gap",
      "b": "difference",
      "meaning_zh": "gap 强调两者之间的空间或落差；difference 更中性，任何差异都可用。",
      "grammar_zh": "a gap of + 数值 + between X and Y；the difference between X and Y",
      "collocations_zh": "a wide gap / a small difference",
      "usage_zh": "比较两个水平、名次或收入时 gap 更有画面；一般差异用 difference。",
      "examples": [
        {
          "en": "The gap between the top two is 400 yuan, a small difference in this market.",
          "zh": "前两名相差 400 元，在这个市场里算小差别。"
        }
      ]
    },
    {
      "id": "rank-vs-rate",
      "a": "rank",
      "b": "rate",
      "meaning_zh": "rank 是名次；rate 是比率或速度。",
      "grammar_zh": "rank + 序数词；a rate of + 数值",
      "collocations_zh": "ranks second / a growth rate of 12 percent",
      "usage_zh": "说名次用 rank；说百分比、速度用 rate。",
      "examples": [
        {
          "en": "It ranks second, with a growth rate of 35 percent.",
          "zh": "它排第二，增长率为 35%。"
        }
      ]
    },
    {
      "id": "compared-with-vs-compared-to",
      "a": "compared with",
      "b": "compared to",
      "meaning_zh": "两者都可表示“与……相比”；compared with 更常用于同类数据比较，compared to 常暗示比喻。",
      "grammar_zh": "compared with/to + 名词",
      "collocations_zh": "compared with last year / compared to a decade ago",
      "usage_zh": "图表数据对比优先用 compared with；避免在同一段混用。",
      "examples": [
        {
