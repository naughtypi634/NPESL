          "zh": "明显低于",
          "register": "written",
          "grammar": "well below + 名词/数值",
          "collocations": [
            "well below the top group"
          ],
          "note_zh": "与 well above 相对。"
        },
        {
          "en": "on the other hand",
          "zh": "另一方面",
          "register": "spoken",
          "grammar": "句子连接语",
          "collocations": [
            "on the other hand, the outer districts"
          ],
