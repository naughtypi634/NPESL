        }
      ],
      "patterns": [
        {
          "id": "bar-cg-a2",
          "level": "a2",
          "register": "spoken",
          "frame": "{category} is {value}, much higher than {top_category}.",
          "zh_frame": "{category}为 {value}，比 {top_category} 高得多。",
          "note_zh": "much + 比较级 表示差距大。"
        },
        {
          "id": "bar-cg-b1",
          "level": "b1",
          "register": "written",
          "frame": "{category} stood at {value}, compared with {top_value} for {top_category}.",
