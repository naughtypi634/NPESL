/* 主题：浅色 / 深色，材质是 coss ui（平、单色、细边）。
   页面根节点挂 `theme-<id>`，所有颜色、圆角、边框、阴影都从 CSS 变量走，
   所以换主题不需要改页面结构。默认浅色。
   WXSS 不支持 color-mix()，所以这里的值都是算好的字面色，和
   apps/site/theme.css 的 coss 令牌一一对应（改配色时两边一起改）。 */

page {
  background: #ffffff;
}

.app {
  min-height: 100vh;
  background-color: var(--bg);
  color: var(--fg);
  font-family: var(--font);

  /* 浅色：白底近黑字 */
  --bg: #ffffff;
  --fg: #262626;
  --muted: #686868;
  --rule: rgba(0, 0, 0, 0.08);
  --rail: #fafafa;
  --surface: #ffffff;
  --surface-strong: #f5f5f5;
  --primary: #262626;
  --primary-hover: #171717;
  --primary-tint: rgba(0, 0, 0, 0.04);
  --on-primary: #fafafa;
  --danger: #b91c1c;
  --hairline: inset 0 1px 0 rgba(0, 0, 0, 0.04);
  --font: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Microsoft YaHei", "Segoe UI", sans-serif;
  --r-card: 16px;
  --r-ctl: 10px;
  --r-pill: 10px;
  --bd: 1rpx;
  --shadow: 0 1px 2px rgba(0, 0, 0, 0.04);

  -webkit-font-smoothing: antialiased;
}

.theme-light {
  --bg: #ffffff;
  --fg: #262626;
  --muted: #686868;
  --rule: rgba(0, 0, 0, 0.08);
  --rail: #fafafa;
  --surface: #ffffff;
  --surface-strong: #f5f5f5;
  --primary: #262626;
  --primary-hover: #171717;
  --primary-tint: rgba(0, 0, 0, 0.04);
  --on-primary: #fafafa;
  --danger: #b91c1c;
  --hairline: inset 0 1px 0 rgba(0, 0, 0, 0.04);
  --shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
}

.theme-dark {
  --bg: #141414;
  --fg: #f5f5f5;
  --muted: #818181;
  --rule: rgba(255, 255, 255, 0.06);
  --rail: rgba(255, 255, 255, 0.08);
  --surface: #191919;
  --surface-strong: rgba(255, 255, 255, 0.08);
  --primary: #f5f5f5;
  --primary-hover: #ffffff;
  --primary-tint: rgba(255, 255, 255, 0.08);
  --on-primary: #262626;
  --danger: #f87171;
  --hairline: inset 0 -1px 0 rgba(255, 255, 255, 0.06);
  --shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
}

.wrap {
  padding: 0 40rpx calc(env(safe-area-inset-bottom) + 220rpx);
}

/* 吸顶返回条：右侧给微信胶囊让位；按钮纵向和胶囊居中对齐。 */
.bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 200rpx 0 40rpx;
  background: transparent;
}

.bar-back {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 64rpx;
  padding: 0 26rpx 0 20rpx;
  border: var(--bd) solid var(--rule);
  border-radius: var(--r-pill);
  background: var(--surface);
  color: var(--fg);
  font-size: 27rpx;
  line-height: 1;
}

.bar-back-hover {
  background: var(--surface-strong);
}

.bar-chevron {
  width: 22rpx;
  height: 22rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
  margin-right: 6rpx;
}
