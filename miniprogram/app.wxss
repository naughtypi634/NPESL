/* 主题：明亮、暗黑、Glass、Brutalist、Editorial。
   页面根节点挂 `theme-<id>`，所有颜色、圆角、边框、阴影都从 CSS 变量走，
   所以换主题不需要改页面结构。默认 Glass（墨绿 + 薄荷 + 极光）。 */

page {
  background: #0e1418;
}

.app {
  min-height: 100vh;
  background-color: var(--bg);
  background-image: var(--art, none);
  color: var(--fg);
  font-family: var(--font);

  --bg: #0e1418;
  --fg: #eef3f4;
  --muted: #a3b0b6;
  --rule: rgba(238, 243, 244, 0.12);
  --rail: rgba(24, 34, 39, 0.52);
  --surface: rgba(24, 34, 39, 0.76);
  --surface-strong: #172126;
  --mint: #5cc8b6;
  --mint-hover: #8bdccd;
  --mint-tint: rgba(92, 200, 182, 0.14);
  --on-mint: #08211c;
  --peach-soft: rgba(240, 169, 132, 0.14);
  --mint-soft: rgba(127, 214, 194, 0.12);
  --lav-soft: rgba(183, 169, 227, 0.14);
  --art:
    radial-gradient(920rpx 560rpx at 92% -8%, var(--peach-soft), transparent 62%),
    radial-gradient(760rpx 520rpx at -12% 16%, var(--mint-soft), transparent 58%),
    radial-gradient(760rpx 540rpx at 58% 108%, var(--lav-soft), transparent 62%);
  --font: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Microsoft YaHei", "Segoe UI", sans-serif;
  --r-card: 12px;
  --r-ctl: 8px;
  --r-pill: 999px;
  --bd: 1rpx;
  --shadow: 0 20px 50px -30px rgba(0, 0, 0, 0.65);

  -webkit-font-smoothing: antialiased;
}

.theme-bright {
  --bg: #ffffff;
  --fg: #1d1d1f;
  --muted: #66666c;
  --rule: #e0e0e0;
  --rail: #f2f2f4;
  --surface: #f5f5f7;
  --surface-strong: #e8e8ed;
  --mint: #0066cc;
  --mint-hover: #005bb8;
  --mint-tint: #e8f2ff;
  --on-mint: #ffffff;
  --art: none;
  --r-card: 14px;
  --r-ctl: 10px;
  --shadow: 0 1px 3px rgba(0, 0, 0, 0.07);
}

.theme-dark {
  --bg: #000000;
  --fg: #f5f5f7;
  --muted: #98989d;
  --rule: #38383a;
  --rail: #1c1c1e;
  --surface: #1c1c1e;
  --surface-strong: #2c2c2e;
  --mint: #2997ff;
  --mint-hover: #40a9ff;
  --mint-tint: rgba(41, 151, 255, 0.16);
  --on-mint: #06131f;
  --art: none;
  --r-card: 14px;
  --r-ctl: 10px;
  --shadow: none;
}

.theme-brutal {
  --bg: #f2ecdf;
  --fg: #141008;
  --muted: #6b6458;
  --rule: #141008;
  --rail: #e6dfcd;
  --surface: #fffdf6;
  --surface-strong: #f7f1e2;
  --mint: #b8381a;
  --mint-hover: #c9441f;
  --mint-tint: #fff0b8;
  --on-mint: #ffffff;
  --art: none;
  --r-card: 8px;
  --r-ctl: 6px;
  --r-pill: 6px;
  --bd: 2px;
  --shadow: 5px 5px 0 var(--fg);
}

.theme-editorial {
  --bg: #f6f5f1;
  --fg: #151412;
  --muted: #615e57;
  --rule: #d7d3c9;
  --rail: #e7e3d8;
  --surface: #efede6;
  --surface-strong: #e4e0d5;
  --mint: #b02a1a;
  --mint-hover: #c83422;
  --mint-tint: #f1e3dc;
  --on-mint: #ffffff;
  --art: none;
  --font: "Songti SC", "Noto Serif SC", Georgia, serif;
  --r-card: 0px;
  --r-ctl: 0px;
  --r-pill: 0px;
  --shadow: none;
}

.wrap {
  padding: 0 40rpx calc(env(safe-area-inset-bottom) + 220rpx);
}

/* 吸顶返回条：右侧给微信胶囊让位；按钮纵向和胶囊居中对齐。 */
.bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 200rpx 0 40rpx;
  background: transparent;
}

.bar-back {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 64rpx;
  padding: 0 26rpx 0 20rpx;
  border: var(--bd) solid var(--rule);
  border-radius: var(--r-pill);
  background: var(--surface);
  color: var(--fg);
  font-size: 27rpx;
  line-height: 1;
}

.bar-back-hover {
  background: var(--surface-strong);
}

.bar-chevron {
  width: 22rpx;
  height: 22rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
  margin-right: 6rpx;
}
