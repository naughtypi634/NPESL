<view class="float">
  <view class="voice" wx:if="{{voice}}">
    <view class="v {{voice === 'f' ? 'on' : ''}}" data-v="f" catchtap="setVoice">女</view>
    <view class="v {{voice === 'm' ? 'on' : ''}}" data-v="m" catchtap="setVoice">男</view>
  </view>

  <view class="theme">
    <view class="panel" wx:if="{{open}}">
      <view class="opt" wx:for="{{themes}}" wx:key="id" data-id="{{item.id}}" catchtap="pick">
        <view class="sw sw-{{item.id}}"></view>
        <text class="opt-label">{{item.label}}</text>
        <text class="tick" wx:if="{{item.id === theme}}">✓</text>
      </view>
    </view>

    <view class="fab" catchtap="togglePanel">
      <view class="ico">
        <view class="ico-half"></view>
      </view>
    </view>
  </view>
</view>

<view class="left" wx:if="{{active || all}}">
  <view class="playback">
    <view class="pb all {{allOn ? 'on' : ''}}" wx:if="{{all}}" catchtap="toggleAll">{{allOn ? '停止' : '连播'}}</view>
    <view class="pb" wx:if="{{active}}" catchtap="replay">
      <text class="replay-ico">↺</text>
    </view>
    <view class="pb" wx:if="{{playing || paused}}" catchtap="pause">
      <view class="tri" wx:if="{{paused}}"></view>
      <view class="pause-ico" wx:else>
        <view class="bar"></view>
        <view class="bar"></view>
      </view>
    </view>
  </view>
</view>
