.float {
  position: fixed;
  right: 36rpx;
  bottom: 220rpx;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 28rpx;
}

.left {
  position: fixed;
  left: 36rpx;
  bottom: 220rpx;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
}


/* 主题按钮：一半黑一半白的圆，是「外观 / 主题」的通用记号。 */
.fab {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border: var(--bd) solid var(--rule);
  border-radius: 50%;
  background: var(--surface);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
}

.ico {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid var(--fg);
  border-radius: 50%;
  overflow: hidden;
}

.ico-half {
  position: absolute;
  left: 0;
  top: 0;
  width: 50%;
  height: 100%;
  background: var(--fg);
}

.theme {
  position: relative;
}

/* 面板从按钮左侧展开，不压住上面的按钮。 */
.panel {
  position: absolute;
  right: calc(100% + 20rpx);
  bottom: 0;
  min-width: 260rpx;
  padding: 10rpx;
  border: var(--bd) solid var(--rule);
  border-radius: var(--r-card);
  background: var(--bg);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
}

.opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 16rpx;
  border-radius: var(--r-ctl);
}

.opt-label {
  flex: 1;
  font-size: 27rpx;
  white-space: nowrap;
}

.tick {
  color: var(--mint);
  font-size: 26rpx;
}

.sw {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  border: 1rpx solid var(--rule);
  border-radius: 50%;
}

.sw-bright {
  background: #ffffff;
}

.sw-dark {
  background: #000000;
}

.sw-glass {
  background: linear-gradient(135deg, #f0a984 0 14%, #0e1418 14% 52%, #5cc8b6 52% 70%, #172126 70%);
}

.sw-brutal {
  background: linear-gradient(135deg, #f2ecdf 0 46%, #ffe45e 46% 68%, #141008 68% 100%);
}

.sw-editorial {
  background: #f6f5f1;
}

.voice {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  box-sizing: border-box;
  width: 84rpx;
  padding: 6rpx;
  border: var(--bd) solid var(--rule);
  border-radius: 28rpx;
  background: var(--surface);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
}

.v {
  width: 100%;
  padding: 14rpx 0;
  border-radius: 22rpx;
  font-size: 26rpx;
  text-align: center;
  color: var(--muted);
}

.v.on {
  background: var(--mint-tint);
  color: var(--mint);
  font-weight: 600;
}

.playback {
  display: flex;
  gap: 20rpx;
}

.pb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border: var(--bd) solid var(--rule);
  border-radius: 50%;
  background: var(--surface);
  color: var(--fg);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
}

.all {
  width: auto;
  padding: 0 26rpx;
  border-radius: 42rpx;
  font-size: 24rpx;
}

.all.on {
  background: var(--mint-tint);
  color: var(--mint);
  font-weight: 600;
}

.replay-ico {
  font-size: 36rpx;
  line-height: 1;
}

.pause-ico {
  display: flex;
  gap: 8rpx;
}

.pause-ico .bar {
  width: 8rpx;
  height: 28rpx;
  border-radius: 2rpx;
  background: var(--fg);
}

.tri {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 11rpx solid transparent;
  border-bottom: 11rpx solid transparent;
  border-left: 17rpx solid var(--fg);
}
