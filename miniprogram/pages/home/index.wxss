.home {
  padding-top: 100px;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 72rpx;
}

.brand {
  font-size: 26rpx;
  letter-spacing: 6rpx;
  color: var(--mint);
}

.title {
  font-size: 76rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 36rpx;
  border: var(--bd) solid var(--rule);
  border-radius: var(--r-card);
  background: var(--surface);
  box-shadow: var(--shadow);
}

.card-hover {
  background: var(--surface-strong);
}

.card-zh {
  font-size: 38rpx;
  font-weight: 600;
}

.card-chevron {
  width: 18rpx;
  height: 18rpx;
  border-top: 3rpx solid var(--muted);
  border-right: 3rpx solid var(--muted);
  transform: rotate(45deg);
}
