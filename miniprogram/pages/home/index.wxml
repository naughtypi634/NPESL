<view class="app theme-{{theme}}">
<view class="wrap home" style="padding-top:{{topPad}}px">
  <view class="hero">
    <text class="brand">NPESL</text>
    <text class="title">Pronunciation</text>
  </view>

  <view class="cards">
    <navigator class="card" hover-class="card-hover" url="/pages/ipa/index">
      <text class="card-zh">美式英语音标表</text>
      <view class="card-chevron"></view>
    </navigator>

    <navigator class="card" hover-class="card-hover" url="/pages/phonics/index">
      <text class="card-zh">自然拼读练习</text>
      <view class="card-chevron"></view>
    </navigator>

    <navigator class="card" hover-class="card-hover" url="/pages/phenomena/index">
      <text class="card-zh">常见发音现象</text>
      <view class="card-chevron"></view>
    </navigator>
  </view>
</view>
<float-tools bind:theme="onTheme" />
</view>
