<view class="app theme-{{theme}}">
<view class="bar" style="padding-top:{{nav.top}}px">
  <view class="bar-back" style="height:{{nav.height}}px" hover-class="bar-back-hover" bindtap="goBack">
    <view class="bar-chevron"></view>
    <text>返回</text>
  </view>
</view>

<view class="wrap" style="padding-top:{{topPad}}px">
  <scroll-view class="chips" scroll-x enable-flex>
    <view
      class="chip {{filter === item.id ? 'on' : ''}}"
      wx:for="{{chips}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="setFilter"
    >{{item.label}}</view>
  </scroll-view>

  <view class="group" wx:for="{{groups}}" wx:for-item="group" wx:key="title" wx:if="{{filter === 'all' || filter === group.title}}">
    <text class="group-title">{{group.title}}</text>

    <view class="list">
      <view
        class="row"
        hover-class="row-hover"
        wx:for="{{group.chapters}}"
        wx:for-item="chapter"
        wx:key="num"
        data-num="{{chapter.num}}"
        bindtap="open"
      >
        <view class="row-main">
          <text class="en">{{chapter.en}}</text>
          <text class="zh">{{chapter.zh}}</text>
        </view>
        <text class="tag" wx:if="{{chapter.tag}}">{{chapter.tag}}</text>
      </view>
    </view>
  </view>
</view>

<float-tools bind:theme="onTheme" />
</view>
