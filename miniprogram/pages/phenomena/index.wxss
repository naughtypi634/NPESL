.list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border: var(--bd) solid var(--rule);
  border-radius: var(--r-card);
  background: var(--surface);
  box-shadow: var(--shadow);
}

.row-hover {
  background: var(--surface-strong);
}

.row-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.chips {
  display: flex;
  height: 72rpx;
  margin-bottom: 32rpx;
  white-space: nowrap;
}

.chip {
  flex: none;
  padding: 12rpx 26rpx;
  margin-right: 12rpx;
  border: var(--bd) solid var(--rule);
  border-radius: var(--r-pill);
  background: var(--surface);
  color: var(--muted);
  font-size: 24rpx;
}

.chip.on {
  background: var(--mint-tint);
  color: var(--mint);
  font-weight: 600;
}

.group {
  margin-bottom: 56rpx;
}

.group-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.tag {
  flex: none;
  max-width: 320rpx;
  padding: 6rpx 18rpx;
  border: var(--bd) solid var(--rule);
  border-radius: var(--r-pill);
  background: var(--rail);
  color: var(--mint);
  font-size: 22rpx;
  text-align: center;
}

.en {
  font-size: 32rpx;
  font-weight: 600;
}

.zh {
  font-size: 24rpx;
  color: var(--muted);
}

