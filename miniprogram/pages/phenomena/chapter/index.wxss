.head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 16rpx 0 36rpx;
}

.kind {
  align-self: flex-start;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  background: var(--mint-tint);
  color: var(--mint);
  font-size: 22rpx;
}

.title-en {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
}

.title-zh {
  font-size: 26rpx;
  color: var(--muted);
}

.targets {
  margin-bottom: 32rpx;
}

.target {
  position: relative;
  padding: 28rpx 28rpx 28rpx 96rpx;
  margin-bottom: 16rpx;
  border: var(--bd) solid var(--rule);
  border-radius: var(--r-card);
  background: var(--surface);
  box-shadow: var(--shadow);
}

.target.on {
  border-color: var(--mint);
}

.target-line {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.written {
  font-size: 30rpx;
}

.arrow {
  color: var(--muted);
}

.spoken {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--mint);
}

.demo {
  font-size: 32rpx;
  line-height: 1.5;
  color: var(--fg);
}

.dialogue {
  display: flex;
  flex-direction: column;
}

.line {
  position: relative;
  padding: 22rpx 20rpx 22rpx 76rpx;
  border-bottom: 1rpx solid var(--rule);
  border-radius: var(--r-ctl);
}

.line.on {
  background: var(--mint-tint);
}

.en {
  font-size: 32rpx;
  line-height: 1.55;
}

.zh {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.rt {
  font-size: 0.62em;
  color: var(--mint);
  vertical-align: super;
  margin-left: 1rpx;
}

.mini-play {
  position: absolute;
  top: 26rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border: var(--bd) solid var(--rule);
  border-radius: 50%;
  background: var(--rail);
}

.target .mini-play {
  top: 30rpx;
  left: 28rpx;
}

.line.on .mini-play,
.target.on .mini-play {
  background: var(--mint-tint);
}

.tri {
  width: 0;
  height: 0;
  margin-left: 4rpx;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 13rpx solid var(--mint);
}
