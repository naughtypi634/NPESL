<view class="app theme-{{theme}}">
<view class="bar" style="padding-top:{{nav.top}}px">
  <view class="bar-back" style="height:{{nav.height}}px" hover-class="bar-back-hover" bindtap="goBack">
    <view class="bar-chevron"></view>
    <text>返回</text>
  </view>
</view>

<view class="wrap" style="padding-top:{{topPad}}px" wx:if="{{chapter}}">
  <view class="head">
    <text class="kind" wx:if="{{chapter.kind}}">{{chapter.kind}}</text>
    <text class="title-en">{{chapter.en}}</text>
    <text class="title-zh">{{chapter.zh}}</text>
  </view>

  <view class="targets" wx:if="{{chapter.targets.length}}">
    <view
      class="target {{playing === 'target' + ti ? 'on' : ''}}"
      wx:for="{{chapter.targets}}"
      wx:for-item="target"
      wx:for-index="ti"
      wx:key="i"
      data-kind="target"
      data-i="{{ti}}"
      bindtap="play"
    >
      <view class="mini-play">
        <view class="tri"></view>
      </view>
      <view class="target-line">
        <text class="written">{{target.written}}</text>
        <text class="arrow">→</text>
        <text class="spoken">{{target.spoken}}</text>
      </view>
      <view class="demo">
        <text wx:for="{{target.demo}}" wx:for-item="part">
          <text>{{part[0]}}</text>
          <text class="rt" wx:if="{{part[1]}}">{{part[1]}}</text>
        </text>
      </view>
    </view>
  </view>

  <view class="dialogue">
    <view
      class="line {{playing === 'line' + li ? 'on' : ''}}"
      wx:for="{{chapter.lines}}"
      wx:for-item="line"
      wx:for-index="li"
      wx:key="i"
      data-kind="line"
      data-i="{{li}}"
      bindtap="play"
    >
      <view class="mini-play">
        <view class="tri"></view>
      </view>
      <view class="en">
        <text wx:for="{{line.t}}" wx:for-item="part">
          <text>{{part[0]}}</text>
          <text class="rt" wx:if="{{part[1]}}">{{part[1]}}</text>
        </text>
      </view>
      <text class="zh">{{line.zh}}</text>
    </view>
  </view>
</view>
<float-tools
  voice="{{voice}}"
  playing="{{playing ? true : false}}"
  paused="{{paused}}"
  active="{{hasPlay}}"
  all="{{all}}"
  allOn="{{allOn}}"
  bind:voice="onVoice"
  bind:pause="onPause"
  bind:replay="onReplay"
  bind:toggleall="onToggleAll"
  bind:theme="onTheme"
/>
</view>
