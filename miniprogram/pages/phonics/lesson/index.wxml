<view class="app theme-{{theme}}">
<view class="bar" style="padding-top:{{nav.top}}px">
  <view class="bar-back" style="height:{{nav.height}}px" hover-class="bar-back-hover" bindtap="goBack">
    <view class="bar-chevron"></view>
    <text>返回</text>
  </view>
</view>

<view class="wrap" style="padding-top:{{topPad}}px" wx:if="{{lesson}}">
  <view class="head">
    <view class="head-line">
      <text class="ipa">{{lesson.ipa}}</text>
      <text class="patterns">{{lesson.patterns}}</text>
    </view>
    <text class="title-en">{{lesson.en}}</text>
    <text class="title-zh">{{lesson.zh}}</text>
  </view>

  <view class="sentence {{playing === 's' + si ? 'on' : ''}}" wx:for="{{lesson.sentences}}" wx:for-item="sentence" wx:for-index="si" wx:key="i">
    <view
      class="sentence-play {{playing === 's' + si ? 'on' : ''}}"
      data-si="{{si}}"
      bindtap="playSentence"
    >
      <view class="tri"></view>
    </view>

    <view class="rows">
      <view class="row" wx:for="{{sentence.rows}}" wx:for-item="row" wx:for-index="ri" wx:key="i">
        <view class="en">
          <text wx:for="{{row.t}}" wx:for-item="part" class="{{part[1] ? 'hl' : ''}}">{{part[0]}}</text>
        </view>
        <text class="zh">{{row.zh}}</text>
      </view>
    </view>
  </view>
</view>

<float-tools
  voice="{{voice}}"
  playing="{{playing ? true : false}}"
  paused="{{paused}}"
  active="{{hasPlay}}"
  all="{{all}}"
  allOn="{{allOn}}"
  bind:voice="onVoice"
  bind:pause="onPause"
  bind:replay="onReplay"
  bind:toggleall="onToggleAll"
  bind:theme="onTheme"
/>
</view>
