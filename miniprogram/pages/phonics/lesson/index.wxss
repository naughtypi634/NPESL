.head {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin: 16rpx 0 40rpx;
}

.head-line {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.ipa {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--mint);
}

.patterns {
  font-size: 24rpx;
  color: var(--muted);
}

.title-en {
  font-size: 40rpx;
  font-weight: 600;
}

.title-zh {
  font-size: 26rpx;
  color: var(--muted);
}

.sentence {
  position: relative;
  padding: 20rpx 16rpx 20rpx 76rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid var(--rule);
  border-radius: var(--r-ctl);
}

.sentence.on {
  background: var(--mint-tint);
}

.sentence-play {
  position: absolute;
  top: 26rpx;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border: var(--bd) solid var(--rule);
  border-radius: 50%;
  background: var(--rail);
}

.sentence-play.on {
  background: var(--mint-tint);
}

.tri {
  width: 0;
  height: 0;
  margin-left: 4rpx;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 16rpx solid var(--mint);
}

.rows {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.row {
  padding: 10rpx 12rpx;
  border-radius: var(--r-ctl);
}

.en {
  font-size: 34rpx;
  line-height: 1.45;
}

.zh {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.hl {
  color: var(--mint);
}
