<view class="app theme-{{theme}}">
<view class="bar" style="padding-top:{{nav.top}}px">
  <view class="bar-back" style="height:{{nav.height}}px" hover-class="bar-back-hover" bindtap="goBack">
    <view class="bar-chevron"></view>
    <text>返回</text>
  </view>
</view>

<view class="wrap" style="padding-top:{{topPad}}px">
  <view class="group" wx:for="{{sections}}" wx:for-item="section" wx:key="title">
    <text class="group-title">{{section.title}}</text>

    <view class="list">
      <view
        class="row"
        hover-class="row-hover"
        wx:for="{{section.lessons}}"
        wx:for-item="lesson"
        wx:key="num"
        data-num="{{lesson.num}}"
        bindtap="open"
      >
        <text class="num">{{lesson.num < 10 ? '0' + lesson.num : lesson.num}}</text>
        <view class="row-main">
          <text class="en">{{lesson.en}}</text>
          <text class="zh">{{lesson.zh}}</text>
          <text class="patterns">{{lesson.patterns}}</text>
        </view>
        <text class="ipa">{{lesson.ipa}}</text>
      </view>
    </view>
  </view>
</view>
<float-tools bind:theme="onTheme" />
</view>
