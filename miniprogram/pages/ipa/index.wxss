.jump {
  position: sticky;
  height: 72rpx;
  z-index: 40;
  display: flex;
  margin-bottom: 28rpx;
  white-space: nowrap;
}

.jump-chip {
  flex: none;
  padding: 12rpx 26rpx;
  margin-right: 12rpx;
  border: var(--bd) solid var(--rule);
  border-radius: var(--r-pill);
  background: var(--surface);
  color: var(--muted);
  font-size: 24rpx;
}

.group {
  margin-bottom: 64rpx;
}

.group-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.group-title {
  font-size: 34rpx;
  font-weight: 600;
}

.group-note {
  font-size: 24rpx;
  color: var(--muted);
}

.card {
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 16rpx;
  border: var(--bd) solid var(--rule);
  border-radius: var(--r-card);
  background: var(--surface);
  box-shadow: var(--shadow);
}

.card-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.ipa {
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.tag {
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  background: var(--mint-tint);
  color: var(--mint);
  font-size: 22rpx;
}

.pair-block {
  margin-bottom: 44rpx;
}

.pair-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.pair-title {
  font-size: 27rpx;
  font-weight: 600;
}

.pair-note {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--muted);
}

.words {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: -14rpx;
}

.word {
  margin: 0 14rpx 14rpx 0;
  padding: 14rpx 24rpx;
  border: 2rpx solid var(--rule);
  border-radius: var(--r-ctl);
  background: var(--rail);
  font-size: 32rpx;
  line-height: 1.2;
  color: var(--fg);
}

.word.on {
  border-color: var(--mint);
  background: var(--mint-tint);
  color: var(--mint-hover);
  box-shadow: inset 0 0 0 2rpx var(--mint);
}

.hl {
  color: var(--mint);
}

.word.on .hl {
  color: inherit;
}

.hint {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--muted);
}
