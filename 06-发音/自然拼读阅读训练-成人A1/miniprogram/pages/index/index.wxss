page {
  background: #ffffff;
  color: #1d1d1f;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 72rpx 44rpx 80rpx;
}

.h1 {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.1;
}

.sub {
  display: block;
  margin-top: 14rpx;
  color: #6e6e73;
  font-size: 28rpx;
}

.cards {
  margin-top: 72rpx;
}

.card {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #e5e5ea;
  border-radius: 28rpx;
}

.card-hover {
  background: #f5f5f7;
}

.glyph {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #e8f2ff;
  color: #0071e3;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.glyph-alt {
  background: #f5f5f7;
  color: #1d1d1f;
}

.body {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
}

.desc {
  display: block;
  margin-top: 6rpx;
  color: #6e6e73;
  font-size: 25rpx;
}

.arrow {
  flex: none;
  margin-left: 16rpx;
  color: #c7c7cc;
  font-size: 44rpx;
  line-height: 1;
}
